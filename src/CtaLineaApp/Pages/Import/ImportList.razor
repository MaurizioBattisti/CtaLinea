@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using System.Threading;
@page "/import_list"
@inject IQueryUtilityService queryService
@inject DialogService DialogService
@attribute [Authorize]

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Elenco importazioni" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
        <RadzenTextBox @bind-Value="FullTextSearch" Placeholder="Cerca..." Change=@(args => FullText_OnChange(args)) Class="w-100" />
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData" 
                FilterMode="FilterMode.Simple"
                IsLoading=@isLoading
                PageSize=@(Settings?.PageSize ?? 5)
                Count="@RowCount"
                LoadData="@LoadData"
                Data="@this.Data" TItem="ImportQueryItem"
                AllowFiltering="true"
                AllowColumnResize="true"
                AllowPaging="true" 
                AllowSorting="true"
                LogicalFilterOperator="LogicalFilterOperator.And"
                PagerHorizontalAlign="HorizontalAlign.Left" 
                ShowPagingSummary="true"
                CellRender="@this.ImportLog_CellRender">
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessuna importazione trovata !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="ImportQueryItem" Context="ImportQueryItem" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="70px">
            <Template Context="import">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(async (args) => await ShowDetailAsync(import))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="ImportQueryItem" Property="Description" Title="Tipo" Width="150px" />
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportStatus" Title="Stato" Width="180px" >
            <Template Context="data">
                @if (data.ImportStatus == Constants.ImportStatus_Error)
                {
                    <span style='color:white'>@data.ImportStatus</span>
                }
                else
                {
                    <span style='color: black'>@data.ImportStatus</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="ProcessedElements" Title="Nr. processati" Width="180px" />
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportedElements" Title="Importati" Width="120px" />

        <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportStartDate" Title="inizio import" FormatString="{0:dd/MM/yyyy hh:mm:ss}" Width="180px" />
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="LastUpdateDate" Title="Fine import" FormatString="{0:dd/MM/yyyy hh:mm:ss}" Width="180px" />
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="Note" Title="Note" Width="300px" />
        <RadzenDataGridColumn TItem="ImportQueryItem" Property="User" Title="User" Width="180px" />
    </Columns>
</RadzenDataGrid>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    RadzenDataGrid<ImportQueryItem>? grdData;

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    ImportQueryItem[]? Data = null; 
    int RowCount = 0;
    bool isLoading = false;
    string FullTextSearch = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        this._servicesQueryDef.EndPoint = Constants.Endpoint_ImportLog;
        await Task.CompletedTask;
        this.StateHasChanged();
    }

    void FullText_OnChange(string value)
    {
        this.grdData?.Reload();
    }

    private async Task LoadData(LoadDataArgs args)
    {
        this.isLoading = true;
        this.StateHasChanged();

        this._servicesQueryDef.Filter = args.GetQueryFilter<ImportQueryItem> ();
        this._servicesQueryDef.Sort = args.GetQuerySort(nameof(ImportQueryItem.LastUpdateDate) + "-" );
        this._servicesQueryDef.FullText = this.FullTextSearch;

        this._servicesQueryDef.Page = args.GetQueryPage();
        this._servicesQueryDef.PageSize = args.GetQueryPageSize();

        try
        {
            var result = await queryService.GetListAsync<ImportQueryItem>(
                        this._servicesQueryDef);

            if (result != null)
            {
                this.Data = result.Items;
                this.RowCount = result.TotalRows;
            }
        }
        finally
        {
            this.isLoading = false;
            this.StateHasChanged();
        }
    }
    private void ImportLog_CellRender(DataGridCellRenderEventArgs<ImportQueryItem> args)
    {
        if (args.Column.Property == "ImportStatus")
        {
            args.Attributes.Add("style", $"background-color: { this.GetStyleBackColorByStatus(args.Data.ImportStatus)};");
        }
    }

    private string GetStyleBackColorByStatus(string status)
    {
        var color = "white";
        switch (status)
        {
            case Constants.ImportStatus_Error:
                color = "orangered";
                break;
            case Constants.ImportStatus_Completed:
                color = "lightgreen";
                break;
        }
        return color;
    }

    private async Task ShowDetailAsync(ImportQueryItem import)
    {
        /*
        @inject NavigationManager NavigationManager
        await Task.CompletedTask;
        NavigationManager.NavigateTo("/import_detail/" + import.Id.ToString(), true);
        */
        await DialogService.OpenAsync<ImportDetail>(
            $"Dettaglio importazioni",
            new Dictionary<string, object>() { { "id", import.Id } },
            new DialogOptions() { 
                AutoFocusFirstElement = true,
                ShowTitle = true,
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = true,
                Resizable = true,
                Width="90%",
                Height="90%"
            });
    }

}
