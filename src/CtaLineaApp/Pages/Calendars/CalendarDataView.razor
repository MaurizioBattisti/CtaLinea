@inject ICalendarService CalendarService
@inject NotificationService notificationService
@inject NavigationManager NavigationManager

@if (!EditMode)
{
    <RadzenButton Disabled=@Disabled Text="Modifica dati" Click=@EditData_Click />
}
<RadzenTemplateForm 
    TItem=Calendar 
    Data="@CurrentCalendar" 
    Submit=@SaveCalendar_Click >
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6">
                <RadzenFieldset Text="Informaizoni di base">
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Nome Calendario" />
                        </div>
                        <div class="col-md-8">
                            <RadzenTextBox 
                                Disabled=@(!this.EditMode)
                                @bind-Value=@CurrentCalendar.CalendarName
                                style="width: 100%;" MaxLength=200 Name="CalendarName" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Ordine" />
                        </div>
                        <div class="col-md-8">
                            <RadzenNumeric Disabled=@(!this.EditMode)
                                           @bind-Value=@CurrentCalendar.Ordinal
                                           style="width: 100%;" MaxLength=200 Name="Ordinal" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Calendario di base" />
                        </div>
                        <div class="col-md-8">
                            <CalendarDropDown 
                                Disabled=@(!this.EditMode)
                                AllowClear=true @bind-CalendarId=@CurrentCalendar.BaseCalendarId />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Tipo di calcolo" />
                        </div>
                        <div class="col-md-8">
                            <RadzenDropDown @bind-Value="CurrentCalendar.RunCalendarType" 
                                Disabled=@(!this.EditMode)
                                Placeholder="tIPO" 
                                Data="@CalendarTYpes" 
                                style="width: 100%;" 
                                TextProperty="Value"
                                ValueProperty="Key"
                                Name="RunCalendarType">
                            </RadzenDropDown>
                        </div>
                    </div>
                </RadzenFieldset>
            </div>
            <div class="col-md-3">
                <RadzenFieldset Text="Altre opzioni">
                    <div class="row">
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Mondays Name="Mondays" TValue="bool" />
                            <RadzenLabel Text="Lunedì" Component="Mondays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Tuesdays Name="Tuesdays" TValue="bool" />
                            <RadzenLabel Text="Martedì" Component="Tuesdays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Wednesdays Name="Wednesdays" TValue="bool" />
                            <RadzenLabel Text="Mercoledì" Component="Wednesdays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Thursdays Name="Thursdays" TValue="bool" />
                            <RadzenLabel Text="Giovedì" Component="Thursdays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Fridays Name="Fridays" TValue="bool" />
                            <RadzenLabel Text="Venerdì" Component="Fridays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Saturdays Name="Saturdays" TValue="bool" />
                            <RadzenLabel Text="Sabati" Component="Saturdays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                            @bind-Value=@this.CurrentCalendar.Sundays Name="Sundays" TValue="bool" />
                            <RadzenLabel Text="Domeniche" Component="Sundays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </div>
                </RadzenFieldset>
            </div>
            <div class="col-md-3">
                <RadzenFieldset Text="Altre opzioni">
                    <div class="row">
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                @bind-Value=@this.CurrentCalendar.PreHolyday Name="PreHolyday" TValue="bool" />
                            <RadzenLabel Text="Pre festivi" Component="PreHolyday" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                @bind-Value=@this.CurrentCalendar.PostHolyday Name="PostHolyday" TValue="bool" />
                            <RadzenLabel Text="Post festivi" Component="PostHolyday" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </div>
                </RadzenFieldset>
            </div>
        </div>
        @if (this.EditMode == true)
        {
            <div class="row justify-content-center">
                <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Salva" />
                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Annulla" Click="@Cancel_Click" />
            </div>
        </div>
        }
    </div>
</RadzenTemplateForm>

@code {
    [Parameter]
    public Calendar CurrentCalendar { get; set; } = new Calendar();
    [Parameter]
    public bool EditMode { get; set; } = false;
    [Parameter]
    public EventCallback<bool> EditModeChanged { get; set; }
    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    private bool IsBusy = false;

    private CheckResult CheckResult = new CheckResult() { Status = CheckStatus.Success };
    private Calendar OldCalendar = new Calendar();

    List<KeyValuePair<RunCalendarType, string>> CalendarTYpes = new List<KeyValuePair<RunCalendarType, string>>()
    {
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.NoOperation, "Nessuna operazione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.Exclusion, "Esclusione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.Inclusion, "Inclusione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.InvertPreviousLevel, "Inversione del calendario di base")
    };

    private async Task SaveCalendar_Click (Calendar calendar)
    {
        await Task.CompletedTask;

        // controla i dati ...



        // ... se è tutto OK li salva
        // se il clanedar id è minore o uguae a  zero tenta un insert 
        try
        {
            this.IsBusy = true;
            if (this.CurrentCalendar.CalendarId <= 0)
            {
                var id = await this.CalendarService.InsertAsync(this.CurrentCalendar);
                
                // naviga alla pagina di edit dle calendario
                NavigationManager.NavigateTo(
                    string.Format("/calendar-edit/{0}", id)
                    );
            }
            else
            {
                //... altrimenti tenta un update
                await this.CalendarService.UpdateAsync(this.CurrentCalendar);
                this.SetEditMode(false);
            }
            await this.Changed.InvokeAsync();
        }
        catch (BadRequestException<CheckResult> ex)
        {
            this.CheckResult = ex.Payload;

            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Dati non corretti",
                "verificare i dati prima di procedere con il salvataggio"
            );
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Creazione corsa Fallita !",
                ex.Message
            );
        }
        finally
        {
            this.IsBusy = false;
        }
    }

    private void Cancel_Click ()
    {
        // ripristina i dati precedenti
        this.CurrentCalendar.CopyFrom(this.OldCalendar);
        this.SetEditMode(false);
        this.Changed.InvokeAsync();
    }

    private void EditData_Click()
    {
        this.OldCalendar.CopyFrom(this.CurrentCalendar);

        this.SetEditMode(true);
        this.Changed.InvokeAsync();
    }

    private void SetEditMode (bool editMode)
    {
        if (this.EditMode != editMode)
        {
            this.EditMode = editMode;
            this.EditModeChanged.InvokeAsync(this.EditMode);
        }
    }

}
