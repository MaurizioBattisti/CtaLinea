
<RadzenTemplateForm 
    TItem=Calendar 
    Data="@CurrentCalendar" 
    Submit=@SaveCalendar_Click >
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-8">
                <RadzenFieldset Text="Informaizoni di base">
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Nome Calendario" />
                        </div>
                        <div class="col-md-8">
                            <RadzenTextBox 
                                Disabled=@(!this.EditMode)
                                @bind-Value=@CurrentCalendar.CalendarName
                                style="width: 100%;" MaxLength=200 Name="CalendarName" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Calendario di base" />
                        </div>
                        <div class="col-md-8">
                            <CalendarDropDown 
                                Disabled=@(!this.EditMode)
                                AllowClear=true @bind-CalendarId=@CurrentCalendar.BaseCalendarId />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 align-items-center d-flex">
                            <RadzenLabel Text="Tipo di calcolo" />
                        </div>
                        <div class="col-md-8">
                            <RadzenDropDown @bind-Value="CurrentCalendar.RunCalendarType" 
                                Disabled=@(!this.EditMode)
                                Placeholder="tIPO" 
                                Data="@CalendarTYpes" 
                                style="width: 100%;" 
                                TextProperty="Value"
                                ValueProperty="Key"
                                Name="RunCalendarType">
                            </RadzenDropDown>
                                             
                        </div>
                    </div>
                </RadzenFieldset>
            </div>
            <div class="col-md-4">
                <RadzenFieldset Text="Altre opzioni">
                    <div class="row">
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                @bind-Value=@this.CurrentCalendar.Sundays Name="Sundays" TValue="bool" />
                            <RadzenLabel Text="Domeniche" Component="Sundays" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                @bind-Value=@this.CurrentCalendar.PreHolyday Name="PreHolyday" TValue="bool" />
                            <RadzenLabel Text="Pre festivi" Component="PreHolyday" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="col-md-12">
                            <RadzenCheckBox Disabled=@(!this.EditMode)
                                @bind-Value=@this.CurrentCalendar.PostHolyday Name="PostHolyday" TValue="bool" />
                            <RadzenLabel Text="Post festivi" Component="PostHolyday" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </div>
                </RadzenFieldset>
            </div>
        </div>
        @if (this.EditMode == true)
        {
            <div class="row justify-content-center">
                <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Salva" />
                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Annulla" Click="@Cancel_Click" />
            </div>
        </div>
        }
    </div>
</RadzenTemplateForm>

<RadzenButton Text="Schiza !" Click=@Clicca_Click />


@code {
    [Parameter]
    public Calendar CurrentCalendar { get; set; } = new Calendar();
    [Parameter]
    public bool EditMode { get; set; } = false;
    [Parameter]
    public EventCallback<bool> EditModeChanged { get; set; }

    List<KeyValuePair<RunCalendarType, string>> CalendarTYpes = new List<KeyValuePair<RunCalendarType, string>>()
    {
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.NoOperation, "Nessuna operazione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.Exclusion, "Esclusione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.Inclusion, "Inclusione"),
        new KeyValuePair<RunCalendarType, string>(RunCalendarType.InvertPreviousLevel, "Inversione del calendario di base")
    };

    private async Task SaveCalendar_Click (Calendar calendar)
    {



        await Task.CompletedTask;
    }

    private void Cancel_Click ()
    {

    }

    private void Clicca_Click ()
    {
        this.SetEditMode(!this.EditMode);
    }

    private void SetEditMode (bool editMode)
    {
        if (this.EditMode != editMode)
        {
            this.EditMode = editMode;
            this.EditModeChanged.InvokeAsync(this.EditMode);
        }
    }

}
