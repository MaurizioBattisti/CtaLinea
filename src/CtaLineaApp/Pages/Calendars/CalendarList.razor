                );
            }
            */
        }
    }

    private void RowActionCellContextMenu(DataGridCellMouseEventArgs<CalendarQueryItem> args)
    {
        SelectedCalendars = new List<CalendarQueryItem>() { args.Data };

        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Click=@((e)=>OnMenuItemClick(args, e))>
                <RadzenMenuItem Text="Modifica..." Value=@CalendarMenuItems.Edit />
                <hr class="separator">
                <RadzenMenuItem Text="Elimina..." Value=@CalendarMenuItems.Delete />
        </RadzenMenu>
    );
    }

    private async Task OnMenuItemClick(
        DataGridCellMouseEventArgs<CalendarQueryItem> args,
        MenuItemEventArgs e
        )
    {
        await Task.CompletedTask;
        ContextMenuService.Close();

        switch ((CalendarMenuItems)e.Value)
        {
            case CalendarMenuItems.Edit:
                /*
                NavigationManager.NavigateTo(
                    string.Format("/run-edit/{0}", args.Data.Id)
                    );
                */
                break;
            case CalendarMenuItems.Delete:
                await this.DeleteCalendarASync(args.Data.Id);
                break;

            default:
                break;
        };
    }
}