@page "/calendar-edit/{Id:int}"
@inject ICalendarService CalendarService
@inherits EditorComponentBase
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Modifica Calendario </PageTitle>
<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Modifica Calendario" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>

<CalendarDataView Disabled=@DetailEditMode CurrentCalendar=@Calendar @bind-EditMode=@EditMode Changed=@SetIsClean />
<CalendarDetailsView @bind-DetailEditMode=@DetailEditMode CalendarId=@Id EditMode=@(!EditMode) Changed=@SetIsClean />
<RadzenRow>
    <CalendarDaysView  @ref=@Preview CalendarId=@Id />
</RadzenRow>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool IsBusy = true;
    private bool EditMode = false;
    Calendar Calendar = new Calendar();
    private bool DetailEditMode = false;

    private CalendarDaysView? Preview;
    private void SetIsClean ()
    {
        this.IsClean = (this.EditMode == false
                        && this.DetailEditMode == false);

        if (this.EditMode == false
            && this.DetailEditMode == false)
        {
            Preview?.Reload();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                this.IsBusy = true;

                var cal = await CalendarService.GetOneAsync(this.Id);
                if (cal != null)
                {
                    this.Calendar = cal;
                }
                else
                {
                    // TODO: segnala un problema
                }
            }
            finally
            {
                this.IsBusy = false;
                this.StateHasChanged();
            }
        }
    }
}
