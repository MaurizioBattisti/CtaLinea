@using CtaLineaApp.Application.Services.Account;
@using CtaLineaApp.Application.Model.Account;
@page "/"
@inject IAccountService AccountService
@inject NavigationManager NavigationManager

<PageTitle>@Constants.App_Title - Home</PageTitle>

@if(this.AccountService.User == null)
{
	<Animate Animation="Animations.SlideDown"
		 IsManual=false
		 Easing="Easings.Ease"
		 Duration="TimeSpan.FromSeconds(0.5)"
		>
		<WelcomeScreen />
	</Animate>
	
} else {
	<Animate Animation="Animations.SlideDown"
		 IsManual=false
		 Duration="TimeSpan.FromSeconds(0.5)"
		>
		<DashBoard />
	</Animate>
}
