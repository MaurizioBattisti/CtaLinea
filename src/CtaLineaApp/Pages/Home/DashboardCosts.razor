@using CtaLineaApp.Components.Base

@inject IApplicationSettings AppSettings
@inject IAccountService AccountService
@inject IDahboardService _dashboardService

<CtaLineaGlobalFiltersManager 
	Changed="@GlobalFilterChanged" />

@if (this.IsLoading == true)
{
	<RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
@if (this.IsLoading == false)
{
	<RadzenStack Orientation="Orientation.Vertical" Gap="4">
		<RadzenStack Orientation="Orientation.Horizontal" Gap="4">
			<RadzenCheckBox Name="ConsiderSuspended" @bind-Value=@this.Request.ConsiderSuspended TValue="bool" Change=@(a=> this.RefreshData()) />
			<RadzenLabel Component="ConsiderSuspended" Text="Considera sovrapposizioni" />
			<RadzenCheckBox Name="RealElastibusKm" @bind-Value=@this.Request.RealElastibusKm TValue="bool" Change=@(a=> this.RefreshData()) />
			<RadzenLabel Component="RealElastibusKm" Text="Km reali elastibus" />
			<RadzenLabel Component="SimulationName" Text="Simulazione" />
			<SimulationSelector Name="SimulationName"
								@bind-SimulationName=@Request.SimulationName
								Changed=@(()=> this.RefreshData()) />
		</RadzenStack>

		<RadzenChart style="height: 400px">
			<RadzenColumnSeries Title="Costi GG"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.DayCost)">
			</RadzenColumnSeries>
			<RadzenColumnSeries Title="Costi Reali"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.RealCost)">
			</RadzenColumnSeries>
			<RadzenColumnSeries Title="Costi Appalto"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.ContractCost)">
			</RadzenColumnSeries>
			<RadzenColumnSeries Title="Costi Extra"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.ExtraCost)">
			</RadzenColumnSeries>
			<RadzenColumnSeries Title="Costi Lavorati"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.WorkedContractCost)">
			</RadzenColumnSeries>
			<RadzenColumnSeries Title="Costi Negativi"
								Data="@Data"
								CategoryProperty="@nameof(CostDataItem.MonthId)"
								ValueProperty="@nameof(CostDataItem.NegativeContractCost)">
			</RadzenColumnSeries>

			<RadzenValueAxis Formatter="@FormatKm">
				<RadzenGridLines Visible="true" />
				<RadzenAxisTitle Text="Costi" />
			</RadzenValueAxis>
			<RadzenCategoryAxis Formatter="@FormatMonth">
				<RadzenGridLines Visible="true" />
				<RadzenAxisTitle Text="Mese" />
			</RadzenCategoryAxis>
		</RadzenChart>
	
		<RadzenRow>
			<RadzenColumn Size="4">
				<RadzenChart style="height: 400px">
					<RadzenBarSeries Title="Costi GG"
						Data="@TotData"
									 CategoryProperty="@nameof(CostDataItem.MonthId)"
						ValueProperty="@nameof(CostDataItem.DayCost)">
					</RadzenBarSeries>
					<RadzenBarSeries Title="Costi Reali"
									 Data="@TotData"
									 CategoryProperty="@nameof(CostDataItem.MonthId)"
									 ValueProperty="@nameof(CostDataItem.RealCost)">
					</RadzenBarSeries>
					<RadzenBarSeries Title="Costi Appalto"
										Data="@TotData"
										CategoryProperty="@nameof(CostDataItem.MonthId)"
									 ValueProperty="@nameof(CostDataItem.ContractCost)">
					</RadzenBarSeries>
					<RadzenBarSeries Title="Costi Extra"
										Data="@TotData"
										CategoryProperty="@nameof(CostDataItem.MonthId)"
									 ValueProperty="@nameof(CostDataItem.ExtraCost)">
					</RadzenBarSeries>
					<RadzenBarSeries Title="Costi Lavorati"
									 Data="@TotData"
									 CategoryProperty="@nameof(CostDataItem.MonthId)"
									 ValueProperty="@nameof(CostDataItem.WorkedContractCost)">
					</RadzenBarSeries>
					<RadzenBarSeries Title="Costi Negativi"
										Data="@TotData"
										CategoryProperty="@nameof(CostDataItem.MonthId)"
									 ValueProperty="@nameof(CostDataItem.NegativeContractCost)">
					</RadzenBarSeries>

					<RadzenValueAxis Formatter="@FormatKm">
						<RadzenGridLines Visible="true" />
						<RadzenAxisTitle Text="Costi Totali" />
					</RadzenValueAxis>
					<RadzenCategoryAxis >
						<RadzenGridLines Visible="true" />
						<RadzenAxisTitle Text="Anno" />
					</RadzenCategoryAxis>
				</RadzenChart>
			</RadzenColumn>
			<RadzenColumn Size="8">
				<RadzenDataGrid 
					Data="@Data"
								TItem="CostDataItem"
					Culture=@AppSettings.CurrentCulture
					AllowSorting="true"
					AllowColumnResize="true"
					Density=@Settings.Density
					class="w-100">
					<Columns>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.MonthId)" Title="Mese" Width="120px">
							<Template Context="data">
								<RadzenText Text="@FormatMonth(data.MonthId)" />
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.DayCost)" Title="Costi gg." FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.DayCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.RealCost)" Title="Costi Reali" FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.RealCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.ContractCost)" Title="Costi Appalto" FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.ContractCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.ExtraCost)" Title="Costi Extra" FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.ExtraCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.WorkedContractCost)" Title="Costi Lavorati" FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.WorkedContractCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="CostDataItem" Property="@nameof(CostDataItem.NegativeContractCost)" Title="Costi Negativi" FormatString="{0:f2}" Width="100px">
							<FooterTemplate>
								<RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}", this.Totals.NegativeContractCost)" />
							</FooterTemplate>
						</RadzenDataGridColumn>
					</Columns>
				</RadzenDataGrid>
			</RadzenColumn>
		</RadzenRow>
	</RadzenStack>
}

@code {
	[CascadingParameter]
	CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();
	[CascadingParameter]
	CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

	[Parameter]
	public bool RealElastibus 
	{
		get { return this.Request.RealElastibusKm; }
		set 
		{
			this.Request.RealElastibusKm = value; 
			this.LoadAllData();
		}
	}

	private CostDataItemRequest Request = new CostDataItemRequest();

	private bool IsLoading { get; set; } = false;
	private IEnumerable<CostDataItem> Data = new List<CostDataItem>();
	private IEnumerable<CostDataItem> TotData = new List<CostDataItem>();

	private bool CanLoad = false;

	private async Task GlobalFilterChanged()
	{
		this.RefreshData();
		await Task.CompletedTask;
	}

	protected override async Task OnParametersSetAsync()
	{
		this.RefreshData();
		await base.OnParametersSetAsync();
	}

	private void RefreshData()
	{
		this.Request.ContractId = this.GlobalFilters.Contract?.Id;
		this.Request.StartDate = this.GlobalFilters.Period?.StartDate;
		this.Request.EndDate = this.GlobalFilters.Period?.EndDate;

		// carica i dati senza attenderli
		this.LoadAllData();
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender == true)
		{
			this.CanLoad = true;
			this.RefreshData();
		}
		base.OnAfterRender(firstRender);
	}

	private CostDataItem Totals
	{
		get
		{
			return this.TotData.FirstOrDefault() ?? new CostDataItem();
		}
	}

	private void LoadAllData()
	{
		if (this.AccountService.IsUserInRole(UserRoles.Role_View) == false
			|| this.CanLoad == false)
		{
			return;
		}

		IsLoading = true;

		var t = this._dashboardService.GetCostsAsync(
			this.Request)
			.ContinueWith(
				(task) =>
				{
					this.Data = task.Result ?? new List<CostDataItem>();
					var totals = this.SumAll(this.Data);
					this.TotData = new List<CostDataItem>()
					{
						totals
					};

					IsLoading = false;
					this.StateHasChanged();
					return;
				}
			);
		this.StateHasChanged();
	}

	private CostDataItem SumAll(IEnumerable<CostDataItem> data)
	{
		string yearText = "Tutto il periodo";
		if (this.Request.StartDate != null
			&& this.Request.EndDate != null)
		{
			var year = this.Request.StartDate?.Year;
			yearText = string.Format("{0}", year);
			if (year != this.Request.EndDate?.Year)
			{
				yearText = string.Format("{0} / {1}", year, this.Request.EndDate?.Year);
			}
		}

		var total = new CostDataItem()
		{
			MonthId = yearText
		};

		foreach (var item in data)
		{
			total.DayCost += item.DayCost;
			total.RealCost += item.RealCost;
			total.ContractCost += item.ContractCost;
			total.ExtraCost += item.ExtraCost;
			total.WorkedContractCost += item.WorkedContractCost;
			total.NegativeContractCost += item.NegativeContractCost;
		}

		return total;
	}

	private string FormatKm(object? value)
	{
		if (value == null) return string.Empty;
		return string.Format("{0:F2}", value);
	}
	private string FormatMonth (object? value)
	{
		if (value == null) return string.Empty;
		string sMonth = (string)value;
		if (string.IsNullOrWhiteSpace(sMonth) == true) return string.Empty;
		string sDate = sMonth.Substring(0, 4) + "/" + sMonth.Substring(4) + "/01";
		var dt = DateTime.Parse (sDate);
		return string.Format( this.AppSettings.CurrentCulture, "{0:yyyy MMM}", dt);
	}
}
