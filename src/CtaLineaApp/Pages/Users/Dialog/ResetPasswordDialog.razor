@inject NotificationService _notificationService
@inject DialogService DialogService
@inject IUserService _userService

<RadzenStack Orientation="Orientation.Vertical">
	<RadzenTemplateForm Data=@this
						Submit="@((ResetPasswordDialog args) => { ; })">
		<RadzenFieldset Text="Dati generali" >
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="6">
					<RadzenLabel Component="New_UserName">Nome utente</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="6">
					<RadzenTextBox Name="New_UserName"
								   @bind-Value="UserName"
								   ReadOnly=true
								   MaxLength="128"
								   class="w-100" />
				</RadzenColumn>
			</RadzenRow>
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="6">
					<RadzenLabel Component="New_Password">Password</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="6">
					<RadzenPassword Name="New_Password"
								@bind-Value=@Password
								MaxLength="128"
								class="w-100" />
				</RadzenColumn>
			</RadzenRow>
			
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="6">
					<RadzenLabel Component="@nameof(MustChangePassword)">Deve Cambiare password</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="6">
					<RadzenCheckBox @bind-Value="MustChangePassword"
									TValue="bool"
									Name="@nameof(MustChangePassword)"
									/>
				</RadzenColumn>
			</RadzenRow>
		</RadzenFieldset>
	</RadzenTemplateForm>

	<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
		<RadzenButton Click="@(() => this.ResetPasswordASync(ds))"
					  ButtonStyle="ButtonStyle.Primary"
					  Text="Reset Password" />
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter]
	public DialogService? ds { get; set; }

	[Parameter]
	public string UserName { get; set; } = string.Empty;

	private string Password { get; set; } = string.Empty;
	private bool MustChangePassword { get; set; } = true;

	protected override Task OnInitializedAsync()
	{

		return base.OnInitializedAsync();
	}

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
	}

	private async Task ResetPasswordASync(DialogService ds)
	{
		// controlla che sia stata inserita la password
		if (string.IsNullOrEmpty( this.Password) == true)
		{
			// mostra un messaggio di errore
			await DialogService.Alert(
				"Deve essere idnicata la nuova apssword per l'utente"
				);
			return;
		}
		try
		{
			var model = new ResetUserPasswordModel()
			{
				Password = this.Password,
				SetMustChange = this.MustChangePassword
			};
			// esegue il salvataggio
			await this._userService.ResetPasswordASync(this.UserName, model);

			// se tutto OK chiude la finestra
			ds.Close(true);

			// notiivca che
			this._notificationService.Notify(
				NotificationSeverity.Success,
				"Password resettata con scucesso");
		}
		catch (BadRequestException<CheckResult> ex)
		{
			this._notificationService.Notify(
				NotificationSeverity.Error,
				ex.Payload?.Title ?? "problemi",
				ex.Payload?.Description ?? string.Empty
		);
		}
		catch (Exception ex)
		{
			this._notificationService.Notify(
				NotificationSeverity.Error,
				"errore durante ils reset della password",
				ex.Message);
		}
	}
}
