@inject IExcelExporterService ExcelService
@inject NotificationService _notificationService
@inject IApplicationSettings AppSettings;

<RadzenDataGrid FilterMode="FilterMode.Simple"
                IsLoading=@IsLoading
                Culture=@AppSettings.CurrentCulture
                Data="@this.Data" TItem="CostByAssociateByRunItem"
                AllowFiltering="true"
                AllowSorting="true"
                AllowColumnResize="true"
                AllowVirtualization=true
                LogicalFilterOperator="LogicalFilterOperator.And"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density=@Settings.Density
                Style=@GrdiStyle>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenSplitButton ButtonStyle="ButtonStyle.Dark"
                               Icon="file_download" Click=@DownloadDataByRun_Click>
                <ChildContent>
                    <RadzenSplitButtonItem Text="Excel" Value="X" Icon="grid_on" />
                    <RadzenSplitButtonItem Text="CSV" Value="C" Icon="wrap_text" />
                </ChildContent>
            </RadzenSplitButton>
        </RadzenStack>
    </HeaderTemplate>
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun dato da visaulizzare !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.CtaRunId)" Title="Id CTA" Width="80px" Frozen=true />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.ContractName)" Title="Appalto" Width="200px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.AssociateName)" Title="Ditta" Width="200px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.CarDescr)" Title="Mezzi" Width="200px" />

        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.LineNumber)" Title="Linea" Width="70px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.RunNumber)" Title="Nr Corsa" Width="120px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.RunName)" Title="Corsa" Width="150px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.PathsDescr)" Title="Percorso" Width="200px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.StartTime)" Title="Ora inizio" Width="120px">
            <Template Context="data">
                @FormatTime(data?.StartTime)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.EndTime)" Title="Ora Fine" Width="120px">
            <Template Context="data">
                @FormatTime(data?.EndTime)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.KmTot)" Title="Km Totali" FormatString="{0:f2}" Width="100px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:f2}",Total.KmTot)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.Total)" Title="Costo Totale" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.Total)" />
            </FooterTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.DayCount)" Title="Nr Giorni" FormatString="{0}" Width="150px" />
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.Km)" Title="Tod. Km" FormatString="{0:f2}" Width="100px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:f2}",Total.Km)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.KmExtra)" Title="Tod. Km Extra" FormatString="{0:f2}" Width="100px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:f2}",Total.KmExtra)" />
            </FooterTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.DayCost)" Title="Tod. Costo" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.DayCost)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.CostKm)" Title="Tod. Costo Km" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.CostKm)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.CostKmExtra)" Title="Tit. Costo Km Extra" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.CostKmExtra)" />
            </FooterTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.DayIntegration)" Title="Tot. int." FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.DayIntegration)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.DayForfait)" Title="Tot. Forfait" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.DayForfait)" />
            </FooterTemplate>
        </RadzenDataGridColumn>        
        <RadzenDataGridColumn TItem="CostByAssociateByRunItem" Property="@nameof(CostByAssociateByRunItem.DayMultiRunForfait)" Title="Tot. Forfait Multiplo" FormatString="{0:C}" Width="150px">
            <FooterTemplate>
                <RadzenText Text="@string.Format(this.AppSettings.CurrentCulture,"{0:C}",Total.DayMultiRunForfait)" />
            </FooterTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private string GrdiStyle = "height:900px; width:100%";

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

    [Parameter]
    public bool IsLoading { get ;set; } = false;
    [Parameter]
    public IEnumerable<CostByAssociateByRunItem>? Data { get; set; } = null;
    [Parameter]
    public CostByAssociateByRunItem Total { get; set; } = new CostByAssociateByRunItem();

    private void Month_CellRender(DataGridCellRenderEventArgs<CostByAssociateItem> args)
    {
        if (args.Column.Property == nameof(CostByAssociateItem.KmTot)
            || args.Column.Property == nameof(CostByAssociateItem.Total))
        {
            args.Attributes.Add("style", $"background-color: var(--rz-success-darker)");
        }
    }

    private async Task ExportDataAsync<TEntity>(
        RadzenSplitButtonItem item,
        IEnumerable<TEntity>? data,
        string title
        )
        where TEntity : class
    {
        try
        {
            this.IsLoading = true;

            if (data != null)
            {
                var columninfo = data.GetExportColumnInfo();

                if (item == null)
                {
                    await this.ExcelService.Export(title, data, columninfo);
                }
                else
                {
                    switch (item.Value)
                    {
                        case "X":
                            await this.ExcelService.ExportExcel(title, data, columninfo);
                            break;
                        case "C":
                            await this.ExcelService.ExportCsv(title, data, columninfo);
                            break;
                    }
                }
                this._notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
            }
            else
            {
                this._notificationService.Notify(
                    NotificationSeverity.Warning,
                    "Nessun dato da esportare"
                    );
            }
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "ERrore recuperando i dati",
                ex.Message
                );
        }
        finally
        {
            this.IsLoading = false;
        }
    }

    private async Task DownloadDataByRun_Click(RadzenSplitButtonItem item)
    {
        await this.ExportDataAsync(item, this.Data, "Costi per Corsa");
    }

    private string FormatTime(
        TimeSpan? time)
    {
        if (time == null) return string.Empty;
        var to = new TimeOnly(time.Value.Hours, time.Value.Minutes, time.Value.Minutes);
        return string.Format(this.AppSettings.CurrentCulture, "{0:HH:mm}", to);
    }
}
