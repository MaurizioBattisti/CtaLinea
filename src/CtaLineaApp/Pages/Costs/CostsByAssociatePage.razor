@page "/costbyassociate"

@inject IExcelExporterService ExcelService
@inject NotificationService _notificationService
@inject ICostService _CostService;
@inject IApplicationSettings AppSettings;
@attribute [Authorize]

<CheckAuthorization Roles=@(new string[] { UserRoles.Role_Costs }) />
<PageTitle>@Constants.App_Title - Costi per Ditta</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Costi per ditta" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenRow >
    <RadzenStack Orientation="Orientation.Horizontal"
                    Gap="5px" Wrap="FlexWrap.NoWrap"
                    JustifyContent="JustifyContent.End"
                    AlignItems="AlignItems.Start">
        <RadzenStack Orientation="Orientation.Vertical"
                        AlignItems="AlignItems.Stretch">
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Riferimento appalto</RadzenText>
                    <ContractDropDown @bind-ContractId="Request.ContractId" AllowClear=false Changed=@(() => this.StateHasChanged()) />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <AssociateAndCarDropDown @bind-AssociateId="Request.ASsociateId" @bind-CarId="Request.CarId" Inline=true AllowClear=true />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" >
                    <DateRangeSelector @bind-StartDate="Request.StartDate" @bind-EndDate="Request.EndDate" Inline=true AllowClear=true />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="2" Wrap="FlexWrap.Wrap">
                        <div class="rrz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeOutOfPeriod Name="IncludeOutOfPeriod" />
                            <RadzenLabel Text="Includi Km negativi" Component="IncludeOutOfPeriod" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeSuspended Name="IncludeSuspended" />
                            <RadzenLabel Text="Considera come attivi i giorni sospesi" Component="IncludeSuspended" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.UseReplacedCars Name="UseReplacedCars" />
                            <RadzenLabel Text="Attribuisce i costi ai mezzi che realmente hanno effettuato il servizio" Component="UseReplacedCars" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.ForceFreshData Name="ForceFreshData" />
                            <RadzenLabel Text="Forza calcolo con dati nuovi" Component="ForceFreshData" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Vertical" >
	                    <RadzenLabel Component="SimulationName" Text="Simulazione" />
                        <SimulationSelector Name="SimulationName" @bind-SimulationName=@this.Request.SimulationName />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="2">
                    <div class="rz-text-align-left">
                        <RadzenCheckBox TValue="bool" @bind-Value=@SaveBudget Name="SaveBudget" />
                        <RadzenLabel Text="Salva il preventivo" Component="SaveBudget" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nome da dare al preventivo</RadzenText>
                    <RadzenTextBox Disabled=@(!this.SaveBudget) @bind-Value=@Request.BudgetName class="w-100" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Tipo di preventivo</RadzenText>
                            <RadzenDropDown Data="@BudgetTypes"
                                            AllowClear=true
                                            Placeholder="seleziona il tipo di preventivo"
                                            Disabled=@(!this.SaveBudget)
                                            Name="@nameof(CalcCostsRequest.BudgetType)"
                                            @bind-Value=@this.Request.BudgetType
                                            ValueProperty="@nameof(BudgetType.Id)"
                                            TextProperty="@nameof(BudgetType.Description)"
                                            class="w-100" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenRadioButtonList @bind-Value=@CostTYpe TValue="CostTYpeEnum" Orientation="Orientation.Vertical" Style="min-width: 120px" >
                <Items>
                    <RadzenRadioButtonListItem Text="Per Mezzo" Value="@CostTYpeEnum.ByCar" />
                    <RadzenRadioButtonListItem Text="Per Corsa" Value="@CostTYpeEnum.ByRun" />
                </Items>
            </RadzenRadioButtonList>

            <RadzenButton Text="Cerca..."
                            IsBusy=@isLoading
                            BusyText="Ricerca..."
                            Click=@LoadDataByCarAsync />
        </RadzenStack>
    </RadzenStack>
</RadzenRow>
@if(CostTYpe == CostTYpeEnum.ByCar)
{
    <RadzenRow>
        <CostDetailByCar IsLoading=@isLoading
                         Data=@ByCarData
                         Total=@ByCarTotals />
    </RadzenRow>
}
@if (CostTYpe == CostTYpeEnum.ByRun)
{
    <RadzenRow>
        <CostDetailByRun IsLoading=@isLoading
                        Data=@ByRunData
                        Total=@ByRunTotals />
    </RadzenRow>
}

@code {
    private enum CostTYpeEnum
    {
        ByCar,
        ByRun
    }

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    [CascadingParameter]
    CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

    private string GrdiStyle = "height:900px; width:100%";
    private CostTYpeEnum CostTYpe { get; set; } = CostTYpeEnum.ByCar;

    private CalcCostsRequest Request { get; set; } = new CalcCostsRequest();
    private bool _SaveBudget = false;
    private bool SaveBudget
    {
        get { return _SaveBudget; }
        set 
        {
            _SaveBudget = value;
            if (this.SaveBudget == false)
            {
                this.Request.BudgetName = null;
                this.Request.BudgetType = null;
            }
        }
    }

    private class BudgetType
    {
        public string Id { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
    private IList<BudgetType> BudgetTypes = new  List<BudgetType> ()
    {
        new BudgetType { Id = Constants.BudgetTYpe_SchoolYearStart, Description = "Preventivo a inizio anno scolastico"},
        new BudgetType { Id = Constants.BudgetTYpe_SolarYearStart, Description = "Preventivo a inizio anno Solare"},
        new BudgetType { Id = Constants.BudgetTYpe_Other, Description = "Altro"}
    };

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        this.Request.ContractId = GlobalFilters.Contract?.Id;
        this.Request.StartDate = GlobalFilters.Period?.StartDate;
        this.Request.EndDate = GlobalFilters.Period?.EndDate;

        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        this.isLoading = true;
        
        try
        {
            if (this.CostTYpe == CostTYpeEnum.ByCar)
            {
                var data = await this._CostService.GetCostsByAssociateASync(
                    this.Request);

                this.ByCarData = data;
                this.ByCarTotals = this._CostService.ComputeTotalsByCar(this.ByCarData);
            }
            else if (this.CostTYpe == CostTYpeEnum.ByRun)
            {
                var data = await this._CostService.GetCostsByAssociateByRunASync(
                    this.Request);

                this.ByRunData = data;
                this.ByRunTotals = this._CostService.ComputeTotalsByRun(this.ByRunData);
            }
        }
        catch (BadRequestException<CheckResult> ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                ex.Payload?.Title ?? "problemi",
                ex.Payload?.Description ?? string.Empty
            );
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "Errore caricando i dati o generando il preventivo",
                ex.Message);
        }
        finally
        {
            this.isLoading = false;
        }
    }

    #region By car

    private IEnumerable<CostByAssociateItem>? ByCarData = null;
    private CostByAssociateItem ByCarTotals { get; set; } = new CostByAssociateItem();

    private async Task LoadDataByCarAsync ()
    {
        // await LoadDataAsync(CostTYpeEnum.ByCar);
        await LoadDataAsync();
    }
    
    #endregion

    #region by Run
    private IEnumerable<CostByAssociateByRunItem>? ByRunData = null;
    private CostByAssociateByRunItem ByRunTotals { get; set; } = new CostByAssociateByRunItem();

    /*
    private async Task LoadDataByRunAsync()
    {
        await LoadDataAsync(CostTYpeEnum.ByRun);
    }
    */
    #endregion
}
