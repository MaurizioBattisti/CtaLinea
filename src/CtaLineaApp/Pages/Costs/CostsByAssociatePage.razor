@page "/costbyassociate"

@inject IExcelExporterService ExcelService
@inject NotificationService _notificationService
@inject ICostService _CostService;
@inject IApplicationSettings AppSettings;
@attribute [Authorize]

<CheckAuthorization Roles=@(new string[] { UserRoles.Role_Costs }) />
<PageTitle>@Constants.App_Title - Costi per Ditta</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Costi per ditta" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenRow >
    <RadzenStack Orientation="Orientation.Horizontal"
                    Gap="5px" Wrap="FlexWrap.NoWrap"
                    JustifyContent="JustifyContent.End"
                    AlignItems="AlignItems.Start">
        <RadzenStack Orientation="Orientation.Vertical"
                        AlignItems="AlignItems.Stretch">
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Riferimento appalto</RadzenText>
                    <ContractDropDown @bind-ContractId="Request.ContractId" AllowClear=false Changed=@(() => this.StateHasChanged()) />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <AssociateAndCarDropDown @bind-AssociateId="Request.ASsociateId" @bind-CarId="Request.CarId" Inline=true AllowClear=true />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" >
                    <DateRangeSelector @bind-StartDate="Request.StartDate" @bind-EndDate="Request.EndDate" Inline=true AllowClear=true />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="2" Wrap="FlexWrap.Wrap">
                        <div class="rrz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeOutOfPeriod Name="IncludeOutOfPeriod" />
                            <RadzenLabel Text="Includi giorni fuori periodo" Component="IncludeOutOfPeriod" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeSuspended Name="IncludeSuspended" />
                            <RadzenLabel Text="Includi giorni do sospensioni" Component="IncludeSuspended" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.UseReplacedCars Name="UseReplacedCars" />
                            <RadzenLabel Text="Attribuisce i costi ai mezzi che realmente hanno effettuato il servizio" Component="UseReplacedCars" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                        <div class="rz-text-align-center">
                            <RadzenCheckBox TValue="bool" @bind-Value=@Request.ForceFreshData Name="ForceFreshData" />
                            <RadzenLabel Text="Forza calcolo con dati nuovi" Component="ForceFreshData" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="2">
                    <div class="rz-text-align-left">
                        <RadzenCheckBox TValue="bool" @bind-Value=@SaveBudget Name="SaveBudget" />
                        <RadzenLabel Text="Salva il preventivo" Component="SaveBudget" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nome da dare al preventivo</RadzenText>
                    <RadzenTextBox Disabled=@(!this.SaveBudget) @bind-Value=@Request.BudgetName class="w-100" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Tipo di preventivo</RadzenText>
                            <RadzenDropDown Data="@BudgetTypes"
                                            AllowClear=true
                                            Placeholder="seleziona il tipo di preventivo"
                                            Disabled=@(!this.SaveBudget)
                                            Name="@nameof(CalcCostsRequest.BudgetType)"
                                            @bind-Value=@this.Request.BudgetType
                                            ValueProperty="@nameof(BudgetType.Id)"
                                            TextProperty="@nameof(BudgetType.Description)"
                                            class="w-100" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenRadioButtonList @bind-Value=@CostTYpe TValue="CostTYpeEnum" Orientation="Orientation.Vertical" Style="min-width: 120px" >
                <Items>
                    <RadzenRadioButtonListItem Text="Per Mezzo" Value="@CostTYpeEnum.ByCar" />
                    <RadzenRadioButtonListItem Text="Per Corsa" Value="@CostTYpeEnum.ByRun" />
                </Items>
            </RadzenRadioButtonList>

            <RadzenButton Text="Cerca..."
                            IsBusy=@isLoading
                            BusyText="Ricerca..."
                            Click=@LoadDataByCarAsync />
        </RadzenStack>
    </RadzenStack>
</RadzenRow>
@if(CostTYpe == CostTYpeEnum.ByCar)
{
    <RadzenRow>
        <RadzenDataGrid FilterMode="FilterMode.Simple"
                        IsLoading=@isLoading
                        CellRender="@Month_CellRender"
                        Culture=@AppSettings.CurrentCulture
                        Data="@this.ByCarData" TItem="CostByAssociateItem"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        AllowVirtualization=true
                        LogicalFilterOperator="LogicalFilterOperator.And"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Density=@Settings.Density
                        Style=@GrdiStyle>
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenSplitButton ButtonStyle="ButtonStyle.Dark"
                                        Icon="file_download" Click=@DownloadDataByCar_Click>
                        <ChildContent>
                            <RadzenSplitButtonItem Text="Excel" Value="X" Icon="grid_on" />
                            <RadzenSplitButtonItem Text="CSV" Value="C" Icon="wrap_text" />
                        </ChildContent>
                    </RadzenSplitButton>
                </RadzenStack>
            </HeaderTemplate>
            <EmptyTemplate>
                <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun dato da visaulizzare !</p>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.ContractName)" Title="Appalto" Width="200px" />
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.AssociateName)" Title="Ditta" Width="200px" />
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CarDescription)" Title="Mezzo" Width="70px" />

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Month)" Title="Mese" Width="100px" />

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.KmTot)" Title="Km Totali" FormatString="{0:f2}" Width="100px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",ByCarTotals.KmTot)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Total)" Title="Costo Totale" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.Total)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Km)" Title="Tod. Km" FormatString="{0:f2}" Width="100px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",ByCarTotals.Km)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.KmExtra)" Title="Tod. Km Extra" FormatString="{0:f2}" Width="100px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",ByCarTotals.KmExtra)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayCost)" Title="Tod. Costo da GG" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.DayCost)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CostKm)" Title="Tod. Costo Km GG" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.CostKm)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CostKmExtra)" Title="Tit. Costo Km GG Extra" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.CostKmExtra)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayIntegration)" Title="Tot. int. GG" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.DayIntegration)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayForfait)" Title="Tot. Forfait GG" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.DayForfait)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayMultiRunForfait)" Title="Tot. Forfait Multiplo GG" FormatString="{0:C}" Width="150px">
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",ByCarTotals.DayMultiRunForfait)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
}
