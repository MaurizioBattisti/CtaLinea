@page "/costbyassociate"

@inject IExcelExporterService ExcelService
@inject NotificationService _notificationService
@inject ICostService _CostService;
@inject IApplicationSettings AppSettings;
@attribute [Authorize]

<CheckAuthorization Roles=@(new string[] { UserRoles.Role_Costs }) />
<PageTitle>@Constants.App_Title - Costi per Ditta</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Costi per ditta" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenLayout Style="width: 100%">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Vertical"
                     AlignItems="AlignItems.Stretch">
            <div class="d-flex flex-row p-1">
                <div class="col-md-11">
                    <div class="d-flex flex-row">
                        <div class="col-md-4">
                            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Riferimento appalto</RadzenText>
                            <ContractDropDown @bind-ContractId="Request.ContractId" AllowClear=false Changed=@(() => this.StateHasChanged()) />
                        </div>
                        <div class="col-md-8">
                            <AssociateAndCarDropDown @bind-AssociateId="Request.ASsociateId" @bind-CarId="Request.CarId" Inline=true AllowClear=true />
                        </div>
                    </div>
                    <div class="d-flex flex-row">
                        <div class="col-md-4">
                            <DateRangeSelector @bind-StartDate="Request.StartDate" @bind-EndDate="Request.EndDate" Inline=true AllowClear=true />
                        </div>
                        <div class="col-md-8">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="2" Wrap="FlexWrap.Wrap">
                                <div class="rrz-text-align-center">
                                    <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeOutOfPeriod Name="IncludeOutOfPeriod" />
                                    <RadzenLabel Text="Includi giorni fuori periodo" Component="IncludeOutOfPeriod" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>
                                <div class="rz-text-align-center">
                                    <RadzenCheckBox TValue="bool" @bind-Value=@Request.IncludeSuspended Name="IncludeSuspended" />
                                    <RadzenLabel Text="Includi giorni do sospensioni" Component="IncludeSuspended" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>
                                <div class="rz-text-align-center">
                                    <RadzenCheckBox TValue="bool" @bind-Value=@Request.UseReplacedCars Name="UseReplacedCars" />
                                    <RadzenLabel Text="Attribuisce i costi ai mezzi che realmente hanno effettuato il servizio" Component="UseReplacedCars" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>
                                <div class="rz-text-align-center">
                                    <RadzenCheckBox TValue="bool" @bind-Value=@Request.ForceFreshData Name="ForceFreshData" />
                                    <RadzenLabel Text="Forza calcolo con dati nuovi" Component="ForceFreshData" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>

                            </RadzenStack>
                        </div>
                    </div>
                    <div class="d-flex flex-row">
                        <div class="col-md-2">
                            <div class="rz-text-align-left">
                                <RadzenCheckBox TValue="bool" @bind-Value=@SaveBudget Name="SaveBudget" />
                                <RadzenLabel Text="Salva il preventivo" Component="SaveBudget" Style="margin-left: 8px; vertical-align: middle;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nome da dare al preventivo</RadzenText>
                            <RadzenTextBox Disabled=@(!this.SaveBudget) @bind-Value=@Request.BudgetName class="w-100" />
                        </div>
                        <div class="col-md-4">
                            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Tipo di preventivo</RadzenText>
                            <RadzenDropDown Data="@BudgetTypes"
                                            AllowClear=true
                                            Placeholder="seleziona il tipo di preventivo"
                                            Disabled=@(!this.SaveBudget)
                                            Name="@nameof(CalcCostsRequest.BudgetType)"
                                            @bind-Value=@this.Request.BudgetType
                                            ValueProperty="@nameof(BudgetType.Id)"
                                            TextProperty="@nameof(BudgetType.Description)"
                                            class="w-100" />
                        </div>
                    </div>
                </div>
                
                <div class="col-md-1">
                    <RadzenButton Text="Carica..."
                        IsBusy=@isLoading
                        BusyText="Ricerca..."
                        Click=@LoadDataAsync
                        />
                </div>
            </div>
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <RadzenDataGrid @ref="@grdData"
                        FilterMode="FilterMode.Simple"
                        IsLoading=@isLoading
                        CellRender="@Month_CellRender"
                        Culture=@AppSettings.CurrentCulture
                        Data="@this.Data" TItem="CostByAssociateItem"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        AllowVirtualization=true
                        LogicalFilterOperator="LogicalFilterOperator.And"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Density=@Settings.Density
                        Style="height:100%; width:100%">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenSplitButton ButtonStyle="ButtonStyle.Dark"
                                       Icon="file_download" Click=@DownloadData_Click>
                        <ChildContent>
                            <RadzenSplitButtonItem Text="Excel" Value="X" Icon="grid_on" />
                            <RadzenSplitButtonItem Text="CSV" Value="C" Icon="wrap_text" />
                        </ChildContent>
                    </RadzenSplitButton>
                </RadzenStack>
            </HeaderTemplate>
            <EmptyTemplate>
                <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun dato da visaulizzare !</p>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.ContractName)" Title="Appalto" Width="200px" />
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.AssociateName)" Title="Ditta" Width="200px" />
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CarDescription)" Title="Mezzo" Width="70px" />

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Month)" Title="Mese" Width="100px" />
                
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.KmTot)" Title="Km Totali" FormatString="{0:f2}" Width="100px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",Totals.KmTot)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Total)" Title="Costo Totale" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.Total)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.Km)" Title="Tod. Km" FormatString="{0:f2}" Width="100px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",Totals.Km)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.KmExtra)" Title="Tod. Km Extra" FormatString="{0:f2}" Width="100px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:f2}",Totals.KmExtra)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayCost)" Title="Tod. Costo da GG" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.DayCost)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CostKm)" Title="Tod. Costo Km GG" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.CostKm)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.CostKmExtra)" Title="Tit. Costo Km GG Extra" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.CostKmExtra)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayIntegration)" Title="Tot. int. GG" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.DayIntegration)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayForfait)" Title="Tot. Forfait GG" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.DayForfait)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CostByAssociateItem" Property="@nameof(CostByAssociateItem.DayMultiRunForfait)" Title="Tot. Forfait Multiplo GG" FormatString="{0:C}" Width="150px" >
                    <FooterTemplate>
                        <RadzenText Text="@string.Format("{0:C}",Totals.DayMultiRunForfait)" />
                    </FooterTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenBody>    
</RadzenLayout>

@code {
    RadzenDataGrid<CostByAssociateItem>? grdData;

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    [CascadingParameter]
    CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

    private CalcCostsRequest Request { get; set; } = new CalcCostsRequest();
    private bool _SaveBudget = false;
    private bool SaveBudget
    {
        get { return _SaveBudget; }
        set 
        {
            _SaveBudget = value;
            if (this.SaveBudget == false)
            {
                this.Request.BudgetName = null;
                this.Request.BudgetType = null;
            }
        }
    }

    private class BudgetType
    {
        public string Id { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
    private IList<BudgetType> BudgetTypes = new  List<BudgetType> ()
    {
        new BudgetType { Id = Constants.BudgetTYpe_SchoolYearStart, Description = "Preventivo a inizio anno scolastico"},
        new BudgetType { Id = Constants.BudgetTYpe_SolarYearStart, Description = "Preventivo a inizio anno Solare"},
        new BudgetType { Id = Constants.BudgetTYpe_Other, Description = "Altro"}
    };

    private bool isLoading = false;
    private IEnumerable<CostByAssociateItem>? Data = null;
    private CostByAssociateItem Totals { get; set; } = new CostByAssociateItem();

    protected override async Task OnInitializedAsync()
    {
        this.Request.ContractId = GlobalFilters.Contract?.Id;
        this.Request.StartDate = GlobalFilters.Period?.StartDate;
        this.Request.EndDate = GlobalFilters.Period?.EndDate;

        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync ()
    {
        this.isLoading = true;
        try
        {
            var data = await this._CostService.GetCostsByAssociateASync(
                this.Request);

            this.Data = data;
            this.Totals = this.ComputeTotals(this.Data);
        }
        catch (BadRequestException<CheckResult> ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                ex.Payload?.Title ?? "problemi",
                ex.Payload?.Description ?? string.Empty
            );
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "Errore caricando i dati o generando il preventivo",
                ex.Message);
        }
        finally
        {
            this.isLoading = false;
        }
    }
    private CostByAssociateItem ComputeTotals(IEnumerable<CostByAssociateItem> costs)
    {
        var total = new CostByAssociateItem()
            {
                Km = 0,
                KmExtra = 0,
                DayCost = 0,
                CostKm = 0,
                CostKmExtra = 0,
                DayIntegration = 0,
                DayForfait = 0,
                DayMultiRunForfait = 0
            };
        foreach (var c in costs)
        {
            total.Km += c.Km;
            total.KmExtra += c.KmExtra;
            total.DayCost += c.DayCost;
            total.CostKm += c.CostKm;
            total.CostKmExtra += c.CostKmExtra;

            total.DayIntegration += c.DayIntegration;
            total.DayForfait += c.DayForfait;
            total.DayMultiRunForfait += c.DayMultiRunForfait;
        }

        return total;
    }
    private async Task DownloadData_Click(RadzenSplitButtonItem item)
    {
        try
        {
            this.isLoading = true;
            var data = this.Data;
            if (data != null)
            {
                // var columninfo = this.grdData?.GetExportColumnInfo();
                var columninfo = data.GetExportColumnInfo();

                string title = "Mezzi";
                if (item == null)
                {
                    await this.ExcelService.Export(title, data, columninfo);
                }
                else
                {
                    switch (item.Value)
                    {
                        case "X":
                            await this.ExcelService.ExportExcel(title, data, columninfo);
                            break;
                        case "C":
                            await this.ExcelService.ExportCsv(title, data, columninfo);
                            break;
                    }
                }
                this._notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
            }
            else
            {
                this._notificationService.Notify(
                    NotificationSeverity.Warning,
                    "Nessun dato da esportare"
                    );
            }
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "ERrore recuperando i dati",
                ex.Message
                );
        }
        finally
        {
            this.isLoading = false;
        }
    }

    private void Month_CellRender(DataGridCellRenderEventArgs<CostByAssociateItem> args)
    {
        if (args.Column.Property == nameof(CostByAssociateItem.KmTot)
            || args.Column.Property == nameof(CostByAssociateItem.Total))
        {
            args.Attributes.Add("style", $"background-color: var(--rz-success-darker)");
        }
    }
}
