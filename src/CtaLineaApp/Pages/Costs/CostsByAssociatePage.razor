@code {
    private enum CostTYpeEnum
    {
        ByCar,
        ByRun
    }

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    [CascadingParameter]
    CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

    private string GrdiStyle = "height:900px; width:100%";
    private CostTYpeEnum CostTYpe { get; set; } = CostTYpeEnum.ByCar;

    private CalcCostsRequest Request { get; set; } = new CalcCostsRequest();
    private bool _SaveBudget = false;
    private bool SaveBudget
    {
        get { return _SaveBudget; }
        set 
        {
            _SaveBudget = value;
            if (this.SaveBudget == false)
            {
                this.Request.BudgetName = null;
                this.Request.BudgetType = null;
            }
        }
    }

    private class BudgetType
    {
        public string Id { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
    private IList<BudgetType> BudgetTypes = new  List<BudgetType> ()
    {
        new BudgetType { Id = Constants.BudgetTYpe_SchoolYearStart, Description = "Preventivo a inizio anno scolastico"},
        new BudgetType { Id = Constants.BudgetTYpe_SolarYearStart, Description = "Preventivo a inizio anno Solare"},
        new BudgetType { Id = Constants.BudgetTYpe_Other, Description = "Altro"}
    };

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        this.Request.ContractId = GlobalFilters.Contract?.Id;
        this.Request.StartDate = GlobalFilters.Period?.StartDate;
        this.Request.EndDate = GlobalFilters.Period?.EndDate;

        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync(
        CostTYpeEnum costTyle)
    {
        this.isLoading = true;
        this.CostTYpe = costTyle;
        try
        {
            if (costTyle == CostTYpeEnum.ByCar)
            {
                var data = await this._CostService.GetCostsByAssociateASync(
                    this.Request);

                this.ByCarData = data;
                this.ByCarTotals = this.ComputeTotalsByCar(this.ByCarData);
            }
            else if (costTyle == CostTYpeEnum.ByRun )
            {
                var data = await this._CostService.GetCostsByAssociateByRunASync(
                    this.Request);

                this.ByRunData = data;
                this.ByRunTotals = this.ComputeTotalsByRun(this.ByRunData);
            }
        }
        catch (BadRequestException<CheckResult> ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                ex.Payload?.Title ?? "problemi",
                ex.Payload?.Description ?? string.Empty
            );
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "Errore caricando i dati o generando il preventivo",
                ex.Message);
        }
        finally
        {
            this.isLoading = false;
        }
    }

    private async Task ExportDataAsync<TEntity> (
        RadzenSplitButtonItem item,
        IEnumerable<TEntity>? data,
        string title
        )
        where TEntity : class
    {
        try
        {
            this.isLoading = true;

            if (data != null)
            {
                var columninfo = data.GetExportColumnInfo();

                if (item == null)
                {
                    await this.ExcelService.Export(title, data, columninfo);
                }
                else
                {
                    switch (item.Value)
                    {
                        case "X":
                            await this.ExcelService.ExportExcel(title, data, columninfo);
                            break;
                        case "C":
                            await this.ExcelService.ExportCsv(title, data, columninfo);
                            break;
                    }
                }
                this._notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
            }
            else
            {
                this._notificationService.Notify(
                    NotificationSeverity.Warning,
                    "Nessun dato da esportare"
                    );
            }
        }
        catch (Exception ex)
        {
            this._notificationService.Notify(
                NotificationSeverity.Error,
                "ERrore recuperando i dati",
                ex.Message
                );
        }
        finally
        {
            this.isLoading = false;
        }
    }

    #region By car

    private IEnumerable<CostByAssociateItem>? ByCarData = null;
    private CostByAssociateItem ByCarTotals { get; set; } = new CostByAssociateItem();

    private async Task LoadDataByCarAsync ()
    {
        await LoadDataAsync(CostTYpeEnum.ByCar);
    }
    private CostByAssociateItem ComputeTotalsByCar(IEnumerable<CostByAssociateItem> costs)
    {
        var total = new CostByAssociateItem()
            {
                Km = 0,
                KmExtra = 0,
                DayCost = 0,
                CostKm = 0,
                CostKmExtra = 0,
                DayIntegration = 0,
                DayForfait = 0,
                DayMultiRunForfait = 0
            };
        foreach (var c in costs)
        {
            total.Km += c.Km;
            total.KmExtra += c.KmExtra;
            total.DayCost += c.DayCost;
            total.CostKm += c.CostKm;
            total.CostKmExtra += c.CostKmExtra;

            total.DayIntegration += c.DayIntegration;
            total.DayForfait += c.DayForfait;
            total.DayMultiRunForfait += c.DayMultiRunForfait;
        }

        return total;
    }
    private async Task DownloadDataByCar_Click(RadzenSplitButtonItem item)
    {
        await this.ExportDataAsync (item, this.ByCarData, "Costi per MEzzo");
    }

    private void Month_CellRender(DataGridCellRenderEventArgs<CostByAssociateItem> args)
    {
        if (args.Column.Property == nameof(CostByAssociateItem.KmTot)
            || args.Column.Property == nameof(CostByAssociateItem.Total))
        {
            args.Attributes.Add("style", $"background-color: var(--rz-success-darker)");
        }
    }
    #endregion

    #region by Run
    private IEnumerable<CostByAssociateByRunItem>? ByRunData = null;
    private CostByAssociateByRunItem ByRunTotals { get; set; } = new CostByAssociateByRunItem();

    private async Task LoadDataByRunAsync()
    {
        await LoadDataAsync(CostTYpeEnum.ByRun);
    }
    private CostByAssociateByRunItem ComputeTotalsByRun(IEnumerable<CostByAssociateByRunItem> costs)
    {
        var total = new CostByAssociateByRunItem()
            {
                Km = 0,
                KmExtra = 0,
                DayCost = 0,
                CostKm = 0,
                CostKmExtra = 0,
                DayIntegration = 0,
                DayForfait = 0,
                DayMultiRunForfait = 0
            };
        foreach (var c in costs)
        {
            total.Km += c.Km;
            total.KmExtra += c.KmExtra;
            total.DayCost += c.DayCost;
            total.CostKm += c.CostKm;
            total.CostKmExtra += c.CostKmExtra;

            total.DayIntegration += c.DayIntegration;
            total.DayForfait += c.DayForfait;
            total.DayMultiRunForfait += c.DayMultiRunForfait;
        }

        return total;
    }
    private async Task DownloadDataByRun_Click(RadzenSplitButtonItem item)
    {
        await this.ExportDataAsync(item, this.ByRunData, "Costi per Corsa");
    }
    
    private string FormatTime(
        TimeSpan? time)
    {
        if (time == null) return string.Empty;
        var to = new TimeOnly(time.Value.Hours, time.Value.Minutes, time.Value.Minutes);
        return string.Format("{0:HH:mm}", to);
    }
    #endregion
}
