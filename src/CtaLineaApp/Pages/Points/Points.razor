@page "/points"
@inject IAutoLoadDataList<CollectionPointQueryItem> AutoLoad;
@inject IExcelExporterService ExcelService
@inject NotificationService notificationService
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Punti</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Punti" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData"
                FilterMode="FilterMode.Simple"
                IsLoading=@AutoLoad.isLoading
                Count="@AutoLoad.RowCount"
                LoadData="@this.AutoLoad.LoadData"
                Data="@this.AutoLoad.Data" TItem="CollectionPointQueryItem"
                AllowFiltering="true"
                AllowColumnResize="true"
                AllowSorting="true"
                LogicalFilterOperator="LogicalFilterOperator.And"
                Style="height:100%"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Density=@Settings.Density
                PageSize=@(Settings?.PageSize ?? 5)>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenSplitButton ButtonStyle="ButtonStyle.Dark"
                               Icon="file_download" Click=@DownloadData_Click>
                <ChildContent>
                    <RadzenSplitButtonItem Text="Excel" Value="X" Icon="grid_on" />
                    <RadzenSplitButtonItem Text="CSV" Value="C" Icon="wrap_text" />
                </ChildContent>
            </RadzenSplitButton>

            <RadzenTextBox @bind-Value=@this.AutoLoad.FullTextSearch Placeholder="Cerca..." Style="width: 200px" Change="@FullText_OnChange" Class="w-100" />
            <RadzenButton ButtonStyle="ButtonStyle.Success"
                          IsBusy=@AutoLoad.isLoading
                          Icon="refresh"
                          Click="@(()=>ReloadData())" />
        </RadzenStack>
    </HeaderTemplate>
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessuna fermata trovata !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="Id" Title="cod. nodo" Width="100px" />

        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="Description" Title="Descrizione" Width="250px" />
        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="Address" Title="Indirizzo" Width="250px" />
        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="City" Title="Comune" Width="250px" />
        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="ZipCode" Title="CAP" Width="120px" />

        <RadzenDataGridColumn TItem="CollectionPointQueryItem" Property="CollectionPointType" Title="Tipo punto" Width="120px" />
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<CollectionPointQueryItem>? grdData;

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

    private async Task DownloadData_Click(RadzenSplitButtonItem item)
    {
        this.AutoLoad.StartLoading();

        try
        {
            var data =  await this.AutoLoad.GetAllAsync();
            if (data != null)
            {
                // var columninfo = this.grdData?.GetExportColumnInfo();
                var columninfo = data.GetExportColumnInfo();

                string title = "Punti di Raccolta";
                if (item == null)
                {
                    await this.ExcelService.Export(title, data, columninfo);
                }
                else
                {
                    switch (item.Value)
                    {
                        case "X":
                            await this.ExcelService.ExportExcel(title, data, columninfo);
                            break;
                        case "C":
                            await this.ExcelService.ExportCsv(title, data, columninfo);
                            break;
                    }
                }
                this.notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
            }
            else
            {
                this.notificationService.Notify(
                    NotificationSeverity.Warning,
                    "Nessun dato da esportare"
                    );
            }
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "ERrore recuperando i dati",
                ex.Message
                );
        }
        finally
        {
            this.AutoLoad.EndLoading();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        AutoLoad.Initilize(
            Constants.Endpoint_CollectionPoints
            );

        await Task.CompletedTask;
    }

    private async Task FullText_OnChange(string value)
    {
        await ReloadData();
    }

    private async Task ReloadData ()
    {
        if (this.grdData != null)
        {
            await this.grdData.Reload();
        }

    }
}