@using CtaLineaApp.Components.Base

@inject IRunModelService RunModelService
@inject IApplicationSettings AppSettings

<RadzenStack Orientation="Orientation.Horizontal">
	<RadzenIcon Icon="@(this.CurrentRun.Extra ?"health_and_safety" : "shield")" IconStyle=@(this.CurrentRun.Extra ? IconStyle.Warning : IconStyle.Info) />
	<RadzenIcon Icon="auto_awesome" Visible=@CurrentRun.Elastibus IconStyle="IconStyle.Primary" />
	<RadzenLabel Text="Appalto" />
	<RadzenText Text=@CurrentRun.ContractData?.ContractName />
</RadzenStack>
<RadzenRow>
	<RadzenColumn Size="2" >
		<RadzenLabel Text="Inizio" />
	</RadzenColumn>
	<RadzenColumn Size="2">
		<RadzenText Text=@FormatDate(CurrentRun.StartDate) />
	</RadzenColumn>
</RadzenRow>

@code {
	RunVariationMainDataVide? RunVariationMainDataVide;

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	private bool ReadOnly = true;
	private bool SuperEditMode = false;
	public RunVariation CurrentVariation { get; set; } = new RunVariation();

	protected override async Task OnInitializedAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// recupera la variante di default
		if (this.CurrentRun != null
			&& this.CurrentRun?.Variations != null)
		{
			var variation = (from v in this.CurrentRun.Variations
								where v.StartDate == null
								select v).SingleOrDefault();
			if (variation != null)
			{
				this.CurrentVariation = variation;
			}
		}

		await base.OnParametersSetAsync();
	}

	private string FormatDate(
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format(this.AppSettings.CurrentCulture, "{0:dd/MM/yyyy}", date);
	}
}
