@page "/run-print/{RunIds}"
@using CtaLinea.Model.Request
@inject IJSRuntime jsRuntime
@inject ICurrentUserService _userSvc
@inject IRunRepository _runRepo
@inject NotificationService _notificationService
@attribute [Authorize]

<RadzenRow class="noprint p-1">
	<RadzenButton 
		Disabled=@(!CanPrint)
		IsBusy=@IsBusy 
		Click="@PrintClick" 
		Text="Stampa..." 
		Icon="print" />
</RadzenRow>

@foreach(var run in this.Runs)
{
	@if (this.Runs.IndexOf(run) > 0)
	{
		<!-- salto pagina-->
		<div style="break-before:page"></div>
	}
	<div class="print-on-screen" >
		<PrintRun PrintData=@run />
	</div>
}
@code {
	[Parameter]
	public string RunIds { get; set; } = string.Empty;

	private IList <RunForPrintModel> Runs = new List<RunForPrintModel>();
	private GetRunForPrintRequest Args = new GetRunForPrintRequest ();
	private bool IsBusy = false;
	private bool CanPrint = false;

	protected override async Task OnParametersSetAsync()
	{
		if (string.IsNullOrWhiteSpace(this.RunIds) == false)
		{
			var list = this.RunIds.Split(",");
			this.Args.RunCtaIds = (from id in list
											select int.Parse(id)
						).ToList();

			await this.LoadDataAsync();
		}

		await  base.OnParametersSetAsync();
	}

	private async Task LoadDataAsync()
	{
		try
		{
			this.CanPrint = false;
			this.IsBusy = true;

			var runs = await this._runRepo.GetRunsForPrintAsync(
				this.Args);

			if (runs != null )
			{
				this.Runs = runs.ToList();
			}
			this.CanPrint = true;
		}
		catch (Exception ex)
		{
			_notificationService.Notify(
				NotificationSeverity.Error,
				"Errore durante il caricamento dei dati da stamapre",
				ex.Message
				);
		}
		finally
		{
			this.IsBusy = false;
		}
	}

	private void PrintClick()
	{
		jsRuntime.InvokeVoidAsync("PrintCurent");
	}
}
