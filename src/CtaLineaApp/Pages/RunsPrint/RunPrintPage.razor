@page "/run-print/{RunIds}"
@inject IJSRuntime jsRuntime
@inject ICurrentUserService _userSvc;
@attribute [Authorize]

<RadzenRow class="noprint">
	<RadzenButton Click="@PrintClick" Text="Stampa..." Icon="print" />
</RadzenRow>

@foreach(var run in this.Runs)
{
	@if (this.Runs.IndexOf(run) > 0)
	{
		<!-- salto pagina-->
		<div style="break-before:page"></div>
	}

	<div class="noscreen">
		<PrintRun RunId="@run.RunId" />
	</div>
}

@code {
	private class PrintData
	{
		public Guid RunId { get; set; }
		public RunItem? Run { get; set; }
		public string Message { get; set; } = string.Empty;
	}

	[Parameter]
	public string RunIds { get; set; } = string.Empty;

	private IList<PrintData> Runs = new List<PrintData>();

	protected override async Task OnParametersSetAsync()
	{
		if (string.IsNullOrWhiteSpace(this.RunIds) == false)
		{
			var list = this.RunIds.Split("|");
			this.Runs = (from id in list
							select new PrintData ()
							{
								 RunId = new Guid(id),
								 Run = null
							}
						)
					.ToList();
			await this.LoadDataAsync();
		}

		await  base.OnParametersSetAsync();
	}

	private async Task LoadDataAsync()
	{
		
		await Task.CompletedTask;
	}

	private void PrintClick()
	{
		jsRuntime.InvokeVoidAsync("PrintCurent");
	}



}
