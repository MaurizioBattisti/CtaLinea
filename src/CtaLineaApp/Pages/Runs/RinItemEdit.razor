@page "/run-edit/{Id:guid}"
@inject IRunRepository _repo
@inject IQueryUtilityService queryService
@inject IRunModelService RunModelService
@inject IContractService ContractService
@inject DialogService DialogService
@inject NotificationService notificationService
@inject RouterSessionService RouterSessionService
@inject IRunChecker runChecker

@inherits EditorComponentBase
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Modifcia Corsa</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Modifcia Corsa" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
        
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

@if (IsBusy == true)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <CheckREsultView
        CheckResult=@CheckResult
        ShowSuccessMessage=true
        />

    <BaseRunDataView EditableData=@this CurrentRun=@CurrentRun EditMode=@EditMode />

    <RadzenCard>
        <RadzenButton Click=@Save_Click IsBusy=@IsSaving Text="Salva Corsa" BusyText="Salvataggio...." ButtonStyle="ButtonStyle.Primary" />
    </RadzenCard>
    <RadzenCard>
        <RunPlanningView @ref=@Planning RunId=@Id />
    </RadzenCard>
}
@code {
    [Parameter]
    public Guid Id { get; set; } = Guid.Empty;

    bool EditMode = true;
    RunItem CurrentRun = new RunItem();
    private bool IsBusy = true;
    private bool IsSaving = false;

    private RunCheckResult? CheckResult { get; set; }
    private RunPlanningView? Planning;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var run = await _repo.GetOneAsync(this.Id);
                if (run != null)
                {
                    this.CurrentRun = run;
                    this.IsClean = true;
                    this.CheckResult = await this.runChecker.CheckRunAsync(this.CurrentRun);
                }
                else
                {
                    // TODO: segnala un problema
                }
            }
            finally
            {
                this.IsBusy = false;
                this.StateHasChanged();
            }
        }
    }

    private async Task Save_Click()
    {
        await Task.CompletedTask;
        IsSaving = true;

        try
        {
            await this._repo.SaveRunAsync(
                this.Id, this.CurrentRun);
            this.IsClean = true;

            if (this.Planning != null)
            {
                await this.Planning.ReloadDataAsync();
            }
            this.CheckResult = await this.runChecker.CheckRunAsync(this.CurrentRun);
        }
        catch (BadRequestException<RunCheckResult> ex)
        {
            this.CheckResult = ex.Payload;

            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Dati non corretti",
                "verificare i dati prima di procedere con il salvataggio"
            );
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Salvataggio corsa Fallito !",
                ex.Message
            );
        }
        finally
        {
            IsSaving = false;
            this.StateHasChanged();
        }
    }

    /*
    private void Btn_Click()
    {
        this.IsClean = !IsClean;
        this.EditMode = !this.EditMode;
        this.StateHasChanged();
    }
    */
}