@inject IRunModelService RunModelService
@inject IApplicationSettings AppSettings

<RadzenCard>
	 <div class="d-flex flex-row p-1">
         <RadzenIcon Icon="block" IconStyle=IconStyle.Warning />
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Dal</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@this.FormatDate(Suspension.StartDate)</strong></RadzenText>

            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Al</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@this.FormatDate(Suspension.EndDate)</strong></RadzenText>
        </div>
		<div class="col-5">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Tipo sospensione</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@Suspension.SuspensionTypeData?.SuspensionTypeDescription</strong></RadzenText>
		</div>
		<div class="col-5">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Annotazioni sospensione</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@Suspension.SuspensionNote</strong></RadzenText>
		</div>
    </div>
</RadzenCard>

@code {
	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public bool EditMode { get; set; } = false;
	[Parameter]
	public RunSuspension Suspension { get; set; } = new RunSuspension();

	protected override async Task OnInitializedAsync()
	{

		await base.OnParametersSetAsync();
	}

	private string FormatDate (
		DateTime date)
	{
		return string.Format(this.AppSettings.CurrentCulture, "{0:dd/MM/yyyy}", date);
	}

	protected override async Task OnParametersSetAsync()
	{

		await base.OnParametersSetAsync();
	}

}
