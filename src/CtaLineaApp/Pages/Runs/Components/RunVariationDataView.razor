@using CtaLinea.Model.Runs
@using CtaLineaApp.Components.Base
@inject IRunModelService RunModelService

<div class="d-flex flex-row">
	<div class="col-2">
		@if(this.EditMode == true)
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nr. Linea</RadzenText>
			<RadzenNumeric TValue="int?" @bind-Value=@Variation.LineNumber Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />
					
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nr. Corsa</RadzenText>
			<RadzenNumeric TValue="int?" @bind-Value=@Variation.RunNumber Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />
		}
		else
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nr. Linea</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.LineNumber</strong></RadzenText>
					
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Nr. Corsa</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.RunNumber</strong></RadzenText>
		}
	</div>
	<div class="col-2">
		@if(this.EditMode == true)
		{
			<TimeRangeSelector 
				@bind-StartTime="Variation.StartTime"
				@bind-EndTime="Variation.EndTime"
				Changed=@(a=> this.EditableData?.SetDirty()) />
		}
		else
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Ora inizio</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatTime(Variation.StartTime)</strong></RadzenText>
					
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Ora fine</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatTime(Variation.EndTime)</strong></RadzenText>
		}
	</div>
	<div class="col-2">
		@if (this.EditMode == true)
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Calendario</RadzenText>
			<CalendarDropDown @ref="@Calendars" @bind-CalendarId=@SelectedCalednarId AllowClear=false Changed=@(a=> this.EditableData?.SetDirty()) />

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Frequenza</RadzenText>
			<RadzenTextBox @bind-Value="Variation.RequestedFrequency" MaxLength="200" Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Km</RadzenText>
			<KmInput @bind-Value="Variation.Km" Changed=@(a=> this.EditableData?.SetDirty()) />
		}
		else
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Calendario</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.CalendarData?.CalendarName</strong></RadzenText>

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Frequenza</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.RequestedFrequency</strong></RadzenText>

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Km</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.Km</strong></RadzenText>
		}
	</div>
	<div class="col-2">
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Monday Name="chkMonday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Lunedì" Component="chkMonday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Tuesday Name="chkTuesday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Martedì" Component="chkTuesday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Wednesday Name="chkWednesday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Mercoledì" Component="chkWednesday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Thursday Name="chkThursday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Giovedì" Component="chkThursday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Friday Name="chkFriday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Venerdì" Component="chkFriday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Saturday Name="chkSaturday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Sabato" Component="chkSaturday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
		<div>
			<RadzenCheckBox Disabled=@(!EditMode) @bind-Value=@this.Variation.Sunday Name="chkSunday" TValue="bool" Change=@(a=> this.EditableData?.SetDirty()) />
			<RadzenLabel Text="Domenica" Component="chkSunday" Style="margin-left: 8px; vertical-align: middle;" />
		</div>
	</div>
	<div class="col-4">
		@if(this.EditMode == true)
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Percorso</RadzenText>
			<RadzenTextArea @bind-Value="Variation.Path" Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Annotazioni</RadzenText>
			<RadzenTextArea @bind-Value="Variation.Note" Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />
		}
		else
		{
			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Percorso</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.Path</strong></RadzenText>

			<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Annotazioni</RadzenText>
			<RadzenText TextStyle="TextStyle.Body1"><strong>@Variation.Note</strong></RadzenText>
		}
	</div>
</div>

@code {
	[Parameter]
	public IEditableData? EditableData { get; set; }

	private CalendarDropDown? Calendars;
	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public RunVariation Variation { get; set; } = new RunVariation();
	[Parameter]
	public bool EditMode { get; set; } = false;

	protected override async Task OnInitializedAsync()
	{

		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{

		await base.OnParametersSetAsync();
	}

	private string FormatDate (
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format("{0:dd/MM/yyyy}", date);
	}

	private string FormatTime(
		TimeSpan? time)
	{
		if (time == null) return string.Empty;
		var dt = new DateTime(1, 1, 1);
		dt = dt.Add(time.Value);
		return string.Format("{0:HH:mm}", dt);
	}

	private int? SelectedCalednarId
	{
		get { return this.Variation.CalendarId; }
		set
		{
			if (value != null )
			{
				this.Variation.CalendarId = value.Value;
				this.EditableData?.SetDirty();
				if (Calendars != null)
				{
					var cal = Calendars.SelectedCalendarData;
					if (cal == null)
					{
						this.Variation.CalendarData = null;
					}
					else
					{
						this.Variation.CalendarData = new Calendar()
							{
								CalendarId = cal.Id,
								BaseCalendarId = cal.BaseCalendarId,
								CalendarName = cal.CalendarName
							};
					}
				}
			}
			else
			{
				this.StateHasChanged();
			}
		}
	}
}
