@using System.Globalization
@inject IRunModelService RunModelService
@inject IApplicationSettings AppSettings;

<div class="d-flex flex-row p-1">
    @if(EditMode == true)
    {
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al Km</RadzenText>
            <RadzenNumeric TValue="decimal"
                       @bind-Value="@CarCost.KmPrice"
                       Culture=@AppSettings.CurrentCulture
                       Format="0.00"
                       Class="w-100" 
                       Change=@(a=> this.EditableData?.SetDirty()) />
        </div>
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al Km (Extra)</RadzenText>
            <RadzenNumeric TValue="decimal"
                       @bind-Value="@CarCost.KmPriceExtra"
                       Culture=@AppSettings.CurrentCulture
                       Format="0.00"
                       Class="w-100"
                       Change=@(a=> this.EditableData?.SetDirty()) />
        </div>
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al giorno</RadzenText>
            <RadzenNumeric TValue="decimal"
                       @bind-Value="@CarCost.DayPrice"
                       Culture=@AppSettings.CurrentCulture
                       Format="0.00"
                       Class="w-100" 
                       Change=@(a=> this.EditableData?.SetDirty()) />
        </div>
        <div class="col-3">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Forfait al giorno</RadzenText>
            <RadzenNumeric TValue="decimal?"
                       @bind-Value="@CarCost.DayForfait"
                       Culture=@AppSettings.CurrentCulture
                       Format="0.00"
                       Class="w-100" 
                       Change=@(a=> this.EditableData?.SetDirty()) />
        </div>
        <div class="col-3">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">integrazione al giorno</RadzenText>
            <RadzenNumeric TValue="decimal?"
                       @bind-Value="@CarCost.DayIntegration"
                       Culture=@AppSettings.CurrentCulture
                       Format="0.00"
                       Class="w-100" 
                       Change=@(a=> this.EditableData?.SetDirty()) />
        </div>
    }
    else
    {
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al Km</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDecimal(this.CarCost.KmPrice)</strong></RadzenText>
        </div>
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al Km (Extra)</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDecimal(this.CarCost.KmPriceExtra)</strong></RadzenText>
        </div>
        <div class="col-2">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Costo al giorno</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDecimal(this.CarCost.DayPrice)</strong></RadzenText>
        </div>
        <div class="col-3">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Forfait al giorno</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDecimal(this.CarCost.DayForfait)</strong></RadzenText>
        </div>
        <div class="col-3">
            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">integrazione al giorno</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDecimal(this.CarCost.DayIntegration)</strong></RadzenText>
        </div>
    }
</div>

@code {
    [Parameter]
    public IEditableData? EditableData { get; set; }

    [Parameter]
    public RunItem CurrentRun { get; set; } = new RunItem();
    [Parameter]
    public bool EditMode { get; set; } = false;
    [Parameter]
    public RunPeriod RunPeriod { get; set; } = new RunPeriod();
    [Parameter]
    public RunPeriodCar PeriodCar { get; set; } = new RunPeriodCar();
    [Parameter]
    public RunCarCost CarCost { get; set; } = new RunCarCost();

    protected override async Task OnInitializedAsync()
    {


        await base.OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {

        await base.OnParametersSetAsync();
    }

    private string FormatDecimal (
        decimal? cost)
    {
        if (cost == null) return string.Empty;

        return string.Format(AppSettings.CurrentCulture, "{0:C}", cost);
    }
}
