@page "/runs"
@using CtaLinea.Model.QueryModel;
@inject IAutoLoadDataList<RunItemQueryModel> AutoLoad;
@inject ContextMenuService ContextMenuService
@inject IQueryUtilityService QueryService
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject NotificationService notificationService
@inject IRunRepository RunRepo
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Corse</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Corse" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
         <RadzenStack 
             Orientation="Orientation.Horizontal" 
             Gap="5px" Wrap="FlexWrap.NoWrap"
             JustifyContent="JustifyContent.End" 
             AlignItems="AlignItems.Center" >
            <RadzenButton Text="Ricarica" Click=@ReloadData />
            <RadzenTextBox @bind-Value="AutoLoad.FullTextSearch" Placeholder="Cerca..." Change=@(args => FullText_OnChange(args)) Class="w-100" />
         </RadzenStack>
        
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData" 
                FilterMode="FilterMode.Simple"
                Count="@AutoLoad.RowCount"
                IsLoading=@AutoLoad.isLoading
                LoadData="@AutoLoad.LoadData"
                Data="@this.AutoLoad.Data" TItem="RunItemQueryModel"
                AllowSorting="true"
                AllowFiltering="true"
                AllowColumnResize="true"
                LogicalFilterOperator="LogicalFilterOperator.And"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value=@SelectedRuns
                CellContextMenu="@RowActionCellContextMenu"
                
                ExpandMode="DataGridExpandMode.Single"
                RowRender=@RowRender
                RowExpand=@RowExpand

                Style="height:100%" 
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Density=@Settings.Density
                PageSize=@(Settings?.PageSize ?? 5)
                >
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessuna corsa trovato !</p>
    </EmptyTemplate>
    <Template Context="runItem">
        <RadzenCard >
            <h4>Varianti</h4>
            <RadzenDataGrid 
                IsLoading=@DetailIsLoading
                Data="@this.Details" 
                TItem="RunVariationQueryModel"
                AllowSorting="true"
                AllowColumnResize="true"                
                Density=@Settings.Density
                >
                <Columns>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Id" Title="Id variante" Visible=false />
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="VariationStartDate" Title="Inizio var." FormatString="{0:dd/MM/yyyy}" Width="120px" />
                    
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="LineNumber" Title="Nr. Linea" Width="100px" />
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="RunNumber" Title="Nr. Corsa" Width="100px" />
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="StartTime" Title="Ora inizio" Width="120px" >
                        <Template Context="data">
                            @FormatTime(data?.StartTime)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="EndTime" Title="Ora fine" Width="120px" >
                        <Template Context="data">
                            @FormatTime(data?.EndTime)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Monday" Title="Lunedì" Width="100px">
                        <Template Context="data">
                            @if (data.Monday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Tuesday" Title="Martedì" Width="100px">
                        <Template Context="data">
                            @if (data.Tuesday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Wednesday" Title="Mercoledì" Width="100px">
                        <Template Context="data">
                            @if (data.Wednesday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Thursday" Title="Giovedì" Width="100px">
                        <Template Context="data">
                            @if (data.Thursday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Friday" Title="Venerdì" Width="100px">
                        <Template Context="data">
                            @if (data.Friday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Saturday" Title="Sabato" Width="100px">
                        <Template Context="data">
                            @if (data.Saturday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Sunday" Title="Domenica" Width="100px">
                        <Template Context="data">
                            @if (data.Sunday)
                            {
                                <RadzenIcon Icon="check" />
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Path" Title="Percorso" Width="200px" />
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="RequestedFrequency" Title="Frequenza richiesta" Width="200px" />

                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="Km" Title="Km" Width="100px" />
                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="RequestedCapacity" Title="Capienza richiesta" Width="150px" />

                    <RadzenDataGridColumn TItem="RunVariationQueryModel" Property="VariationNote" Title="Note prima Variante" Width="200px" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Id" Title="Id Servizio" Visible=false />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="ContractRowNumber" Title="Riga Appalto" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Extra" Title="Extra" Width="100px">
            <Template Context="data">
                @if (data.Extra)
                {
                    <RadzenIcon Icon="check"  />
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="StartDate" Title="Inizio" FormatString="{0:dd/MM/yyyy}" Width="180px" FilterValue=@Filter_StartDate>
            <FilterTemplate>
                <DateSelector @bind-Value="Filter_StartDate" AllowClear=true Changed=@StartDate_Changed />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="EndDate" Title="Fine " FormatString="{0:dd/MM/yyyy}" Width="180px" FilterValue=@Filter_EndDate>
            <FilterTemplate>
                <DateSelector @bind-Value="Filter_EndDate" AllowClear=true Changed=@EndDate_Changed />
            </FilterTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedDays" Title="GG Richiesti" Width="100px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="AssociatesDescr" Title="Ditte" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="PrimaryCarsDescr" Title="Mezzi Titolari" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="SpareCarsDescr" Title="Mezzi di riserva" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="CalendarsDescr" Title="Calendari usati" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="PathsDescr" Title="PErcorso (Nodi)" Width="200px" />
        
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="VariationStartDate" Title="Inizio var." FormatString="{0:dd/MM/yyyy}" Width="180px" FilterValue=@Filter_StartDate>
            <FilterTemplate>
                <DateSelector @bind-Value="Filter_VariationStartDate" AllowClear=true Changed=@VariationStartDate_Changed />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="LineNumber" Title="Nr. Linea" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RunNumber" Title="Nr. Corsa" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="StartTime" Title="Ora inizio" Width="120px" FilterOperator="FilterOperator.Equals" FilterValue=@Filter_StartTime_2>
            <FilterTemplate>
                <TimeSelector @bind-Value="Filter_StartTime" AllowClear=true Changed=@StartTime_Changed />
            </FilterTemplate>
            <Template Context="data">
                @FormatTime(data?.StartTime)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="EndTime" Title="Ora fine" Width="120px" FilterOperator="FilterOperator.Equals" FilterValue=@Filter_EndTime_2>
            <FilterTemplate>
                <TimeSelector @bind-Value="Filter_EndTime" AllowClear=true Changed=@EndTime_Changed />
            </FilterTemplate>
            <Template Context="data">
                @FormatTime(data?.EndTime)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Monday" Title="Lunedì" Width="100px" >
            <Template Context="data">
                @if (data.Monday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Tuesday" Title="Martedì" Width="100px" >
            <Template Context="data">
                @if (data.Tuesday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Wednesday" Title="Mercoledì" Width="100px" >
            <Template Context="data">
                @if (data.Wednesday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Thursday" Title="Giovedì" Width="100px" >
            <Template Context="data">
                @if (data.Thursday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Friday" Title="Venerdì" Width="100px" >
            <Template Context="data">
                @if (data.Friday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Saturday" Title="Sabato" Width="100px" >
            <Template Context="data">
                @if (data.Saturday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Sunday" Title="Domenica" Width="100px" >
            <Template Context="data">
                @if (data.Sunday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Path" Title="Percorso" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedFrequency" Title="Frequenza richiesta" Width="200px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Km" Title="Km" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedCapacity" Title="Capienza richiesta" Width="150px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RunNote" Title="Note Generali" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="VariationNote" Title="Note prima Variante" Width="200px" />
    </Columns>
</RadzenDataGrid>

@code {
    private enum RunMenuItems
    {
        Detail,
        Edit,
        Delete
    };

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    RadzenDataGrid<RunItemQueryModel>? grdData;

    IList<RunItemQueryModel> SelectedRuns = new List<RunItemQueryModel> ();

    #region  details
    private bool DetailIsLoading = false;
    private IEnumerable<RunVariationQueryModel>? Details;
    #endregion
    #region filtri
    // ORe di inizioe fine
    private DateTime? Filter_StartTime_2;
    private TimeSpan? Filter_StartTime;
    private void StartTime_Changed (object value)
    {
        DateTime? dt = null;
        if (Filter_StartTime  != null)
        {
            dt = new DateTime(1, 1, 1, Filter_StartTime.Value.Hours, Filter_StartTime.Value.Minutes, Filter_StartTime.Value.Seconds);
        }

        Filter_StartTime_2 = dt;
        this.grdData?.Reload();
    }
    private DateTime? Filter_EndTime_2;
    private TimeSpan? Filter_EndTime;
    private void EndTime_Changed(object value)
    {
        DateTime? dt = null;
        if (Filter_EndTime != null)
        {
            dt = new DateTime(1, 1, 1, Filter_EndTime.Value.Hours, Filter_EndTime.Value.Minutes, Filter_EndTime.Value.Seconds);
        }

        Filter_EndTime_2 = dt;
        this.grdData?.Reload();
    }
    private DateTime? Filter_StartDate;
    private void StartDate_Changed(object value)
    {
        this.grdData?.Reload();
    }
    private DateTime? Filter_EndDate;
    private void EndDate_Changed(object value)
    {
        this.grdData?.Reload();
    }

    private DateTime? Filter_VariationStartDate;
    private void VariationStartDate_Changed(object value)
    {
        this.grdData?.Reload();
    }
    #endregion

    protected override async Task OnInitializedAsync()
    {
        AutoLoad.Initilize(
            Constants.Endpoint_RunList
            );

        await base.OnInitializedAsync();
    }

    void FullText_OnChange(string value)
    {
        this.grdData?.Reload();
    }
    void ReloadData ()
    {
        this.grdData?.Reload();
    }

    private string FormatTime(
        TimeSpan? time)
    {
        if (time == null) return string.Empty;
        var dt = new DateTime(1, 1, 1);
        dt = dt.Add(time.Value);
        return string.Format("{0:HH:mm}", dt);
    }

    private void RowRender(RowRenderEventArgs<RunItemQueryModel> args)
    {
        args.Expandable = args.Data.VariationCount >1;
    }
    private async Task RowExpand(RunItemQueryModel runItem)
    {
        await Task.CompletedTask;
        this.Details = null;
        if (runItem.Id == runItem.Id)
        {
            var t = InvokeAsync(
                async () =>
                {
                    var queryDef = new QueryDefinition();
                    queryDef.EndPoint = string.Format(Constants.Endpoint_RunVariationList_Fmt, runItem.Id);

                    DetailIsLoading = true;

                    queryDef.Page = 0;
                    queryDef.PageSize = 1000000;
                    try
                    {
                        var result = await QueryService.GetListAsync<RunVariationQueryModel>(
                            queryDef);

                        if (result != null)
                        {
                            this.Details = result.Items;
                        }
                    }
                    finally
                    {
                        DetailIsLoading = false;
                        this.StateHasChanged();
                    }
                });
        }
    }

    private async Task DeleteRunAsync (
        Guid runId)
    {
        // chiede conferma e poi procede con la cancellazione
        var title = "Eliminazione Corsa";
        if (await this.DialogService.Confirm(
            "Desideri veramente eliminare la corsa selezionata ? Tutti i dati ad essa associati verranno eliminati.",
            title,
            new ConfirmOptions
            {
                OkButtonText = "Si, Elimina !",
                CancelButtonText = "Annulla"
            }) == true )
        {
            try
            {
                await RunRepo.DeleteRunAsync(runId);
                if (this.grdData != null)
                {
                    await this.grdData.Reload();
                }
            }
            catch (Exception exc)
            {
                notificationService.Notify(
                    NotificationSeverity.Error,
                    "Eliminazione Falita",
                    exc.Message
                );
            }
        }
    }

    private void RowActionCellContextMenu(DataGridCellMouseEventArgs<RunItemQueryModel> args)
    {
        SelectedRuns = new List<RunItemQueryModel>() { args.Data };

        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Click=@((e)=>OnMenuItemClick(args, e)) >
                <RadzenMenuItem Text="Mostra i dettagli" Value=@RunMenuItems.Detail />
                <RadzenMenuItem Text="Modifica..." Value=@RunMenuItems.Edit />
                <hr class="separator">
                <RadzenMenuItem Text="Elimina..." Value=@RunMenuItems.Delete />
        </RadzenMenu>
    );
    }

    private async Task OnMenuItemClick (
        DataGridCellMouseEventArgs<RunItemQueryModel> args,
        MenuItemEventArgs e
        )
    {
        await Task.CompletedTask;
        ContextMenuService.Close();

        switch ((RunMenuItems)e.Value)
        {
            case RunMenuItems.Detail:
                await DialogService.OpenSideAsync<RunItemDetail>($"Dettaglio della Corsa",
                    new Dictionary<string, object>() { { "Id", args.Data.Id } },
                    options: new SideDialogOptions() { CloseDialogOnOverlayClick = true, Width = "88%" }
                    );
                break;
            case RunMenuItems.Edit:
                NavigationManager.NavigateTo(
                    string.Format("/run-edit/{0}", args.Data.Id)
                    );
                break;
            case RunMenuItems.Delete:
                await this.DeleteRunAsync(args.Data.Id);
                break;

            default:
                break;
        };
    }
}