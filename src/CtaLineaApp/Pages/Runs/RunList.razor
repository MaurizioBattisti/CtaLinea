@page "/runs"
@using CtaLinea.Model.QueryModel;
@inject IQueryUtilityService queryService
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Corse</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Corse" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
        <RadzenTextBox @bind-Value="FullTextSearch" Placeholder="Cerca..." Change=@(args => FullText_OnChange(args)) Class="w-100" />
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData" 
                FilterMode="FilterMode.Simple"
                Count="@RowCount"
                IsLoading=@isLoading
                LoadData="@LoadData"
                Data="@this.Data" TItem="RunItemQueryModel"
                PageSize="50"
                AllowSorting="true"
                AllowFiltering="true"
                AllowColumnResize="true"
                LogicalFilterOperator="LogicalFilterOperator.And"
                AllowVirtualization="true"
                Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Style="height:100%" SelectionMode="DataGridSelectionMode.Single"
                @bind-Value=@SelectedRuns
                >
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessuna corsa trovato !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Id" Title="Id Servizio" Visible=false />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="ContractRowNumber" Title="Riga Appalto" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Extra" Title="Extra" Width="100px">
            <Template Context="data">
                @if (data.Extra)
                {
                    <RadzenIcon Icon="check"  />
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="StartDate" Title="Inizio" FormatString="{0:dd/MM/yyyy}" Width="180px" FilterValue=@Filter_StartDate>
            <FilterTemplate>
                <DateSelector @bind-Value="Filter_StartDate" AllowClear=true Changed=@StartDate_Changed />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="EndDate" Title="Fine " FormatString="{0:dd/MM/yyyy}" Width="180px" FilterValue=@Filter_EndDate>
            <FilterTemplate>
                <DateSelector @bind-Value="Filter_EndDate" AllowClear=true Changed=@EndDate_Changed />
            </FilterTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedDays" Title="GG Richiesti" Width="100px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="AssociatesDescr" Title="Ditte" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="PrimaryCarsDescr" Title="Mezzi Titolari" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="SpareCarsDescr" Title="Mezzi di riserva" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="CalendarsDescr" Title="Calendari usati" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="PathsDescr" Title="PErcorsi" Width="200px" />
        
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="LineNumber" Title="Nr. Linea" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RunNumber" Title="Nr. Corsa" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="StartTime" Title="Ora inizio" Width="120px" FilterOperator="FilterOperator.Equals" FilterValue=@Filter_StartTime_2>
            <FilterTemplate>
                <TimeSelector @bind-Value="Filter_StartTime" AllowClear=true Changed=@StartTime_Changed />
            </FilterTemplate>
            <Template Context="data">
                @FormatTime(data?.StartTime)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="EndTime" Title="Ora fine" Width="120px" FilterOperator="FilterOperator.Equals" FilterValue=@Filter_EndTime_2>
            <FilterTemplate>
                <TimeSelector @bind-Value="Filter_EndTime" AllowClear=true Changed=@EndTime_Changed />
            </FilterTemplate>
            <Template Context="data">
                @FormatTime(data?.EndTime)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Monday" Title="Lunedì" Width="100px" >
            <Template Context="data">
                @if (data.Monday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Tuesday" Title="Martedì" Width="100px" >
            <Template Context="data">
                @if (data.Tuesday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Wednesday" Title="Mercoledì" Width="100px" >
            <Template Context="data">
                @if (data.Wednesday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Thursday" Title="Giovedì" Width="100px" >
            <Template Context="data">
                @if (data.Thursday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Friday" Title="Venerdì" Width="100px" >
            <Template Context="data">
                @if (data.Friday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Saturday" Title="Sabato" Width="100px" >
            <Template Context="data">
                @if (data.Saturday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Sunday" Title="Domenica" Width="100px" >
            <Template Context="data">
                @if (data.Sunday)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedFrequency" Title="Frequenza richiesta" Width="200px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="Km" Title="Km" Width="100px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RequestedCapacity" Title="Capienza richiesta" Width="150px" />

        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="RunNote" Title="Note Generali" Width="200px" />
        <RadzenDataGridColumn TItem="RunItemQueryModel" Property="VariationNote" Title="Note prima Variante" Width="200px" />
    </Columns>
</RadzenDataGrid>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    RadzenDataGrid<RunItemQueryModel>? grdData;

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    RunItemQueryModel[]? Data = null;
    int RowCount = 0;
    bool isLoading = false;
    string FullTextSearch = string.Empty;

    IList<RunItemQueryModel> SelectedRuns = new List<RunItemQueryModel> ();

    #region filtri
    // ORe di inizioe fine
    private DateTime? Filter_StartTime_2;
    private TimeSpan? Filter_StartTime;
    private void StartTime_Changed (object value)
    {
        DateTime? dt = null;
        if (Filter_StartTime  != null)
        {
            dt = new DateTime(1, 1, 1, Filter_StartTime.Value.Hours, Filter_StartTime.Value.Minutes, Filter_StartTime.Value.Seconds);
        }

        Filter_StartTime_2 = dt;
        this.grdData?.Reload();
    }
    private DateTime? Filter_EndTime_2;
    private TimeSpan? Filter_EndTime;
    private void EndTime_Changed(object value)
    {
        DateTime? dt = null;
        if (Filter_EndTime != null)
        {
            dt = new DateTime(1, 1, 1, Filter_EndTime.Value.Hours, Filter_EndTime.Value.Minutes, Filter_EndTime.Value.Seconds);
        }

        Filter_EndTime_2 = dt;
        this.grdData?.Reload();
    }
    private DateTime? Filter_StartDate;
    private void StartDate_Changed(object value)
    {
        this.grdData?.Reload();
    }
    private DateTime? Filter_EndDate;
    private void EndDate_Changed(object value)
    {
        this.grdData?.Reload();
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        this._servicesQueryDef.EndPoint = Constants.Endpoint_RunList;
        await base.OnInitializedAsync();
    }

    void FullText_OnChange(string value)
    {
        this.grdData?.Reload();
    }

    private string FormatTime(
        TimeSpan? time)
    {
        if (time == null) return string.Empty;
        var dt = new DateTime(1, 1, 1);
        dt = dt.Add(time.Value);
        return string.Format("{0:HH:mm}", dt);
    }

    private async Task LoadData(LoadDataArgs args)
    {
        this.isLoading = true;
        this.StateHasChanged();

        this._servicesQueryDef.Filter = args.GetQueryFilter<RunItemQueryModel>();
        this._servicesQueryDef.Sort = args.GetQuerySort(nameof(RunItemQueryModel.Id));
        this._servicesQueryDef.FullText = this.FullTextSearch;

        this._servicesQueryDef.Page = args.GetQueryPage();
        this._servicesQueryDef.PageSize = args.GetQueryPageSize();

        try
        {
            var result = await queryService.GetListAsync<RunItemQueryModel>(
                        this._servicesQueryDef);

            if (result != null)
            {
                this.Data = result.Items;
                this.RowCount = result.TotalRows;
            }
        }
        finally
        {
            this.isLoading = false;
            this.StateHasChanged();
        }
    }
}
