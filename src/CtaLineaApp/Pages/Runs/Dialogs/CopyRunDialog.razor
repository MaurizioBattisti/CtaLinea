@using CtaLinea.Model.Request;
@inject NotificationService _notificationService
@inject IRunRepository _runRepo;
@inject IRunModelService RunModelService

<RadzenStack Orientation="Orientation.Vertical">
	<RadzenRow>
		<RadzenColumn Size="8">
			<RadzenFieldset Text="Dati corsa" class="w-100" >
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenColumn Size="3">
						<RadzenLabel Component="LineNumber" Text="Nr. Linea" />
					</RadzenColumn>
					<RadzenColumn Size="3">
						<RadzenNumeric Name="LineNumber" TValue="int?" @bind-Value=@CopyRequest.LineNumber />
					</RadzenColumn>
					<RadzenColumn Size="3">
						<RadzenLabel Component="RunNumber" Text="Nr. Corsa" />
					</RadzenColumn>
					<RadzenColumn Size="3">
						<RadzenTextBox Name="RunNumber" @bind-Value=@CopyRequest.RunNumber Class="w-100"  />
					</RadzenColumn>
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenColumn Size="3">
						<RadzenLabel Component="RunName" Text="Nome corsa" />
					</RadzenColumn>
					<RadzenColumn Size="9">
						<RadzenTextBox Name="RunName" @bind-Value="CopyRequest.RunName" class="w-100" />
					</RadzenColumn>
				</RadzenRow>

				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenColumn Size="3">
						<RadzenLabel Component="StartTime" Text="Ora di inizio" />
					</RadzenColumn>
					<RadzenColumn Size="3">
						<TimeSelector 
							Name="StartTime" 
							@bind-Value="CopyRequest.StartTime" 
							AllowClear=true />
					</RadzenColumn>
				</RadzenRow>

				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenColumn Size="3">
						<RadzenLabel Component="Path" Text="Percorso" />
					</RadzenColumn>
					<RadzenColumn Size="9">
						<RadzenTextArea Name="Path" @bind-Value="CopyRequest.Path" class="w-100" />
					</RadzenColumn>
				</RadzenRow>
			</RadzenFieldset>
		</RadzenColumn>

		<RadzenColumn Size="4">
			<RadzenFieldset Text="Opzioni" class="w-100" >
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.InvertNodes Name="InvertNodes" TValue="bool"  />
					<RadzenLabel Text="Inverti ordine nodi (ritorno)" Component="InvertNodes" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_Replacements Name="Inc_Replacements" TValue="bool" />
					<RadzenLabel Text="Includi mezzi sostitutivi" Component="Inc_Replacements" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_Suspensions Name="Inc_Suspensions" TValue="bool" />
					<RadzenLabel Text="Includi sospensioni di servizio" Component="Inc_Suspensions" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_AdditionalDays Name="Inc_AdditionalDays" TValue="bool" />
					<RadzenLabel Text="Includi giorni addizionali" Component="Inc_AdditionalDays" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_Tabs Name="Inc_Tabs" TValue="bool" />
					<RadzenLabel Text="Includi etichette associate alla corsa" Component="Inc_Tabs" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_Forfaits Name="Inc_Forfaits" TValue="bool" />
					<RadzenLabel Text="Assegna lo stesso forfati multi-corsa" Component="Inc_Forfaits" Style="vertical-align: middle;" />
				</RadzenRow>
				<RadzenRow AlignItems="AlignItems.Center">
					<RadzenCheckBox @bind-Value=@this.CopyRequest.Inc_InternalNotes Name="Inc_InternalNotes " TValue="bool" />
					<RadzenLabel Text="Copia anche le note interne" Component="Inc_InternalNotes " Style="vertical-align: middle;" />
				</RadzenRow>
			</RadzenFieldset>
		</RadzenColumn>

	</RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
		<RadzenButton Click="@(() => this.CreateCopyAsync(ds))"
					  ButtonStyle="ButtonStyle.Primary"
					  Text="Crea Copia" />
		<RadzenButton Click="@(() => ds.Close(null))"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter]
	public DialogService ds { get; set; }

	[Parameter]
	public RunItemQueryModel RunData { get; set; } = new RunItemQueryModel();

	public bool IsBusy { get; set; } = false;
	private CreateRunCopyRequest CopyRequest = new CreateRunCopyRequest();

	protected override void OnInitialized()
	{
		base.OnInitialized();
	}
	protected override void OnParametersSet()
	{
		this.CopyRequest.RunId = this.RunData.Id;

		this.CopyRequest.LineNumber = this.RunData.LineNumber;
		this.CopyRequest.RunNumber = this.RunData.RunNumber;
		this.CopyRequest.RunName = this.RunData.RunName;
		this.CopyRequest.Path = this.RunData.Path;
		this.CopyRequest.StartTime = this.RunData.StartTime;

		base.OnParametersSet();
	}

	private async Task CreateCopyAsync(DialogService ds)
	{
		this.IsBusy = true;

		try
		{
			var result = await _runRepo.CreateRunCopyAsync(
				this.CopyRequest);

			if (result != null
				&& result.Success == true)
			{
				_notificationService.Notify(
					NotificationSeverity.Success,
					"Corsa copiata con successo");
				this.IsBusy = false;
				ds.Close(result.Data);
			}
			else if (result != null
				&& result.Success == false)
			{
				_notificationService.Notify(
					NotificationSeverity.Warning,
					"Qualcosa non ha funzionato",
					result.Message);
			}
			else
			{
				_notificationService.Notify(
					NotificationSeverity.Warning,
					"Qualcosa non ha funzionato");
			}
		}
		catch (Exception exc)
		{
			_notificationService.Notify(
				NotificationSeverity.Error,
				"Errore copiando la corsa",
				exc.Message);
		}
		finally
		{
			this.IsBusy = false;
		}
	}
}
