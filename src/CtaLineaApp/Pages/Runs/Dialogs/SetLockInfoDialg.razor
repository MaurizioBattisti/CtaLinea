@using CtaLinea.Model.External;
@inject IAutoLoadDataList<CollectionPointQueryItem> AutoLoad;

<RadzenStack Orientation="Orientation.Vertical">
	<RadzenRow>
		<RadzenColumn Size="4">
			<RadzenLabel Component="Date" Text="Data" />
		</RadzenColumn>
		<RadzenColumn Size="8">
			<DateSelectorNotNull @bind-Value=@LockInfo.Date
				Name="Date" />
		</RadzenColumn>
	</RadzenRow>	
	<RadzenRow>
		<RadzenColumn Size="4">
			<RadzenLabel Component="Note" Text="Note" />
		</RadzenColumn>
		<RadzenColumn Size="8">
			<RadzenTextArea Name="Note"
				@bind-Value=@LockInfo.Note
				class="w-100"
				Style="height: 50px"
				/>
		</RadzenColumn>
	</RadzenRow>

	<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
		<RadzenButton Click="@(() => this.SetForfait(ds))"
					  ButtonStyle="ButtonStyle.Primary"
					  Text="Imposta" />
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</RadzenStack>
</RadzenStack>

@code {
	private int? ContractId;

	[CascadingParameter]
	CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

	[Parameter]
	public DialogService? ds { get; set; }

	[Parameter]
	public LockInfo LockInfo { get; set; } = new LockInfo();

	protected override void OnInitialized()
	{
		this.ContractId = GlobalFilters?.Contract?.Id;
		base.OnInitialized();
	}

	private void SetForfait (DialogService ds)
	{
		ds.Close(this.LockInfo);
	}
}
