@using CtaLinea.Model.Filters;
@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Vertical">
	<RadzenRow>
		<RadzenColumn Size="8">
			<AssociateAndCarDropDown @bind-AssociateId="Filters.AssociateId"
										@bind-CarId="Filters.CarId"
										Inline=true
										AllowClear=true />
		</RadzenColumn>
		<RadzenColumn Size="1">
			<RadzenText TextStyle="TextStyle.Overline" Text="Da posti" />
			<RadzenNumeric TValue="int?"
							@bind-Value="Filters.MinSittings"
							Format="0"
							Class="w-100" />
		</RadzenColumn>
		<RadzenColumn Size="1">
			<RadzenText TextStyle="TextStyle.Overline" Text="a posti" />
			<RadzenNumeric TValue="int?"
							@bind-Value="Filters.MaxSittings"
							Format="0"
							Class="w-100" />

		</RadzenColumn>
		<RadzenColumn Size="1">
			<RadzenText TextStyle="TextStyle.Overline" Text="Nr. Linea" />
			<RadzenNumeric TValue="int?"
							@bind-Value="Filters.LineNumber"
							Format="0"
							Class="w-100" />
		</RadzenColumn>
		<RadzenColumn Size="1">
			<RadzenText TextStyle="TextStyle.Overline" Text="Mr. Corsa" />
			<RadzenTextBox @bind-Value="Filters.RunNumber"
							Class="w-100" />
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenColumn Size="5">
			<RadzenText TextStyle="TextStyle.Overline" Text="Fermata (codice o testo)" />
			<RadzenTextBox @bind-Value="Filters.Node"
				Class="w-100" />
		</RadzenColumn>
		<RadzenColumn Size="1">
			<CollectionPointSelector @bind-Id="Filters.CollectionPointId" />
		</RadzenColumn>
		<RadzenColumn Size="3">
			<DateRangeSelector 
				@bind-StartDate="Filters.StartDate"
				@bind-EndDate="Filters.EndDate"
				AllowClear=true
				Inline=true/>
		</RadzenColumn>
		<RadzenColumn Size="3">
			<TimeRangeSelector 
				@bind-StartTime="Filters.StartTime"
				@bind-EndTime="Filters.EndTime"
				Inline=true/>
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenColumn Size="4">
			<RadzenText TextStyle="TextStyle.Overline" Text="Frequenza" />
			<RadzenTextBox @bind-Value="Filters.Frequency"
							Class="w-100" />
		</RadzenColumn>
		<RadzenColumn Size="4">
			<RadzenText TextStyle="TextStyle.Overline" Text="Calendari (uno qualsiasi)" />
			<CalendarMultiSelect AllowClear=true
				@bind-CalendarIds="Filters.CalendarIds" 
				/>
		</RadzenColumn>
		<RadzenColumn Size="4">
			<RadzenText TextStyle="TextStyle.Overline" Text="Giorni della settimana (uno qualsiasi)" />
			<WeekDaysSelector AllowClear=true
				@bind-WeekDays="Filters.WeekDays"
				/>
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenColumn Size="2">
			<RadzenText TextStyle="TextStyle.Overline" Text="Tipo capitolato/Extra" />
			<RadzenDropDown @bind-Value="Filters.InContract"
							AllowClear="true"
							TValue="int?"
							Class="w-100"
							Data=@InContractList
							ValueProperty="Key"
							TextProperty="Value" />
		</RadzenColumn>
		<RadzenColumn Size="2">
			<RadzenText TextStyle="TextStyle.Overline" Text="Stato Attiva" />
			<RadzenDropDown @bind-Value="Filters.ActiveRun"
							AllowClear="true"
							TValue="int?"
							Class="w-100"
							Data=@ActiveStatusList
							ValueProperty="Key"
							TextProperty="Value" />
		</RadzenColumn>
		<RadzenColumn Size="2">
			<RadzenText TextStyle="TextStyle.Overline" Text="Data Riferimento" />
			<DateSelector AllowClear=true
							@bind-Value="Filters.DateRef" />
		</RadzenColumn>
		<RadzenColumn Size="3">
			<RadzenText TextStyle="TextStyle.Overline" Text="Forfait" />
			<MultiRunForfaitSelector AllowClear=true
									 @bind-ForfaitId="Filters.ForfaitId"
									 ContractId=@ContractId />
		</RadzenColumn>
		<RadzenColumn Size="3">
			<RadzenText TextStyle="TextStyle.Overline" Text="Etichette (una qualsiasi)" />
			<TagMultiSelector AllowClear=true
				@bind-TagIds="Filters.TabIds"/>
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenButton Text="Filtra !"
						Click=@Filter_Click />
	</RadzenRow>
</RadzenStack>

<CtaLineaGlobalFiltersManager 
	Changed="@GlobalFilterChanged" />

@code {
	private int? ContractId;

	[CascadingParameter]
	CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

	[Parameter]
	public RunAdvancedFilters Filters { get; set; } = new RunAdvancedFilters();

	protected override void OnInitialized()
	{
		this.ContractId = GlobalFilters?.Contract?.Id;
		base.OnInitialized();
	}

	private IEnumerable<KeyValuePair<int, string>> InContractList = new List<KeyValuePair<int, string>>() 
	{
		new KeyValuePair<int, string>(1, "Capitolato"),
		new KeyValuePair<int, string>(2, "Extra Capitolato")
		/*
		,
		new KeyValuePair<int, string>(3, "Parzialmente Extra captiolato")
		*/
	};
	private IEnumerable<KeyValuePair<int, string>> ActiveStatusList = new List<KeyValuePair<int, string>>()
	{
		new KeyValuePair<int, string>(1, "Attiva"),
		new KeyValuePair<int, string>(2, "Terminata"),
		new KeyValuePair<int, string>(3, "Non ancora avviata")
	};

	private void Filter_Click ()
	{
		this.DialogService.CloseSide(true);
	}

	private async Task GlobalFilterChanged()
	{
		this.ContractId = GlobalFilters?.Contract?.Id;
		this.StateHasChanged();

		await Task.CompletedTask;
	}

	private async Task SelectNodeFromList_Click ()
	{
		this.DialogService.CloseSide(false);

		var data =await this.DialogService.OpenAsync(
			"Seleziona Fermata",
			ds => @<NodeSelectDialog ds=@ds />
			, new DialogOptions()
			{
				ShowClose = true,
				CloseDialogOnEsc = true,
				CloseDialogOnOverlayClick = true,

				Width = "1000px",
				Draggable = false
			}
		);

		if (data != null)
		{
			this.Filters.CollectionPointId = (string)data;
		}
	}
}
