    private async Task RealodOneRowAsync (Guid runId)
    {
        try
        {
            this.IsLoading = true;

            // ricarica la riga della griglia e  la rimette nel posto giusto
            var newItem = await this.RunRepo.GetOneDetailAsync(runId);
            var oldItem = this.Data?.Where(x => x.Id == runId).SingleOrDefault();
            if (newItem != null
                && oldItem != null)
            {
                // aggiorna i dati
                oldItem.CopyFrom(newItem);
                this.grdData?.UpdateRow(oldItem);
                // aggiorna il reiferimento della nuova riga
                newItem = oldItem;
            }
            else if (newItem != null)
            {
                // se la riga nuova non è presente  nela lista la ggige
                if (this.Data == null) this.Data = new List<RunItemQueryModel>() { newItem };
                else
                {
                    this.Data.Add(newItem);
                }
            }

            if (newItem != null
                && this.grdData != null)
            {
                await this.grdData.Reload();
                await this.grdData.SelectRow(newItem);
            }
        }
        catch (Exception exc)
        {
            this.notificationService.Notify(NotificationSeverity.Warning, "errore durante l'aggiornamento della lista", exc.Message);
        }
        finally
        {
            this.IsLoading = false;
        }        
    }

