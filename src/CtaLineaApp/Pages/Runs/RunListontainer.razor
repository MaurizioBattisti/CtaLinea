    private void RowActionCellContextMenu(DataGridCellMouseEventArgs<RunItemQueryModel> args)
    {
        if (grdData != null)
        {
            this.grdData.SelectRow(args.Data);
        }
        if (this.IsClean == false) return ;
        if (this.CanEdit() == false) return;

        // controlla se ci sono selezioni multiple
        var multiSel = this.MultiSelectedRuns.Count > 0;

        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Click=@((e)=>OnMenuItemClick(args, e))>
                @if (CanManage())
                {
                    <RadzenMenuItem Icon="local_offer" Text="Etichette..." Value=@RunMenuItems.Tags />
                    <RadzenMenuItem Icon="savings" Text=@(args.Data.ForfaitId == null ? "Aggiungi Forfait..." : "Elimina forfait..." ) Value="@RunMenuItems.Forfait" />
                    <RadzenMenuItem Icon="feedback" Text="Note interne..." Value=@RunMenuItems.InternalNote />
                    <hr class="separator">
                    <RadzenMenuItem Icon="file_copy" Text="Crea Copia ..." Value="@RunMenuItems.CreateCopy" />
                    <hr class="separator">
                }
                @if(CanEdit()
                    && multiSel == true)
                {
                    <RadzenMenuItem Icon="block" Text="Sospensione Multi corsa..." Value=@RunMenuItems.MultiRun_SetSuspension />
                    <RadzenMenuItem Icon="savings" Text="Forfait Multi corsa..." Value=@RunMenuItems.MultiRun_SetForfait />
                    <hr class="separator">
                }
                <RadzenMenuItem Icon="delete" Text="Elimina..." Value=@RunMenuItems.Delete />
            </RadzenMenu>
        );
    }

    private async Task OnMenuItemClick(
        DataGridCellMouseEventArgs<RunItemQueryModel> args,
        MenuItemEventArgs e
        )
    {
        await Task.CompletedTask;
        ContextMenuService.Close();

        if (this.IsClean == false) return ;

        switch ((RunMenuItems)e.Value)
        {
            case RunMenuItems.Delete:
                await this.DeleteRunAsync(args.Data.Id);
                break;
            case RunMenuItems.Tags:
                await this.ShowTagsEditor(args.Data.Id);
                break;
            case RunMenuItems.CreateCopy:
                await this.CopyRunAsync(args.Data);
                break;
            case RunMenuItems.Forfait:
                if (args.Data.ForfaitId == null)
                {
                    await this.SetForfaitAsync(args.Data.Id);
                }
                else
                {
                    await this.RemoveForfaitAsync(args.Data.Id);
                }
                break;

            case RunMenuItems.MultiRun_SetSuspension:
                await this.MultiRunSetSuspensionAsync();
                break;
            case RunMenuItems.MultiRun_SetForfait:
                await this.MultiRunSetForfaitAsync();
                break;
            case RunMenuItems.InternalNote:
                await this.ShowInternalNoteDialogAsync(args.Data.Id);
                break;

            default:
                break;
        };
    }

    private async Task MultiRunSetSuspensionAsync ()
    {
        // usa il miultirun seleciont come sorgente
        var ids = this.MultiSelectedRuns.Select(r => r.Id);

        // chiede le informazioni per le sospensioni
		var result = await DialogService.OpenAsync(
			"Aggiungi Sospensioni",
            ds => @<MultiRunSetSuspensionDialog ds=@ds Ids="@ids" />
			, new DialogOptions()
			{
				ShowClose = true,
				CloseDialogOnEsc = true,
				CloseDialogOnOverlayClick = true,

				Width = "600px",
				Draggable = false
			}
		);

        if (result == true)
        {
            // se la dialog viene confermata ricaricat i dati
            await this.LoadDataASync();
            this.MultiSelectedRuns = this.Data.Where(d => ids.Contains(d.Id)).ToList();
        }
    }
    private async Task MultiRunSetForfaitAsync()
    {
        //  usa il miultirun seleciont come sorgente
        var ids = this.MultiSelectedRuns.Select(r => r.Id);

        // mostra la dialog per richiedere un forfait
        var forfaitId = await DialogService.OpenAsync<AssignForfaitDialog>($"Assegnazione Forfait",
            new Dictionary<string, object>() { { "ds", this.DialogService } },
            options: new DialogOptions()
                {
                    CloseDialogOnOverlayClick = false,
                    Width = "300px"
                });

        if (forfaitId != null)
        {
            // assegna il forfait
            try
            {
                await ForfaitService.SetDetails(
                    forfaitId, ids
                    );

                // se la dialog viene confermata ricaricat i dati
                await this.LoadDataASync();
                this.MultiSelectedRuns = this.Data.Where(d => ids.Contains(d.Id)).ToList();
            }
            catch (Exception exc)
            {
                this.notificationService.Notify(NotificationSeverity.Error, "Errore durante l'assegnaizoen del forfait. ", exc.Message);
            }
        }
    }

