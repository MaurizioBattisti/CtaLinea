    private async Task SetForfaitAsync (Guid runId)
    {
        // recupera il forfait attuale dalla lista
        var run = this.Data.Where(x => x.Id == runId).SingleOrDefault();
        if (run != null)
        {
            int? oldForfaitId = run.ForfaitId;
            var forfaitId = await DialogService.OpenAsync<AssignForfaitDialog>($"Assegnazione Forfait",
                new Dictionary<string, object>() { { "ForfaitId", oldForfaitId }, { "ds", this.DialogService } },
                options: new DialogOptions()
                    {
                        CloseDialogOnOverlayClick = false,
                        Width = "300px"
                    });

            if (forfaitId != null)
            {
                // assegna il forfait
                try
                {
                    await ForfaitService.SetDetails(
                        forfaitId, new List<Guid>() { runId }
                        );

                    // ricarica al riga attuale
                    await this.RealodOneRowAsync (runId);
                }
                catch (Exception exc)
                {
                    this.notificationService.Notify(NotificationSeverity.Error, "Errore durante l'assegnaizoen del forfait. ", exc.Message);
                }
            }
        }
    }
    private async Task RemoveForfaitAsync(Guid runId)
    {
        // chiede conferma per l'eliminaizone del forfait
        var result = await this.DialogService.Confirm(
            "Desideri verametne eliminare il forfait dalla corsa ?",
            "eliminazione forfait",
            new ConfirmOptions()
                {
                    OkButtonText = "Si, Elimina !",
                    CancelButtonText = "No ! Annulla"
                }
        );

        if (result == true)
        {
            // elimina il forfait
            try
            {
                await ForfaitService.SetDetails(
                    null, new List<Guid>() { runId }
                    );

                // ricarica al riga attuale
                await this.RealodOneRowAsync(runId);
            }
            catch (Exception exc)
            {
                this.notificationService.Notify(NotificationSeverity.Error, "Errore durante l'assegnaizoen del forfait. ", exc.Message);

            }
        }
    }

