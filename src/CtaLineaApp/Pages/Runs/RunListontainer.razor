    private async Task SelectionChanged(IList<RunItemQueryModel> list)
    {
        if (this.IsClean == false)
        {
            var result = await this.AskForExitAsync();
            if (result == true)
            {
                this.IsClean = true;
            }
            else
            {
                return;
            }
        }

        // seleziona la riga se può
        this.SelectedRuns = new List<RunItemQueryModel>(list);

        // imposta il valore dell'id da modoificare
        if (this.SelectedRuns.Count > 0)
        {
            this.EditArgs = new RunEditArguments()
            {
                RunId = this.SelectedRuns.Select(x => x.Id).First()
            };
            if (this.RunEditDetail != null)
            {
                EditorVisible = true;
                await this.RunEditDetail.LoadDataAsync(this.EditArgs.RunId, this.EditArgs.IsAdding);
            }
        }
        else
        {
            this.EditArgs =null;
        }
    }
