    private string GetEditorStyle()
    {
        if (this.EditorVisible == true)
        {
            return Constants.OpenedEditorStype;
        }
        return Constants.ClosedEditorStype;
    }
    private async Task Editor_Closed()
    {
        await Task.CompletedTask;
        this.EditorVisible = false;
    }

    private bool CanEdit ()
    {
        return this._accountService?.IsUserInRoles(
            new List<string>()
                {
                UserRoles.Role_Edit,
                UserRoles.Role_Manage
                }) ?? false;
    }
    private bool CanManage()
    {
        return this._accountService?.IsUserInRole( UserRoles.Role_Manage)?? false;
    }

    private async Task GlobalFilterChanged ()
    {
        await LoadDataASync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataASync();

        await base.OnInitializedAsync();
    }

    private async Task DownloadData_Click(RadzenSplitButtonItem item)
    {
        this.IsLoading = true;
        // var columninfo = this.grdData?.GetExportColumnInfo();
        var columninfo = this.Data.GetExportColumnInfo();

        try
        {
            string title = "Elenco Corse";
            if (item == null)
            {
                await this.ExcelService.Export(title, this.Data, columninfo);
            }
            else
            {
                switch (item.Value)
                {
                    case "X":
                        await this.ExcelService.ExportExcel(title, this.Data, columninfo);
                        break;
                    case "C":
                        await this.ExcelService.ExportCsv(title, this.Data, columninfo);
                        break;
                }
            }
            this.notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Errori esportando i dati",
                ex.Message);
        }
        finally
        {
            this.IsLoading = false;
        }
    }

    private async Task LoadDataASync()
    {
        if (this.GlobalFilters.IsFilterSet() == false) return;

        if (this.RunEditDetail != null)
        {
            if (await this.RunEditDetail.CloseEditorAsync() == false)
            {
                return;
            }
        }

        // aggiorna il filtro avanzato con i filtri generali
        this.AdvancedFilter4s.ContractId = this.GlobalFilters.Contract?.Id;
        this.AdvancedFilter4s.StartPeriod = this.GlobalFilters.Period?.StartDate;
        this.AdvancedFilter4s.EndPeriod = this.GlobalFilters.Period?.EndDate;

        var queryDef = new QueryDefinition();
        queryDef.EndPoint = Constants.Endpoint_RunList_Adv;

        this.IsLoading = true;
        queryDef.FullText = this.FullTextSearch; ;

        queryDef.Page = 1;
        queryDef.PageSize = 100000;
        queryDef.Count = false;

        try
        {
            var result = await QueryService.GetListAsync<RunItemQueryModel>(
                queryDef, true, this.AdvancedFilter4s);

            if (result != null)
            {
                Data = result.Items.ToList();
                ItemCount = Data.Count();
            }
        }
        finally
        {
            this.IsLoading = false;
        }
    }

    private async Task FullText_OnChange(string value)
    {
        await this.LoadDataASync();
    }
    private async Task ReloadData()
    {
        await this.LoadDataASync();
        // this.grdData?.Reload();
    }

    private string GetRunStatusStyleClass (int runStatus)
    {
        switch (runStatus)
        {
            case 1:
                return "rz-background-color-danger-darker";
            case 2:
                return "rz-background-color-warning-darker";
            case 100:
                return "rz-background-color-info-darker";
            default:
                return string.Empty;
        }
    }
    private string GetAssociateDescrStyle (RunItemQueryModel item)
    {
        if (item.IsAssociateNotPrimary())
        {
            // return "rz-background-color-primary-lighter";
            return "rz-background-color-series-4";
        }
        return string.Empty;
    }

    private string FormatTime(
        TimeSpan? time)
    {
        if (time == null) return string.Empty;
        var to = new TimeOnly(time.Value.Hours, time.Value.Minutes, time.Value.Minutes);
        return string.Format(this.AppSettings.CurrentCulture, "{0:HH:mm}", to);
    }

