@inject IRunService RunService

<RadzenTabs 
	Change=@OnTabChange 
	TabPosition="TabPosition.Top" 
	Class="w-100 my-1 mx-auto" 
	RenderMode="TabRenderMode.Client" >
	<Tabs>
@foreach(var p in this.SubPeriods)
{
		<RadzenTabsItem Text="@p.GetWeekDaysDescr()">
			<RadzenLabel Text="Mezzi titolari e scorte" />
			@foreach (var c in this.GetPeriodCars(p))
			{
				<RunCarDetailView CurrentRun=@CurrentRun EditMode=@EditMode RunPeriod=@p Model=@c />
			}
			@if(this.HasReplacements(p))
			{
				<RadzenLabel Text="Sostituzioni" />
				<RadzenAccordion 
					Multiple="true" >
					<Items>
					@foreach(var r in this.GetReplacementList(p))
					{
						<RadzenAccordionItem Text="@this.GetReplacementDescriotion(r)" Icon="find_replace" Selected=false>
							<CarReplacementItemView CurrentRun=@CurrentRun EditMode=@EditMode SubPeriod=@p Replacement=@r />
						</RadzenAccordionItem>
					}
					</Items>
				</RadzenAccordion>
			}
		</RadzenTabsItem>
}
	</Tabs>
</RadzenTabs>

@code {
	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public bool EditMode { get; set; } = false;
	[Parameter]
	public RunPeriodGroup PeriodGroup { get; set; } = new RunPeriodGroup();

	IList<RunPeriod> SubPeriods = new List<RunPeriod>();

	protected override async Task OnInitializedAsync()
	{

		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// recupera la variante di default
		if (this.CurrentRun !=null
			&& this.PeriodGroup != null
			&& this.CurrentRun.SubPeriods !=null)
		{
			this.SubPeriods = (from p in this.CurrentRun.SubPeriods
										where p.StartDate == this.PeriodGroup.StartDate
											&& p.EndDate == this.PeriodGroup.EndDate
										select p)
							.ToList();
		}

		await base.OnParametersSetAsync();
	}

	public IEnumerable<RunPeriodCar> GetPeriodCars (RunPeriod period)
	{
		return (from c in period.Cars
				where c.RunCarType == CarTypeEnum.Primary
					|| c.RunCarType == CarTypeEnum.Spare1
					|| c.RunCarType == CarTypeEnum.Spare2
				orderby c.RunCarType ascending, c.AssociateId, c.CarId
				select c);
	}

	private bool HasReplacements (RunPeriod period)
	{
		return true;
	}
	private IEnumerable<CarReplacement> GetReplacementList (RunPeriod period)
	{
		return (from c in period.CarReplacements
				orderby c.StartDate
				select c);
	}

	private string GetReplacementDescriotion (CarReplacement replacement)
	{
		return string.Format("{0:dd/MM/yyyy} - {1:dd/MM/yyyy}",
			replacement.StartDate,
			replacement.EndDate
			);
	}

	void OnTabChange(int index)
    {
        
    }
}
