@using CtaLinea.Model.Runs
@using CtaLineaApp.Pages.Runs.Dialogs
@inject IRunModelService RunModelService
@inject DialogService DialogService
@inject NotificationService _notificationService
@inject IRunRepository _runRepo;

<div class="d-flex flex-row">
	<RadzenDataGrid 
		@ref=@NodeGrid
		AllowFiltering="false" AllowPaging="false" AllowSorting="false"
		AllowVirtualization=true
		AllowColumnResize=true
		Data="@this.GetNodes()"
		Style="height: 500px"
		TItem="RunNode">
		<HeaderTemplate>
			@if (ReadOnly == false)
			{
				<RadzenButton Click=@AddNote_Click Text="Nuovo Nodo" Icon="add" />
				<RadzenButton Click=@Reorder_Click Text="Riordina" ButtonStyle="ButtonStyle.Secondary" Icon="sort" />
				<RadzenButton Click=@ImportNode_Click Text="Importa" ButtonStyle="ButtonStyle.Success" Icon="auto_fix_high" />
			}
		</HeaderTemplate>
		<Columns>
			<RadzenDataGridColumn Width="50px" TItem="RunNode" Title="#" TextAlign="TextAlign.Center" Property="ProgrNumber" />
			<RadzenDataGridColumn TItem="RunNode" Title="Orafio" Width="70px">
				<Template Context="data">
					@this.FormatTime(data.Hour)
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="RunNode" Property="CollectionPointId" Title="Codice Nodo" Width="120px" />
			<RadzenDataGridColumn TItem="RunNode" Title="Descrizione Nodo">
				<Template Context="data">
					@data.CollectionPointData?.Description
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="RunNode" Property="@nameof(RunNode.CoincidenceDescr)" Title="Coincidenza" Width="200"  />
			
			@if (ReadOnly == false)
			{
				<RadzenDataGridColumn TItem="RunNode" Context="node" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
					<Template Context="data">
						<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
								  Icon="edit"
								  Size="ButtonSize.Medium"
								  Click=@(() => EditNode_Click(data)) Text="" />
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
								  Icon="delete"
								  Size="ButtonSize.Medium"
								  Click=@(() => DeleteNode_Click(data)) Text="" />
					</Template>
				</RadzenDataGridColumn>
			}
		</Columns>
	</RadzenDataGrid>
</div>

<DialogBoxWrapper @ref=@NodeEditDialogBox
	Width="1000px"
	Title="Nodo">
	<Body Context="ds">
		<NodeEditDialogBox @bind-Node="@NodeInEdit" />
	</Body>
	<Buttons Context="ds" >
		@if (this.IsAdding == true)
		{
			<RadzenButton Click="@(() => this.ConfirmNodeUpdateAsync(ds))"
					  Text="Crea" />
		}
		else
		{
			<RadzenButton Click="@(() => this.ConfirmNodeUpdateAsync(ds))"
					  Text="Aggiorna" />

		}
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</Buttons>
</DialogBoxWrapper>

@code {
	private RadzenDataGrid<RunNode>? NodeGrid;

	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public RunVariation Variation { get; set; } = new RunVariation();

	[Parameter]
	public bool ReadOnly { get; set; } = false;

	// nodo per il dialog
	private RunNode? DialogNode = null;

	protected override async Task OnInitializedAsync()
	{

		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{

		await base.OnParametersSetAsync();
	}

	private IList<RunNode> GetNodes()
	{
		var nodes = new List<RunNode>();
		if (this.Variation.Nodes != null)
		{

			nodes = (from n in this.Variation.Nodes
						orderby n.ProgrNumber, n.Hour
						select n)
			.ToList();
		}
		return nodes;
	}

	private string FormatTime(
		TimeSpan? time)
	{
		if (time == null) return string.Empty;
		var to = new TimeOnly(time.Value.Hours, time.Value.Minutes, time.Value.Seconds);
		return string.Format("{0:HH:mm}", to);
	}

	private async Task DeleteNode_Click(RunNode node)
	{
		this.RunModelService.RemoveNode(
			this.Variation,
			node);

		this.StateHasChanged();
		this.EditableData?.SetDirty();
		await Task.CompletedTask;
	}

	#region edit node dialog
	private DialogBoxWrapper? NodeEditDialogBox;
	private bool IsAdding = false;
	private RunNode NodeInEdit = new RunNode();

	private async Task AddNote_Click()
	{
		this.NodeInEdit = this.RunModelService.CreateNewNode(this.Variation, false);
		this.IsAdding = true;
		if (this.NodeEditDialogBox != null)
		{
			await this.NodeEditDialogBox.ShowDialog("Nuovo nodo");
		}
	}

	private async Task EditNode_Click(RunNode node)
	{
		var item = new RunNode();
		item.copyFrom(node);
		NodeInEdit = item;

		this.IsAdding = false;
		if (this.NodeEditDialogBox != null)
		{
			await this.NodeEditDialogBox.ShowDialog("Nuovo nodo");
		}
	}

	private async Task ConfirmNodeUpdateAsync (DialogService ds)
	{
		// contorlla i dati immessi



		// aggiunge o aggiorna il nodo
		if (this.IsAdding == true)
		{
			this.RunModelService.AddNodeToVariation(
				this.Variation,
				this.NodeInEdit);
		}
		else
		{
			if ( this.Variation.Nodes != null)
			{
				var node = this.Variation.Nodes.Where(n => n.RunNodeId == this.NodeInEdit.RunNodeId).SingleOrDefault();
				if (node != null)
				{
					node.copyFrom(this.NodeInEdit);
				}
			}
		}
		if (this.NodeGrid != null)
		{
			await NodeGrid.Reload();
		}

		ds.Close();
		this.EditableData?.SetDirty();
	}
	#endregion

	private void Reorder_Click()
	{
		RunModelService.ReorderNodes(this.Variation);
		this.EditableData?.SetDirty();
		this.StateHasChanged();
	}

	#region dialog di improt dei nodi
	private async Task ImportNode_Click ()
	{
		await DialogService.OpenAsync(
			"Carica Nodi",
			ds => @<NodesImportWizardDialog ds=@ds CurrentRun="@CurrentRun" Variation=@Variation EditableData=@EditableData />
			, new DialogOptions()
			{
				ShowClose = true,
				CloseDialogOnEsc = true,
				CloseDialogOnOverlayClick = true,

				Width = "1000px",
				Draggable = false
			}
		);
	}
	#endregion

	void OnTabChange(int index)
	{

	}
}
