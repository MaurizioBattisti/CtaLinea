@inject DialogService _DialogService;

<RadzenRow AlignItems="AlignItems.Start" Gap="5px">
	<RadzenColumn Size="4">
		<RadzenLabel Component="Var_Note" Text="Note Mezzo" />
	</RadzenColumn>
	<RadzenColumn Size="8">
		<RadzenTextArea ReadOnly=@ReadOnly Name="Var_Note" @bind-Value="Car.Note" Class="w-100" Change=@(a=> this.EditableData?.SetDirty()) />
	</RadzenColumn>
</RadzenRow>
@if(ReadOnly == false)
{
	<RadzenRow>
		<RadzenText>
			il controllo delle sovrapposizoni del mezzo funziona solo se i dati sono salvati
		</RadzenText>
	</RadzenRow>
	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
		<RadzenButton Click="@CheckOVerlapping_Click"
						ButtonStyle="ButtonStyle.Light"
						Icon="join_full"
						Text="Sovrapposizioni" />
	</RadzenStack>
}
<DialogBoxWrapper @ref=@OverlappingCarDialog
				  Width="1000px"
				  Title="Sovrapposizioni">
	<Body Context="ds">
		<OverlappingRunCarView RunCarId="@Car.RunCarId" />
	</Body>
	<Buttons Context="ds">
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Chiudi" />
	</Buttons>
</DialogBoxWrapper>

@code {
	DialogBoxWrapper? OverlappingCarDialog;

	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	[Parameter]
	public RunPeriodCar Car { get; set; } = new RunPeriodCar();

	[Parameter]
	public bool ReadOnly { get; set; } = false;

	private async Task CheckOVerlapping_Click ()
	{
		if (EditableData != null)
		{
			if (EditableData.IsClean == false)
			{
				await this._DialogService.Alert(
					"Per poter vedere le sovrapposizioni è necessario non ci siano modiiche pendenti. Salvare la corsa prima di procedere.",
					"Impossivile vedere le sovrapposizioni"
					);
				return;				
			}
		}

		if (OverlappingCarDialog!= null)
		{
			await this.OverlappingCarDialog.ShowDialog();
		}
	}
}
