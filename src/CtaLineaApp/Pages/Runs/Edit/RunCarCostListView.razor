@inject IApplicationSettings AppSettings;
@inject DialogService DialogService;
@inject IRunModelService RunModelService

<RadzenDataGrid @ref=@CostGrid
				AllowFiltering="false"
				AllowPaging="false" AllowSorting="true"
				AllowColumnResize=true
				Data="@this.PeriodCar.CarCosts"
				Culture=@AppSettings.CurrentCulture
                EditMode="DataGridEditMode.Single"
				RowUpdate="@OnUpdateRow" 
				RowCreate="@OnCreateRow" 
				Sort="@Reset" 
				Page="@Reset" 
				Filter="@Reset"
				TItem="RunCarCost">
	<HeaderTemplate>
		@if (ReadOnly == false)
		{
			<RadzenButton Click=@InsertRow_Click Text="Nuovo Costo" Icon="add" />
		}
	</HeaderTemplate>
	<Columns>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Inizio" Width="130px">
			<Template Context="data" >
				@if (string.IsNullOrWhiteSpace(data.SimulationName))
				{
					<span>@(data.StartDate == null ? "Dall'Inizio" : string.Format("Dal {0:dd/MM/yy}", data.StartDate.Value)) </span>
				}
				else
				{
					<div style="width: 100%;" class="rz-background-color-warning-darker">
						@(data.StartDate == null ? "Dall'Inizio" : string.Format("Dal {0:dd/MM/yy}", data.StartDate.Value))
					</div>
				}
			</Template>
			<EditTemplate Context="cost">
				<DateSelector @bind-Value="@cost.StartDate"
							  AllowClear=true/>
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Al Km" Property="@nameof(RunCarCost.KmPrice)" FormatString="{0:C}" Width="85px" >
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal"
							   @bind-Value="@cost.KmPrice"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100"/>
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Al Km +" Property="@nameof(RunCarCost.KmPriceExtra)" FormatString="{0:C}" Width="85px">
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal"
							   @bind-Value="@cost.KmPriceExtra"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
								class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Al Giorno" Property="@nameof(RunCarCost.DayPrice)" FormatString="{0:C}" Width="85px">
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal"
							   @bind-Value="@cost.DayPrice"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>

		<!--
		<RadzenDataGridColumn TItem="RunCarCost" Title="Fofait G." Property="@nameof(RunCarCost.DayForfait)" FormatString="{0:C}" Width="90px" >
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal?"
							   @bind-Value="@cost.DayForfait"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>
		-->
		<RadzenDataGridColumn TItem="RunCarCost" Title="Integraz. G." Property="@nameof(RunCarCost.DayIntegration)" FormatString="{0:C}" Width="90px" >
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal?"
							   @bind-Value="@cost.DayIntegration"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Minimo G." Property="@nameof(RunCarCost.MinDayCost)" FormatString="{0:C}" Width="90px">
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal?"
							   @bind-Value="@cost.MinDayCost"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="RunCarCost" Title="Massimo. G." Property="@nameof(RunCarCost.MaxDayCost)" FormatString="{0:C}" Width="90px">
			<EditTemplate Context="cost">
				<RadzenNumeric TValue="decimal?"
							   @bind-Value="@cost.MaxDayCost"
							   Culture=@AppSettings.CurrentCulture
							   Format="0.00"
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>

		<RadzenDataGridColumn TItem="RunCarCost" Title="Simulazione." Property="@nameof(RunCarCost.SimulationName)" Width="150px">
			<EditTemplate Context="cost">
				<RadzenTextBox TValue="string?"
							   @bind-Value="@cost.SimulationName"
							   Culture=@AppSettings.CurrentCulture
							   Class="w-100" />
			</EditTemplate>
		</RadzenDataGridColumn>

		@if (ReadOnly == false)
		{
			<RadzenDataGridColumn TItem="RunCarCost" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="90px">
				<Template Context="data">
					<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
							  Icon="edit"
							  Size="ButtonSize.Medium"
                              Click=@(() => EditRow_Click(data)) Text="" />
					<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
							Icon="delete"
							Size="ButtonSize.Medium"
                              Click=@(() => DeleteRow_Click(data)) Text="" />
				</Template>
				<EditTemplate Context="data">
					<RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow_Click(data))">
					</RadzenButton>
					<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="my-1 ms-1" Click="@((args) => CancelEdit_Click(data))">
					</RadzenButton>
				</EditTemplate>
			</RadzenDataGridColumn>
		}
	</Columns>
</RadzenDataGrid>

@code {
	private RadzenDataGrid<RunCarCost>? CostGrid;

	[CascadingParameter]
	CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	[Parameter]
	public RunPeriodCar PeriodCar { get; set; } = new RunPeriodCar();

	[Parameter]
	public bool ReadOnly { get; set; } = false;

	private RunCarCost? CostToInsert;
	private RunCarCost? CostToUpdate;

	protected override void OnInitialized()
	{
		base.OnInitialized();
		if (this.PeriodCar.CarCosts == null)
		{
			this.PeriodCar.CarCosts = new List<RunCarCost>();
		}
	}

	private IList<RunCarCost>? GetOnlyRealCosts(RunPeriodCar car)
	{
		if (car.CarCosts == null
			|| car.CarCosts.Count == 0)
		{
			return car.CarCosts;
		}
		return car.CarCosts?
			.Where(cc => string.IsNullOrWhiteSpace(cc.SimulationName))
			.ToList();
	}

	private async Task<bool> CheckCostAsync (RunCarCost item)
	{
		bool result = true;

		// se il costo è un costo di sumulaizoe non fa niente
		if (string.IsNullOrWhiteSpace(item.SimulationName) == false ) return await Task.FromResult(result);

		var carCosts = this.GetOnlyRealCosts(this.PeriodCar);
		if (carCosts != null)
		{
			// contorlla se esiste già una data di inizio
			var cost = (from cc in carCosts
						where cc.RunCarCostId != item.RunCarCostId
							&& cc.StartDate == item.StartDate
						select cc).FirstOrDefault();
			if (cost != null)
			{
				result = false;
				await this.DialogService.Alert("E' già presente un costo che inizia alla stessa data. Non è possibile creeare un'latro costo con la stessa data di inizio", "Costo del mezzo");
			}
		}

		return await Task.FromResult(result);
	}

	private void Reset()
	{
		CostToInsert = null;
		CostToUpdate = null;
	}

	private async Task InsertRow_Click()
	{
		var item = RunModelService.CreateRunCarCost(this.PeriodCar, DateTime.Now, false);
		CostToInsert = item ?? new RunCarCost ()
		{
			RunCarCostId = Guid.NewGuid(),
			StartDate = DateTime.Now
		};
		// se è il primo costo che si inserisce  mette la data di inizioa  null
		if (this.PeriodCar.CarCosts == null
			|| this.PeriodCar.CarCosts.Count == 0)
		{
			CostToInsert.StartDate = null;
		}

		if (this.CostGrid != null)
		{
			await CostGrid.InsertRow(CostToInsert);
		}
	}

	async Task EditRow_Click(RunCarCost cost)
	{
		var item = new RunCarCost ();
		item.CopyFrom(cost);
		CostToUpdate = item;

		if (CostGrid != null)
		{
			await CostGrid.EditRow(cost);
		}
	}

	private async Task SaveRow_Click(RunCarCost cost)
	{
		// controla i dati se ok procede
		if (await this.CheckCostAsync(cost) != true) return;

		if (CostGrid != null)
		{
			await CostGrid.UpdateRow(cost);
		}
	}
	private async Task CancelEdit_Click(RunCarCost cost)
	{
		await Task.CompletedTask;

		if (cost == CostToInsert)
		{
			CostToInsert = null;
		}
		else
		{
			if (CostToUpdate != null)
			{
				cost.CopyFrom(CostToUpdate);
			}
		}
		CostToUpdate = null;

		CostGrid?.CancelEditRow(cost);
	}

	private async Task DeleteRow_Click(RunCarCost cost)
	{
		if (cost == CostToInsert)
		{
			CostToInsert = null;
		}

		if (cost == CostToUpdate)
		{
			CostToUpdate = null;
		}

		if (PeriodCar.CarCosts != null
			&& PeriodCar.CarCosts.Contains(cost))
		{
			PeriodCar.CarCosts.Remove(cost);
			this.EditableData?.SetDirty();

			if (CostGrid != null)
			{
				await CostGrid.Reload();
			}
		}
		else
		{
			CostGrid?.CancelEditRow(cost);
			if (CostGrid != null)
			{
				await CostGrid.Reload();
			}
		}
	}

	private async Task OnUpdateRow(RunCarCost cost)
	{
		await Task.CompletedTask;

		if (this.PeriodCar.CarCosts == null) this.PeriodCar.CarCosts = new List<RunCarCost>();
		var item = (from cc in this.PeriodCar.CarCosts
					where cc.RunCarCostId == cost.RunCarCostId
					select cc).SingleOrDefault();
		item?.CopyFrom(cost);
		this.EditableData?.SetDirty();
	}

	private async Task OnCreateRow(RunCarCost cost)
	{
		await Task.CompletedTask;

		if (this.PeriodCar.CarCosts == null) this.PeriodCar.CarCosts= new List<RunCarCost> ();
		this.PeriodCar.CarCosts.Add(cost);

		this.EditableData?.SetDirty();

		CostToInsert = null;
	}

	/*
	private void RowRender(RowRenderEventArgs<RunCarCost> args)
	{
		if (string.IsNullOrWhiteSpace(args.Data.SimulationName) == false)
		{
			args.Attributes.Add("class", "rz-background-color-warning-darker");
		}
	}
	*/
}
