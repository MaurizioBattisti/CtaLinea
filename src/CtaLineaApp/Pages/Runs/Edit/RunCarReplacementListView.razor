@inject DialogService DialogService

<RadzenDataGrid @ref=@ReplList
				AllowGrouping="true" AllowFiltering="true" AllowSorting="true"
				AllowColumnResize=true
				Data="@Period.CarReplacements"
				SelectionMode="DataGridSelectionMode.Single"
				@bind-Value=@SelectedCarReplacements
				TItem="CarReplacement" 
				>
	<HeaderTemplate>
		<RadzenButton Click=@AddReplcement_Click Text="Nuova Sostituzione" Icon="add" />
	</HeaderTemplate>

	<Columns>
		<RadzenDataGridColumn TItem="CarReplacement" Property="StartDate" Title="Inizio" Width="100px">
			<Template Context="data">
				<span>@(data.StartDate == null ? "Dall'inizio" : string.Format("Dal {0:dd/MM/yyyy}", data.StartDate) ) </span>
			</Template>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="CarReplacement" Property="EndDate" Title="Fine" Width="100px">
			<Template Context="data">
				<span>@(data.EndDate == null ? "Alla fine" : string.Format("Al {0:dd/MM/yyyy}", data.EndDate)) </span>
			</Template>
		</RadzenDataGridColumn>

		<RadzenDataGridColumn TItem="CarReplacement" Property="Note" Width="250px" Title="Note" />

		<RadzenDataGridColumn TItem="CarReplacement" Context="group" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
			<Template Context="data">
				<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
							  Icon="edit"
							  Size="ButtonSize.Medium"
							  Click=@(() => EditReplacement_Click(data)) Text="" />
				<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
							  Icon="delete"
							  Size="ButtonSize.Medium"
							  Click=@(() => DeleteReplacement_Click(data)) Text="" />
			</Template>
		</RadzenDataGridColumn>
	</Columns>
</RadzenDataGrid>

@if (SelectedCarReplacements.Count > 0)
{
	<RadzenRow AlignItems="AlignItems.Start">
		<RadzenColumn Size="3">
			<RadzenLabel Component="Note sostituzione" Text="Note" />
		</RadzenColumn>
		<RadzenColumn Size="9">
			<RadzenTextArea Name="Note" @bind-Value="CurrentCarReplacement.Note" Class="w-100 h-100" Change=@(a=> this.EditableData?.SetDirty()) Style="height: 60px" />
		</RadzenColumn>
	</RadzenRow>

	<h3>Mezzi Originali</h3>
	<RunCarListView2 CurrentRun=@CurrentRun EditableData=@EditableData
			CarList=@GetOriginalCars()
			CanChangeData=false
			HandlePrimaryCar=true
			HandleReplacedCars=false
			HandleSpareCars=false />

	<h3>Sotituiti da</h3>
	<RunCarListView2 CurrentRun=@CurrentRun EditableData=@EditableData
				 CarList=@GetReplacedCars()
				 CanChangeData=true
				 HandlePrimaryCar=false
				 HandleReplacedCars=true
				 HandleSpareCars=false
				 BeforeAddNew="@BeforeAddCarAsync"
				 AfterAddNew="@AfterAddCarAsync"
				 BeforeUpdate="@BeforeUpdateCarAsync"
				 AfterUpdate="@AfterUpdateCarAsync"
				 BeforeDelete="@BeforeDeleteCarAsync"
				 AfterDelete="@AfterDeleteCarAsync" />

}

<DialogBoxWrapper @ref=@ReplacementDlg 
				  Width="500px"
				  Title="Sostituzione mezzo">
	<Body Context="ds">
		<RadzenRow>
			<RadzenColumn Size="8">
				<DateRangeSelector @bind-StartDate=@ReplacementInEdit.StartDate
								   @bind-EndDate=@ReplacementInEdit.EndDate
								   Min=@GetMinDate()
								   Max=@MGetaxDate()
								   AllowClear=false
								   Inline=true />
			</RadzenColumn>
		</RadzenRow>
		<RadzenRow>
			<RadzenLabel Text="Mezzi da sostituire" />
		</RadzenRow>
		<RunCarListView2 EditableData=@EditableData
						 CurrentRun=@CurrentRun
						 CarList=@Period.Cars
						 CanChangeData=false
						 CanSelectData=true
						 HandlePrimaryCar=true
						 HandleSpareCars=false
						 HandleReplacedCars=false
 						 SelectionMode="DataGridSelectionMode.Multiple"
						 @bind-SelectedCars=@_OriginalCars
						 />
	</Body>
	<Buttons Context="ds">
		@if (this.IsAdding == true)
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateReplacementASync(ds))"
					  Text="Crea" />
		}
		else
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateReplacementASync(ds))"
					  Text="Aggiorna" />

		}
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</Buttons>
</DialogBoxWrapper>

@code {
	RadzenDataGrid<CarReplacement>? ReplList;
	DialogBoxWrapper? ReplacementDlg;

	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	[Parameter]
	public RunPeriod Period { get; set; } = new RunPeriod();

	private IList<CarReplacement> SelectedCarReplacements { get; set; } = new List<CarReplacement>();

	private IEnumerable<RunPeriodCar>? GetOriginalCars (
		CarReplacement? myReplacement = null)
	{
		IEnumerable<RunPeriodCar>? list = null;
		if (this.SelectedCarReplacements.Count() == 1)
		{
			CarReplacement repl;
			if (myReplacement != null)
			{
				repl = myReplacement;
			}
			else
			{
				repl = this.SelectedCarReplacements.First();
			}
			var ids = repl.OriginalPEriodCarIds ?? new List<Guid>();

			list = (from c in this.Period.Cars
					where c.RunCarType == CarTypeEnum.Primary
						&& ids.Contains(c.RunCarId) == true
					select c);
		}
		return list;
	}

	private IEnumerable<RunPeriodCar>? GetReplacedCars()
	{
		IEnumerable<RunPeriodCar>? list = null;
		if (this.SelectedCarReplacements.Count() == 1)
		{
			var repl = this.SelectedCarReplacements.First();
			var ids = repl.ReplacedPEriodCarIds ?? new List<Guid>();

			list = (from c in this.Period.Cars
					where c.RunCarType == CarTypeEnum.Replacement
						&& ids.Contains(c.RunCarId) == true
					select c);
		}
		return list;
	}

	private CarReplacement? GetCurrentCarReplacement ()
	{
		return SelectedCarReplacements?.FirstOrDefault();
	}
	private CarReplacement CurrentCarReplacement
	{
		get { return this.GetCurrentCarReplacement() ?? new CarReplacement(); }
	}

	#region gestione della dialog di aggiunta o modiica del mezzo
	private bool IsAdding = false;
	private CarReplacement ReplacementInEdit = new CarReplacement();
	private IList<RunPeriodCar> _OriginalCars = new List<RunPeriodCar>();

	private string GetDialogTitle()
	{
		return this.IsAdding ? "Nuova Sostituzione" : "Modifica Sostituzione";
	}

	private async Task AddReplcement_Click()
	{
		if (this.ReplacementDlg != null)
		{
			var newRepl = new CarReplacement();
			newRepl.CarReplacementId = Guid.NewGuid();

			IsAdding = true;
			this.ReplacementInEdit = newRepl;
			_OriginalCars = new List<RunPeriodCar>();
			await ReplacementDlg.ShowDialog(this.GetDialogTitle());
		}
	}

	private async Task EditReplacement_Click(CarReplacement item)
	{
		if (this.ReplacementDlg != null)
		{
			var repl = new CarReplacement();
			repl.CarReplacementId = item.CarReplacementId;
			repl.StartDate = item.StartDate;
			repl.EndDate = item.EndDate;
			repl.OriginalPEriodCarIds = item.OriginalPEriodCarIds?.ToList() ?? new List<Guid>();
			repl.ReplacedPEriodCarIds = item.ReplacedPEriodCarIds?.ToList() ?? new List<Guid>();
			repl.Note = item.Note;

			IsAdding = false;
			this.ReplacementInEdit = repl;
			_OriginalCars = this.GetOriginalCars(item)?.ToList() ?? new List<RunPeriodCar>();
			await ReplacementDlg.ShowDialog(this.GetDialogTitle());
		}
	}

	private async Task ConfirmUpdateReplacementASync(
		DialogService ds)
	{
		bool done = false;

		// controlla che il periodo sia corretto
		if (this.ReplacementInEdit.StartDate != null && ReplacementInEdit.EndDate != null
			&& ReplacementInEdit.EndDate < ReplacementInEdit.StartDate)
		{
			await this.DialogService.Alert("La data fine non può essere precedetne a quella di inizio");
			return;
		}

		// assegna i valori originali degli id  dei mezzi
		this.ReplacementInEdit.OriginalPEriodCarIds = _OriginalCars?.Select(c => c.RunCarId).ToList() ?? new List<Guid>();

		// se tutto ok aggiorna i dati
		if (IsAdding == true)
		{
			// era una add
			if (this.Period.CarReplacements == null) this.Period.CarReplacements = new List<CarReplacement>();
			this.Period.CarReplacements.Add(this.ReplacementInEdit);
			done = true;
		}
		else
		{
			// era un update
			if (this.Period.CarReplacements != null)
			{
				var item = this.Period.CarReplacements.Where(r => r.CarReplacementId == this.ReplacementInEdit.CarReplacementId).SingleOrDefault();
				if (item != null)
				{
					item.StartDate = ReplacementInEdit.StartDate;
					item.EndDate = ReplacementInEdit.EndDate;
					item.OriginalPEriodCarIds = this.ReplacementInEdit.OriginalPEriodCarIds?.ToList() ?? new List<Guid>();
					item.ReplacedPEriodCarIds = this.ReplacementInEdit.ReplacedPEriodCarIds;
					item.Note = ReplacementInEdit.Note;

					done = true;
				}
			}
		}
		if (done == true)
		{
			ds.Close();
			if (this.ReplList != null)
			{
				await this.ReplList.Reload();
			}
			this.EditableData?.SetDirty();
		}
	}
	private async Task DeleteReplacement_Click(CarReplacement item)
	{
		// chiede conferma per la cancellazione della sostituzione
		if (await this.DialogService.Confirm ("Sei sicuro di voler eliminare la sostituzione ? tutti i dati inseriti  come lista dei emzzi e  costi associati ai mezzi sostituiti , verranno persi.",
				"Eliminazioe sostituzione",
				new ConfirmOptions
				{
					OkButtonText = "Si, elimina !",
					CancelButtonText = "No"
				}) != true)
		{
			return;
		}

		if (this.Period.CarReplacements != null)
		{
			var repl = this.Period.CarReplacements.Where(r => r.CarReplacementId == item.CarReplacementId).SingleOrDefault();
			if (repl != null)
			{
				if (this.Period.CarReplacements == null) return;
				this.Period.CarReplacements.Remove(repl);

				if (this.ReplList != null)
				{
					await this.ReplList.Reload();
				}
				this.EditableData?.SetDirty();
			}
		}
	}

	private DateTime? GetMinDate()
	{
		return null;
	}
	private DateTime?  MGetaxDate()
	{
		return null;
	}

	#endregion

	#region gestisce i dati dei mezzi sostitutivi
	#region  Add car
	private async Task BeforeAddCarAsync(BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		var currRepl= this.GetCurrentCarReplacement();
		if (currRepl != null)
		{
			if (currRepl.ReplacedPEriodCarIds != null
				&& this.Period.Cars != null)
			{
				// recupera l'elenco dei perido car dal periodo
				var nuk = (from c in this.Period.Cars
									where c.CarId == beforeAction.Item.CarId
										&& c.RunCarId !=beforeAction.Item.RunCarId
										&& currRepl.ReplacedPEriodCarIds.Contains( c.RunCarId)
									select c).Count();
				if (nuk > 0)
				{
					// il mezzo è già stato assegnao al periodo
					await DialogService.Alert("Questo mezzo è già stato aggiunto, impossibile aggiungere lo stesso mezzo", "Aggiungi mezzo Mezzo");
					beforeAction.Cancelled = true;
					return;
				}
			}
		}
		else
		{
			beforeAction.Cancelled = true;
		}

		await Task.CompletedTask;
	}
	private async Task AfterAddCarAsync(RunPeriodCar item)
	{
		var currRepl = this.GetCurrentCarReplacement();
		if (currRepl != null)
		{
			// aggiunge il car period alla lista dei mezzi
			if (this.Period.Cars == null)
			{
				this.Period.Cars = new List<RunPeriodCar>();
			}
			this.Period.Cars.Add(item);

			// aggiunge l'id alla lista dei mezzi rimpiazzati
			if (currRepl.ReplacedPEriodCarIds == null)
			{
				currRepl.ReplacedPEriodCarIds = new List<Guid> ();
			}
			currRepl.ReplacedPEriodCarIds.Add(item.RunCarId);
			this.EditableData?.SetDirty();
		}
		await Task.CompletedTask;
	}
	#endregion
	#region update car
	private async Task BeforeUpdateCarAsync(BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		var currRepl = this.GetCurrentCarReplacement();
		if (currRepl != null)
		{
			if (currRepl.ReplacedPEriodCarIds != null
				&& this.Period.Cars != null)
			{
				// recupera l'elenco dei perido car dal periodo
				var nuk = (from c in this.Period.Cars
									where c.CarId == beforeAction.Item.CarId
										&& c.RunCarId != beforeAction.Item.RunCarId
										&& currRepl.ReplacedPEriodCarIds.Contains(c.RunCarId)
									select c).Count();
				if (nuk > 0)
				{
					// il mezzo è già stato assegnao al periodo
					await DialogService.Alert("Questo mezzo è già stato aggiunto, impossibile aggiungere lo stesso mezzo", "Aggiungi mezzo Mezzo");
					beforeAction.Cancelled = true;
					return;
				}
			}
		}
		else
		{
			beforeAction.Cancelled = true;
		}

		await Task.CompletedTask;
	}
	private async Task AfterUpdateCarAsync(RunPeriodCar item)
	{
		if (this.Period.Cars != null)
		{
			var car = this.Period.Cars.Where(c => c.RunCarId == item.RunCarId).SingleOrDefault();
			if (car != null)
			{
				car.RunCarType = item.RunCarType;

				car.AssociateId = item.AssociateId;
				car.AssociateData = item.AssociateData;
				car.CarId = item.CarId;
				car.CarData = item.CarData;

				this.EditableData?.SetDirty();
				this.EditableData?.SetDirty();
			}
		}
		await Task.CompletedTask;
	}
	#endregion
	#region delete car
	private async Task BeforeDeleteCarAsync(BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		// chiede conferma per la cancellazione dei costi nel caso ci siano dei costi associati
		if (this.Period.Cars != null)
		{
			var car = this.Period.Cars.Where(c => c.RunCarId == beforeAction.Item.RunCarId).SingleOrDefault();
			if (car != null)
			{
				var answer = await this.DialogService.Confirm(
					"Sei sicuro di voler eliminare il mezzo ? Eliminando il mezzo verranno persi anche tutti i costi associati.",
					"Eliminazione mezzo",
					new ConfirmOptions { OkButtonText = "Si, Elimina", CancelButtonText = "No" }
					);
				if (answer != true) beforeAction.Cancelled = true;
			}
		}
	}
	private async Task AfterDeleteCarAsync(RunPeriodCar item)
	{
		var currRepl = this.GetCurrentCarReplacement();
		if (currRepl != null)
		{
			if (this.Period.Cars != null)
			{
				this.Period.Cars.Remove(item);
				if (currRepl.ReplacedPEriodCarIds != null)
				{
					currRepl.ReplacedPEriodCarIds.Remove(item.RunCarId);
				}
				this.EditableData?.SetDirty();
			}
		}
		await Task.CompletedTask;
	}
	#endregion
	#endregion

}
