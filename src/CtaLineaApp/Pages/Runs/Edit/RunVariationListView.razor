@using CtaLineaApp.Components.Base

@using CtaLineaApp.Pages.Runs.Dialogs
@inject IRunModelService RunModelService
@inject DialogService DialogService
@inject NotificationService notificationService
@inject IApplicationSettings AppSettings

<RadzenTemplateForm Data="@CurrentRun"
					Submit="@((RunItem args) => { ; })" >
	<Animate IsManual="false"
			 Animation="Animations.ZoomIn"
			 Easing="Easings.Ease"
			 Duration="TimeSpan.FromSeconds(0.5)">

		<div class="d-flex flex-row">
			<RadzenDataGrid @ref=@VariationList
							AllowFiltering="false"
							AllowPaging="false" AllowSorting="false"
							AllowColumnResize=true
							Data="@this.GetVariationList()"
							SelectionMode="DataGridSelectionMode.Single"
							@bind-Value=@SelectedVariations
							TItem="RunVariation">
				<HeaderTemplate>
					@if (ReadOnly == false)
					{
						<RadzenButton Click=@AddVariation_Click Text="Nuova Variazione" Icon="add" />
					}
				</HeaderTemplate>

				<Columns>
					<RadzenDataGridColumn TItem="RunVariation" Title="Dal" Width="120px">
						<Template Context="data">
							@this.FormatDate(data.StartDate)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="RunVariation" Title="inizio" Width="70px">
						<Template Context="data">
							@this.FormatTime(data.StartTime)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="RunVariation" Property="Km" Title="Delta KM" Width="70px">
						<Template Context="data">
							@(string.Format(this.AppSettings.CurrentCulture, "{0:0.00}", (data.Km ?? 0) - this.GetBaseKm()))
						</Template>
					</RadzenDataGridColumn>

					@if (ReadOnly == false)						
					{
						<RadzenDataGridColumn TItem="RunVariation" Context="node" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
							<Template Context="data">
								<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
										  Icon="edit"
										  Visible=@(false == IsVariationLocked(data))
										  Size="ButtonSize.Medium"
										  Click=@(() => EditVariation_Click(data)) Text="" />
								<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
										  Icon="delete"
										  Visible=@(false == IsVariationLocked(data))
										  Size="ButtonSize.Medium"
										  Click=@(() => DeleteVariation_Click(data)) Text="" />
							</Template>
						</RadzenDataGridColumn>
					}
				</Columns>
			</RadzenDataGrid>
		</div>
		@if(this.SelectedVariations.Count > 0)
		{
			<RunVariationMainDataVide @ref=@RunVariationMainDataVide
							      ReadOnly=@ReadOnly
								  EditableData="@this.EditableData"
								  CurrentRun="@CurrentRun"
								  Variation="@GetSelectedVariaiton()" />

			<RunNodeListView CurrentRun="@CurrentRun"
					     ReadOnly=@ReadOnly
						 Variation="@GetSelectedVariaiton()"
						 EditableData="@EditableData" />

		}
	</Animate>
</RadzenTemplateForm>

<DialogBoxWrapper @ref=@VariantDialog
	Width="300px"
	Title="Variazione">
	<Body Context="ds">
		<RadzenRow>
			<RadzenColumn Size="6">
				<RadzenLabel Component="StartDate" Text="Data Inizio" />
			</RadzenColumn>
			<RadzenColumn Size="6" >
				<DateSelectorNotNull Name="StartDate"
				    Min=@GetMinDate()
					@bind-Value=@Edit_StartDate />
			</RadzenColumn>
		</RadzenRow>
	</Body>
	<Buttons Context="ds">
		@if (this.IsAdding == true)
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateVariantAsync(ds))"
					  Text="Crea" />
		}
		else
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateVariantAsync(ds))"
					  Text="Aggiorna" />

		}
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</Buttons>
</DialogBoxWrapper>

@code {
	RunVariationMainDataVide? RunVariationMainDataVide;
	RadzenDataGrid<RunVariation>? VariationList;

	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	[Parameter]
	public bool ReadOnly { get; set; } = false;

	IList<RunVariation> SelectedVariations = new List<RunVariation>();

	private RunVariation? GetSelectedVariaiton ()
	{
		return this.SelectedVariations.FirstOrDefault();
	}

	private double GetBaseKm ()
	{
		double baseKm = 0;
		if (this.CurrentRun.Variations != null)
		{
			var k = (from v in this.CurrentRun.Variations
						where v.StartDate == null
						select v.Km ?? 0
					).FirstOrDefault();
			baseKm = k;
		}
		return baseKm;
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// recupera la variante di default
		this.SelectCurrentVariation();

		await base.OnParametersSetAsync();
	}
	private void SelectCurrentVariation ()
	{
		if (this.CurrentRun != null
			&& this.CurrentRun?.Variations != null)
		{
			// seleziona la variante in data corrente
			var selected = (from v in this.CurrentRun.Variations
							where v.StartDate != null
								&& v.StartDate <= DateTime.Today
							orderby v.StartDate descending
							select v).FirstOrDefault();

			SelectedVariations.Clear();
			if (selected != null)
			{
				SelectedVariations.Add(selected);
			}
		}
		else
		{
			SelectedVariations.Clear();
		}
	}

	private IList<RunVariation > GetVariationList ()
	{
		if (this.CurrentRun != null
			&& this.CurrentRun?.Variations != null)
		{
			return (from v in this.CurrentRun.Variations
					where v.StartDate != null
					orderby v.StartDate descending
					select v).ToList();
		}
		else
		{
			return new List<RunVariation>();
		}
	}

	private string FormatDate(
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format(this.AppSettings.CurrentCulture, "{0:dd/MM/yyyy}", date);
	}
	private string FormatTime(
		TimeSpan? time)
	{
		if (time == null) return string.Empty;
		var to = new TimeOnly(time.Value.Hours, time.Value.Minutes, time.Value.Seconds);
		return string.Format(this.AppSettings.CurrentCulture, "{0:HH:mm}", to);
	}

	#region gestione dialog variaizoni
	private DialogBoxWrapper? VariantDialog;
	private bool IsAdding = false;
	private DateTime Edit_StartDate { get; set; }
	private RunVariation Edit_Item = new RunVariation();

	private async Task AddVariation_Click()
	{
		this.IsAdding = true;
		var mindate = this.GetMinDate();
		if (mindate == null
			|| mindate <= DateTime.Today)
		{
			this.Edit_StartDate = DateTime.Today;
		}
		else
		{
			this.Edit_StartDate = mindate.Value;
		}

		Edit_Item = new RunVariation()
		{
			RunVariationId = Guid.NewGuid()
		};
		if (VariantDialog != null)
		{
			await this.VariantDialog.ShowDialog("Nuova Variante");
		}
	}
	private async Task EditVariation_Click(RunVariation item)
	{
		this.IsAdding = false;
		var defDate = DateTime.Today;
		var mindate = this.GetMinDate();
		if (mindate != null
			&& mindate > DateTime.Today)
		{
			defDate = mindate.Value;
		}

		this.Edit_StartDate = item.StartDate ?? defDate;
		Edit_Item = item;
		if (VariantDialog != null)
		{
			await this.VariantDialog.ShowDialog("Nuova Variante");
		}
	}

	private async Task ConfirmUpdateVariantAsync (DialogService ds)
	{
		var already = (from v in this.CurrentRun.Variations
								where v.StartDate == this.Edit_StartDate
									&& v.RunVariationId != this.Edit_Item.RunVariationId
								select v).FirstOrDefault();
		if (already != null)
		{
			await this.DialogService.Alert("La data indicata è già stata usata come data di inizio di una variazione");
			return;
		}

		if (this.IsAdding == true)
		{
			var newVar = this.RunModelService.CreateNewVariation(this.CurrentRun, this.Edit_StartDate);
			if (this.VariationList != null)
			{
				await this.VariationList.Reload();
				await this.VariationList.SelectRow(newVar);
			}
		}
		else
		{
			if (this.CurrentRun.Variations != null)
			{
				var newVar =(from v in this.CurrentRun.Variations
									where v.RunVariationId == Edit_Item.RunVariationId
									select v).SingleOrDefault();
				if (newVar != null)
				{
					newVar.StartDate = this.Edit_StartDate;
				}
			}
		}

		ds.Close();
		this.EditableData?.SetDirty();
	}


	private async Task DeleteVariation_Click(RunVariation item)
	{
		var result = await this.DialogService.Confirm(
			string.Format("Sei sicuro di voler eliminare la variante che inizia il {0:dd/MM/yyyy} ?", item.StartDate ?? DateTime.Today),
			"Eliminazione variante",
			new ConfirmOptions
				{
					OkButtonText = "Si, Elimina",
					CancelButtonText = "No"
				}
			);
		if (result == true)
		{
			this.CurrentRun?.Variations?.Remove(item);
			this.EditableData?.SetDirty();
			if (this.VariationList != null)
			{
				await this.VariationList.Reload();
			}
			this.SelectCurrentVariation();
		}
	}
	#endregion

	private bool IsVariationLocked (
	RunVariation? item)
	{
		if (item == null) return true;
		if (this.CurrentRun.LockedDate == null) return false;

		if (item.StartDate == null)
		{
			return (
					(this.CurrentRun.StartDate != null
					&& this.CurrentRun.StartDate <= this.CurrentRun.LockedDate)
				|| this.CurrentRun.StartDate == null
			);
		}
		else
		{
			return item.StartDate <= this.CurrentRun.LockedDate;
		}
	}

	private DateTime? GetMinDate ()
	{
		if (this.CurrentRun.LockedDate == null) return null;
		return this.CurrentRun.LockedDate.Value.AddDays(1);
	}
}
