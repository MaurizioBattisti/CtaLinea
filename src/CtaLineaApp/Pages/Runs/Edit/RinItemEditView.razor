@inject IRunRepository _repo
@inject IQueryUtilityService queryService
@inject IRunModelService RunModelService
@inject IContractService ContractService
@inject DialogService DialogService
@inject NotificationService notificationService
@inject RouterSessionService RouterSessionService
@inject IRunChecker runChecker
@inherits EditorComponentBase

<CtaLineaSttingsNotifier Changed=@StateHasChanged />

@if (this.NoData == false && IsBusy == true)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (this.NoData == false)
{
    <div class="row justify-content-start align-items-center">
        @if (ReadOnly == false)
        {
            <div class="col-5 d-flex align-items-center">
                <h3>@(this.IsAdding ? "Nuova corsa" : "Modifica Corsa")</h3>
            </div>
            <div class="col-7 d-flex align-items-center justify-content-end">
                    <RadzenButton Click=@Save_Click IsBusy=@IsSaving Text="Salva Corsa" BusyText="Salvataggio...." ButtonStyle="ButtonStyle.Primary" />
            </div>
        }
        else
        {
            <div class="col-5 d-flex align-items-center">
                <h3>Dati Corsa</h3>
            </div>
        }
    </div>

    <RadzenTabs 
        @bind-SelectedIndex=@TabSelectedIndex
        TabPosition="TabPosition.Top" 
        RenderMode="TabRenderMode.Client">
         <Tabs>
            <RadzenTabsItem Text="Errori" Icon="beenhere">
                <Animate Animation="Animations.ZoomIn"
                     IsManual=false
                     Easing="Easings.Ease"
                     Duration="TimeSpan.FromSeconds(0.5)"
                    >
                    <CheckREsultView CheckResult=@CheckResult
                                 ShowSuccessMessage=true />
                </Animate>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Dati generali" Selected=true Icon="home">
                <MainRunDataView ReadOnly=@ReadOnly CurrentRun=@this.CurrentRun EditableData=@this />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Varianti" Icon="fork_right">
                <RunVariationListView ReadOnly=@ReadOnly CurrentRun=@this.CurrentRun EditableData=@this />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Mezzi" Icon="airport_shuttle">
                <RunCarPEriodListView ReadOnly=@ReadOnly CurrentRun=@this.CurrentRun EditableData=@this />
            </RadzenTabsItem>
            
            <RadzenTabsItem Text="Sospensioni">
                <Template>
                    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Orientation="Orientation.Horizontal">
                        <RadzenIcon Icon="block" />
                        <RadzenText Text="Sospensioni" />
                        <RadzenBadge Text="@(this.CurrentRun.Suspensions == null ? "0" : this.CurrentRun.Suspensions.Count.ToString())" />
                    </RadzenStack>
                </Template>
                <ChildContent>
                    <RunSuspensionListView ReadOnly="@ReadOnly" CurrentRun=@this.CurrentRun EditableData=@this />
                </ChildContent>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Giorni Add." Icon="free_cancellation">
                <RunAdditionalDayListView ReadOnly="@ReadOnly" EditableData=@this CurrentRun=@CurrentRun />
            </RadzenTabsItem>
            
            @if (this.IsAdding == false)
            {
                <RadzenTabsItem Text="Planning" Icon="calendar_month">
                    <RunPlanningView @ref=@Planning RunId=@RunId />
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else if (this.NoData == true)
{
    <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Info" Size="AlertSize.Large" Shade="Shade.Darker" AllowClose=false>
        Nessun dato da visualizzare
    </RadzenAlert>
}

@code {
    private int TabSelectedIndex { get; set; } = 1;

    [CascadingParameter]
    CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    private Guid RunId { get; set; } = Guid.Empty;

    RunItem CurrentRun = new RunItem();
    private bool IsBusy = true;
    private bool IsSaving = false;
    private bool IsAdding = false;
    [Parameter]
    public bool NoData { get; set; } = true;

    private RunCheckResult? CheckResult { get; set; }
    private RunPlanningView? Planning;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.CompletedTask;
        }
    }

    public async Task LoadDataAsync (
        Guid runId,
        bool isAdding = false)
    {
        this.RunId = runId;
        this.IsAdding = isAdding;

        // se il guid è empty non tenta neanche ilc aricamento e segna subito che non ci sono dati
        if (this.RunId == Guid.Empty)
        {
            this.NoData = true;
            this.IsClean = true;
            this.IsAdding = false;
            return;
        }

        try
        {
            if (this.IsAdding == false)
            {
                var run = await _repo.GetOneAsync(this.RunId);
                if (run != null)
                {
                    this.CurrentRun = run;
                    this.IsClean = true;
                    this.CheckResult = await this.runChecker.CheckRunAsync(this.CurrentRun);
                    this.NoData = false;
                }
            }
            else
            {
                var contr = this.GlobalFilters.Contract;
                if (contr != null)
                {
                    // s mette in modalità ADD new
                    var contract = new Contract()
                    {
                        ContractId = contr.Id,
                        ContractName = contr.ContractName,
                        ContractDescription = contr.ContractDescription,

                        StartDate = contr.StartDate,
                        EndDate = contr.EndDate
                    };

                    // crea un nuovo run e lo piazza nel current run
                    var run = this.RunModelService.CreateNewRun(
                        contract,
                        this.RunId);

                    this.CurrentRun = run;
                    this.IsClean = true;
                    this.CheckResult = await this.runChecker.CheckRunAsync(this.CurrentRun);
                    this.NoData = false;
                }
                else
                {
                    this.NoData = true;
                    this.notificationService.Notify(NotificationSeverity.Warning, "Selezionare un appalto prima di aggiungere una corsa");
                }
            }
        }
        catch (Exception exc)
        {
            this.notificationService.Notify(NotificationSeverity.Error, "Errore caricando i dati", exc.Message);
            this.NoData = true;
        }
        finally
        {
            this.IsBusy = false;
            this.StateHasChanged();
        }
    }

    private async Task Save_Click()
    {
        await Task.CompletedTask;
        IsSaving = true;

        try
        {
            this.CheckResult = await this.runChecker.CheckRunAsync(this.CurrentRun);
            if (this.CheckResult.Status != CheckStatus.Success)
            {
                this.TabSelectedIndex = 0;
            }

            await this._repo.SaveRunAsync(
                this.RunId, this.CurrentRun);
            this.IsAdding = false;
            this.IsClean = true;

            // segnala che tutto è andato OK
            this.notificationService.Notify(
                NotificationSeverity.Success,
                "Salvataggio",
                "Salvataggio dati corsa OK"
            );

            
            if (this.Planning != null)
            {
                await this.Planning.ReloadDataAsync();
            }
            
            await this.RaiseSavedEvent();
        }
        catch (BadRequestException<RunCheckResult> ex)
        {
            this.CheckResult = ex.Payload;
            this.TabSelectedIndex = 0;

            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Dati non corretti",
                "verificare i dati prima di procedere con il salvataggio"
            );
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "Salvataggio corsa Fallito !",
                ex.Message
            );
        }
        finally
        {
            IsSaving = false;
            this.StateHasChanged();
        }
    }

    /*
    private void Btn_Click()
    {
        this.IsClean = !IsClean;
        this.EditMode = !this.EditMode;
        this.StateHasChanged();
    }
    */
}