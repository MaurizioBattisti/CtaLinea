@using CtaLineaApp.Components.Base

@using CtaLineaApp.Pages.Runs.Dialogs
@inject IRunModelService RunModelService
@inject DialogService DialogService
@inject NotificationService notificationService

<RadzenTemplateForm Data="@CurrentRun"
					Submit="@((RunItem args) => { ; })" >
	<Animate IsManual="false"
			 Animation="Animations.ZoomIn"
			 Easing="Easings.Ease"
			 Duration="TimeSpan.FromSeconds(0.5)">

		<RadzenDataGrid @ref="PeriodGrid"  
			AllowGrouping="true" AllowFiltering="true" AllowSorting="true"
			AllowColumnResize=true
			Data="@CurrentRun.SubPeriods" 
			SelectionMode="DataGridSelectionMode.Single"
			@bind-Value=@SelectedPeriods
			TItem="RunPeriod" Render="@OnRender" 
			GroupRowRender="OnGroupRowRender">
			
			<HeaderTemplate>
				<RadzenButton Click=@AddPeriod_Click Text="Nuovo Periodo" Icon="add" />
			</HeaderTemplate>

			<Columns>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Monday" Title="Lunedì" Width="100px">
					<Template Context="data">
						@if (data.Monday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Tuesday" Title="Martedì" Width="100px">
					<Template Context="data">
						@if (data.Tuesday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Wednesday" Title="Mercoledì" Width="100px">
					<Template Context="data">
						@if (data.Wednesday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Thursday" Title="Giovedì" Width="100px">
					<Template Context="data">
						@if (data.Thursday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Friday" Title="Venerdì" Width="100px">
					<Template Context="data">
						@if (data.Friday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Saturday" Title="Sabato" Width="100px">
					<Template Context="data">
						@if (data.Saturday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Sunday" Title="Domenica" Width="100px">
					<Template Context="data">
						@if (data.Sunday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="RunPeriod" Property="MainPeriodText" Width="250px" Title="Gruppo" />

				<RadzenDataGridColumn TItem="RunPeriod" Context="group" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
					<Template Context="data">
						<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
									  Icon="edit"
									  Size="ButtonSize.Medium"
									  Click=@(() => EditPeriod_Click(data)) Text="" />
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
									  Icon="delete"
									  Size="ButtonSize.Medium"
									  Click=@(() => DeletePeriod_Click(data)) Text="" />
					</Template>
				</RadzenDataGridColumn>
			</Columns>
		</RadzenDataGrid>

		@if (this.SelectedPeriods.Count > 0)
		{
			<RadzenTabs TabPosition="TabPosition.Top">
				<Tabs>
					<RadzenTabsItem Text="Mezzi usati" Selected=true >
						<RunCarListView2 CurrentRun=@CurrentRun 
									 EditableData=@EditableData 
									 CarList="@this.GetSelectedPeriod().Cars"  
									 BeforeAddNew="@BeforeAddCarAsync"
									 AfterAddNew="@AfterAddCarAsync"
									 BeforeUpdate="@BeforeUpdateCarAsync"
									 AfterUpdate="@AfterUpdateCarAsync"
									 BeforeDelete="@BeforeDeleteCarAsync"
									 AfterDelete="@AfterDeleteCarAsync"
									 CanChangeData=true
									 HandleReplacedCars=false />
					</RadzenTabsItem>
					<RadzenTabsItem Text="Sostituzioni" >
						<RunCarReplacementListView CurrentRun=@CurrentRun EditableData=@EditableData Period="@GetSelectedPeriod()" />
					</RadzenTabsItem>
					<RadzenTabsItem Text="Note Periodo" >
						<RadzenRow AlignItems="AlignItems.Start">
							<RadzenColumn Size="3">
								<RadzenLabel Component="Note" Text="Note" />
							</RadzenColumn>
							<RadzenColumn Size="9">
								<RadzenTextArea Name="Note" @bind-Value="CurrentPeriod.Note" Class="w-100 h-100" Change=@(a=> this.EditableData?.SetDirty()) Style="height: 60px" />
							</RadzenColumn>
						</RadzenRow>
					</RadzenTabsItem>
				</Tabs>
			</RadzenTabs>
		}
	</Animate>
</RadzenTemplateForm>

<DialogBoxWrapper @ref=@PeriodDlg
	Width="400px"
	Title="Periodo Mezzi">
	<Body Context="ds">
		<RadzenRow>
			<RadzenColumn Size="7">
				<DateRangeSelector
					@bind-StartDate=@this.PeriodInEdit.StartDate
					@bind-EndDate=@this.PeriodInEdit.EndDate 
					Inline=false
					AllowClear=true
					/>
			</RadzenColumn>
			<RadzenColumn Size="5">
				<FormWeekDays @bind-Monday="@this.PeriodInEdit.Monday"
							  @bind-Tuesday="@this.PeriodInEdit.Tuesday"
							  @bind-Wednesday="@this.PeriodInEdit.Wednesday"
							  @bind-Thursday="@this.PeriodInEdit.Thursday"
							  @bind-Friday="@this.PeriodInEdit.Friday"
							  @bind-Saturday="@this.PeriodInEdit.Saturday"
							  @bind-Sunday="@this.PeriodInEdit.Sunday" />
			</RadzenColumn>
		</RadzenRow>
	</Body>
	<Buttons Context="ds">
		@if (this.IsAdding == true)
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateReplacementASync(ds))"
					  Text="Crea" />
		}
		else
		{
			<RadzenButton Click="@(() => this.ConfirmUpdateReplacementASync(ds))"
					  Text="Aggiorna" />

		}
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</Buttons>
</DialogBoxWrapper>

@code {
	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	private IList<RunPeriod> SelectedPeriods = new List<RunPeriod>();
	private RadzenDataGrid<RunPeriod>? PeriodGrid;

	void OnRender(DataGridRenderEventArgs<RunPeriod> args)
	{
		if (args.FirstRender)
		{
			// seleziona il peridoo attivo se esite
			this.SelectCurrentPeriod();

			args.Grid.Groups.Add(new GroupDescriptor() { Title = "Gruppo", Property = nameof(RunPeriod.MainPeriodText), SortOrder = SortOrder.Ascending });
			StateHasChanged();
		}
	}

	private void SelectCurrentPeriod ()
	{
		this.SelectedPeriods.Clear();
		if (this.CurrentRun.SubPeriods != null)
		{
			var period = (from p in this.CurrentRun.SubPeriods
								where (p.StartDate == null || p.StartDate.Value <= DateTime.Today)
									&& (p.EndDate == null || p.EndDate.Value >= DateTime.Today)
								orderby p.StartDate ascending
								select p)
					.FirstOrDefault();

			if (period != null)
			{
				this.SelectedPeriods.Add(period);
				this.PeriodGrid?.SelectRow(period);
			}
		}
	}

	private RunPeriod CurrentPeriod
	{
		get { return this.SelectedPeriods.First(); }
	}

	void OnGroupRowRender(GroupRowRenderEventArgs args)
	{
		args.Expanded = true;
	}

	private RunPeriod GetSelectedPeriod ()
	{
		var item = this.SelectedPeriods.FirstOrDefault();
		return item ?? new RunPeriod();
	}

	#region gestione dielog periodi
	private DialogBoxWrapper? PeriodDlg;
	private bool IsAdding = false;
	private RunPeriod PeriodInEdit = new RunPeriod();

	private async Task AddPeriod_Click()
	{
		var period = new RunPeriod ()
		{
			RunPeriodId = Guid.NewGuid()
		};

		this.IsAdding = true;
		this.PeriodInEdit = period;
		if (this.PeriodDlg != null)
		{
			await this.PeriodDlg.ShowDialog("Nuovo periodo");
		}
	}
	public async Task EditPeriod_Click(RunPeriod item)
	{
		var period = new RunPeriod();
		period.CopyFrom(item);

		this.IsAdding = false;
		this.PeriodInEdit = period;
		if (this.PeriodDlg != null)
		{
			await this.PeriodDlg.ShowDialog("Nuovo periodo");
		}
	}
	public async Task DeletePeriod_Click(RunPeriod item)
	{
		// chiede conferma per la cancellaizone
		if (await this.DialogService.Confirm(
			"Desideri veramente eliminare il periodo di operatività ? Eliminando il periodo verranno persi tutti i dati relativi ai mezzi , sostituzioni e soti associati a questo peridoo",
			"Eliminaizone Periodo",
			new ConfirmOptions
				{
					OkButtonText = "Si, Elimina",
					CancelButtonText = "No"
				}) != true)
		{
			return;
		}

		if (this.CurrentRun.SubPeriods != null)
		{
			this.CurrentRun.SubPeriods.Remove(item);
			this.EditableData?.SetDirty();
			if (PeriodGrid != null)
			{
				await this.PeriodGrid.Reload();
			}
			this.SelectCurrentPeriod();
		}
	}

	private async Task ConfirmUpdateReplacementASync (DialogService  ds)
	{
		var msg = string.Empty;

		// esegue il contorllo dei dati
		if (this.PeriodInEdit.StartDate  != null
			&& this.PeriodInEdit.EndDate != null
			&& this.PeriodInEdit.StartDate >= this.PeriodInEdit.EndDate)
		{
			// le date sono incongruenti
			msg += "Le date sono incongruenti tra loro. ";
		}
		if (this.PeriodInEdit.Monday == false
			&& this.PeriodInEdit.Tuesday == false
			&& this.PeriodInEdit.Wednesday == false
			&& this.PeriodInEdit.Thursday == false
			&& this.PeriodInEdit.Friday == false
			&& this.PeriodInEdit.Saturday == false
			&& this.PeriodInEdit.Sunday == false)
		{
			// nessun giorno selezionato
			msg += "Deve essere selezionato almeno un giorno della settimana.";
		}
		if (string.IsNullOrEmpty(msg) == false)
		{
			await this.DialogService.Alert(msg, "dati periodo");
			return;
		}

		// aggiunge o aggiorna i dati
		if (this.IsAdding == true)
		{
			// nuovo periodo
			if (this.CurrentRun.SubPeriods == null) this.CurrentRun.SubPeriods = new List<RunPeriod>();
			this.CurrentRun.SubPeriods.Add(this.PeriodInEdit);

			// aggiorna la lista e  seleziona la riga appena aggiunta
			if (this.PeriodGrid != null)
			{
				await this.PeriodGrid.Reload();
				await this.PeriodGrid.SelectRow(this.PeriodInEdit);
			}
		}
		else
		{
			// aggiorna
			CurrentPeriod.CopyFrom(this.PeriodInEdit);
		}
		this.EditableData?.SetDirty();
		ds.Close();
	}

	#endregion

	#region  Add car
	private async Task BeforeAddCarAsync (BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		// controlla se il mezzo può essere aggiunto
		if (this.CurrentPeriod.Cars != null)
		{
			if ((from c in this.CurrentPeriod.Cars
					where c.CarId == beforeAction.Item.CarId
						&& c.RunCarId != beforeAction.Item.RunCarId
					select c).Count() > 0)
			{
				// il mezzo è già stato assegnao al periodo
				await DialogService.Alert("Questo mezzo è già stato aggiunto, impossibile aggiungere lo stesso mezzo", "Errore Nuovo Mezzo");
				beforeAction.Cancelled = true;
				return;
			}
		}

		await Task.CompletedTask;
	}
	private async Task AfterAddCarAsync(RunPeriodCar item)
	{
		if (this.CurrentPeriod.Cars == null)
		{
			this.CurrentPeriod.Cars = new List<RunPeriodCar>();
		}
		this.CurrentPeriod.Cars.Add(item);
		this.EditableData?.SetDirty();
		await Task.CompletedTask;
	}
	#endregion
	#region update car
	private async Task BeforeUpdateCarAsync(BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		// controlla se il mezzo può essere aggiunto
		if (this.CurrentPeriod.Cars != null)
		{
			if ((from c in this.CurrentPeriod.Cars
					where c.CarId == beforeAction.Item.CarId
						&& c.RunCarId != beforeAction.Item.RunCarId
					select c).Count() > 0)
			{
				// il mezzo è già stato assegnao al periodo
				await DialogService.Alert("Questo mezzo è già stato usato, impossibile selezionare lo stesso mezzo", "Errore modifica mezzo");
				beforeAction.Cancelled = true;
				return;
			}
		}
		// recupera il mezzo corrente
		if (this.CurrentPeriod.Cars != null)
		{
			var car = this.CurrentPeriod.Cars.Where(c => c.RunCarId == beforeAction.Item.RunCarId).SingleOrDefault();
			if (car != null)
			{
				// se è stato modificato il tipo di mezzo chiede conferma
				if (beforeAction.Item.RunCarType != car.RunCarType
					&& beforeAction.Item.RunCarType == CarTypeEnum.Spare
					&& car.RunCarType != CarTypeEnum.Spare
					)
				{
					var answer = await this.DialogService.Confirm(
						"Sei sicuro di voler cambiare il tipo del mezzo ?  modificando il tipo del mezzo si perderanno tutit i costi ad esso associati", 
						"Modifica tipo mezzo", 
						new ConfirmOptions { OkButtonText = "Si", CancelButtonText = "No" }
						);
					if (answer != true) beforeAction.Cancelled = true;
				}
			}
		}

		await Task.CompletedTask;
	}
	private async Task AfterUpdateCarAsync(RunPeriodCar item)
	{
		if (this.CurrentPeriod.Cars != null)
		{
			var car = this.CurrentPeriod.Cars.Where(c => c.RunCarId == item.RunCarId).SingleOrDefault();
			if (car != null)
			{
				car.RunCarType = item.RunCarType;

				car.AssociateId = item.AssociateId;
				car.AssociateData = item.AssociateData;
				car.CarId = item.CarId;
				car.CarData = item.CarData;

				// se il tipo è scorta azzera la lista dei costi
				if (car.RunCarType == CarTypeEnum.Spare) car.CarCosts = new List<RunCarCost>();

				this.EditableData?.SetDirty();
			}
		}
		await Task.CompletedTask;
	}
	#endregion
	#region delete car
	private async Task BeforeDeleteCarAsync(BeforeActOnItemArgs<RunPeriodCar> beforeAction)
	{
		// controlla che il mezzo non sia usato  nella lista di quelli sostituiti
		if (CurrentPeriod.CarReplacements != null)
		{
			bool found = false;
			foreach (var repl in CurrentPeriod.CarReplacements)
			{
				if (repl.OriginalPEriodCarIds == null) continue;
				if (repl.OriginalPEriodCarIds.Contains(beforeAction.Item.RunCarId) == true)
				{
					found = true;
					break;
				}
			}
			if (found == true)
			{
				// mostra un messaggio che indica che non è possibile eliminare il mezzo
				await DialogService.Alert("Il mezzo che si sta cancellado è stato già usato come mezzo originale in una sostituzione. Eliminare prima il mezzo dalla sostituzione, cambiarlo oppure eliminare la sostituzione prima di procedere con l'eleiminaizone del mezzo.");
				beforeAction.Cancelled = true;
				return;
			}
		}
		// chiede conferma per la cancellazione dei costi nel caso ci siano dei costi associati
		if (CurrentPeriod.Cars != null)
		{
			var car = this.CurrentPeriod.Cars.Where(c => c.RunCarId == beforeAction.Item.RunCarId).SingleOrDefault();
			if (car != null)
			{
				// se è stato modificato il tipo di mezzo chiede conferma
				if (car.RunCarType != CarTypeEnum.Spare
					&& (car.CarCosts != null 
						&& car.CarCosts.Count > 0
					))
				{
					var answer = await this.DialogService.Confirm(
						"Sei sicuro di voler eliminare il mezzo ? Eliminando il mezzo verranno persi anche tutti i costi associati.",
						"Eliminazione mezzo",
						new ConfirmOptions { OkButtonText = "Si, Elimina", CancelButtonText = "No" }
						);
					if (answer != true) beforeAction.Cancelled = true;
				}
			}
		}
	}
	private async Task AfterDeleteCarAsync(RunPeriodCar item)
	{
		if (this.CurrentPeriod.Cars != null)
		{
			this.CurrentPeriod.Cars.Remove(item);
			this.EditableData?.SetDirty();
		}
		await Task.CompletedTask;
	}
	#endregion

	/*
	private IList<RunPeriodGroup> PeriodGroupList { get; set; } = new List<RunPeriodGroup>();
	private IList<RunPeriodGroup> SelectedPeriodGroups { get; set; } = new List<RunPeriodGroup>();
	
	private RunPeriodGroup? CurrentPeriodGroup { get; set; }

	private void SelectPeriodGroup (RunPeriodGroup? item)
	{
		this.SelectedPeriodGroups.Clear();
		if (item != null)
		{
			this.SelectedPeriodGroups.Add(item);
		}
	}
	private void SelectPEriod(RunPeriod? item)
	{
		this.SelectedPeriods.Clear();
		if (item != null)
		{
			this.SelectedPeriods.Add(item);
		}
	}

	private string FormatDate(
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format("{0:dd/MM/yyyy}", date);
	}

	protected override async Task OnParametersSetAsync()
	{
		this.PeriodGroupList = GetPeriodGroups();

		this.SelectCurrentGroup();

		await base.OnParametersSetAsync();
	}

	private void SelectCurrentGroup()
	{
		// seleziona un period appropriato
		this.CurrentPeriodGroup = (from pg in this.PeriodGroupList
											where pg.StartDate == null || pg.StartDate <= DateTime.Today
											orderby pg.StartDate descending
											select pg).FirstOrDefault();
	}
	private void SelectSpecificPEriod(
	DateTime? startDate,
	DateTime? endDate)
	{
		this.CurrentPeriodGroup = (from pg in this.PeriodGroupList
											where pg.StartDate == startDate
										&& pg.EndDate == endDate
											select pg).FirstOrDefault();
	}

	private IList<RunPeriodGroup> GetPeriodGroups()
	{
		if (this.CurrentRun != null)
		{
			return this.RunModelService.GetPeriodGroups(this.CurrentRun);
		}
		return new List<RunPeriodGroup>();
	}

	private async Task AddPeriod_Click()
	{
		string title = "Nuoov periodo";
		var periodGroup = new RunPeriodGroup()
				{
					StartDate = null,
					EndDate = null
				};
		var result = await this.AskPeriodGroup(
		title,
		"Crea Periodo",
		periodGroup);
		if (result == true)
		{
			bool addNew = false;
			// controlla i valorei immessi
			if (PeriodGroupList != null)
			{
				var per = (from p in this.PeriodGroupList
									where p.StartDate == periodGroup.StartDate
									&& p.EndDate == periodGroup.EndDate
									select p).FirstOrDefault();
				if (per != null)
				{
					// indica che non è possibile aggiungere un periodo identico a quello già presente
					this.notificationService.Notify(
					NotificationSeverity.Warning,
					title,
					"Non è possibile inserire un periodoo già esistenete, almeno una delle due date deve essere differente.");
				}
				else
				{
					addNew = true;
				}
			}
			else
			{
				addNew = true;
			}

			if (addNew == true)
			{
				if (this.PeriodGroupList == null) this.PeriodGroupList = new List<RunPeriodGroup>();

				var period = this.RunModelService.CreateNewPeriod(
				this.CurrentRun,
				periodGroup.StartDate,
				periodGroup.EndDate);
				periodGroup.SubPeriods.Add(period);
				this.PeriodGroupList.Add(periodGroup);
				this.CurrentPeriodGroup = periodGroup;
				this.EditableData?.SetDirty();
			}
		}
	}
	private async Task DEditPeriod_Click(RunPeriod item)
	{
		if (this.CurrentPeriodGroup != null)
		{
			string title = "Modifica periodo";
			var periodGroup = new RunPeriodGroup()
					{
						StartDate = CurrentPeriodGroup.StartDate,
						EndDate = CurrentPeriodGroup.EndDate
					};
			var result = await this.AskPeriodGroup(
			title,
			"Cambia Date",
			periodGroup);

			if (result == true)
			{
				// controlla che il periodo non vada a sovrapporsi con un'altro
				var other = (from p in this.PeriodGroupList
								where p.StartDate == periodGroup.StartDate
							&& p.EndDate == periodGroup.EndDate
							&& p != this.CurrentPeriodGroup
								select p).FirstOrDefault();
				if (other != null)
				{
					// indica che non è possibile aggiungere un periodo identico a quello già presente
					this.notificationService.Notify(
					NotificationSeverity.Warning,
					title,
					"Non è possibile assenare le stesse date di un altro epridoo almeno una deve essere diversa.");
				}
				else
				{
					if (this.CurrentRun.SubPeriods != null)
					{
						// modifica tutte le date dei periodi
						var toChange = (from p in this.CurrentRun.SubPeriods
										where p.StartDate == this.CurrentPeriodGroup.StartDate
									&& p.EndDate == this.CurrentPeriodGroup.EndDate
										select p).ToList();
						foreach (var p in toChange)
						{
							p.StartDate = periodGroup.StartDate;
							p.EndDate = periodGroup.EndDate;
						}

						this.PeriodGroupList.Remove(this.CurrentPeriodGroup);
						this.PeriodGroupList.Add(periodGroup);
						this.CurrentPeriodGroup = periodGroup;
						this.EditableData?.SetDirty();
					}
				}
			}
		}
	}
	private async Task DeletePeriod_Click(RunPeriod item)
	{
		var period = this.CurrentPeriodGroup;
		if (period != null)
		{
			// chiede conferma per la cancellazione del periodo selezionato
			var result = await DialogService.Confirm(
			string.Format("Desideri veramente eliminare il periodo {0} ? tutti i dati associati saranno persi", period.ToString()),
			"Elimina gruppo",
			new ConfirmOptions
					{
						OkButtonText = "Si, Elimina il periodo !",
						CancelButtonText = "No ! Annulla"
					});

			if (result == true)
			{
				// elimina tutti i sottoperiodi dalla corsa che corrispondono al gruppo
				if (this.CurrentRun.SubPeriods != null)
				{
					var toDelo = (from p in this.CurrentRun.SubPeriods
										where p.StartDate == period.StartDate
										&& p.EndDate == period.EndDate
										select p).ToList();

					foreach (var p in toDelo)
					{
						CurrentRun.SubPeriods.Remove(p);
					}
					this.PeriodGroupList.Remove(this.CurrentPeriodGroup);
					this.SelectCurrentGroup();
					this.EditableData?.SetDirty();
				}
			}
		}
	}
	private async Task<bool> AskPeriodGroup(
	string title,
	string okText,
	RunPeriodGroup periodGroup)
	{
		return await ShowGenericDialog(
		title,
		ds =>
	@<div>
		<RunPeriodGroupEditDialog PeriodGroup=@periodGroup
							  MinDate=@this.RunModelService.GetMinValidDate(this.CurrentRun, DateTime.MinValue)
							  MaxDate=@(this.RunModelService.GetMaxValidDate(this.CurrentRun, DateTime.MaxValue)) />
	</div>
		, okText
		);
