@using CtaLineaApp.Components.Base

@using CtaLineaApp.Pages.Runs.Dialogs
@inject IRunModelService RunModelService
@inject DialogService DialogService
@inject NotificationService notificationService

<RadzenTemplateForm Data="@CurrentRun"
					Submit="@((RunItem args) => { ; })" >
	<Animate IsManual="false"
			 Animation="Animations.ZoomIn"
			 Easing="Easings.Ease"
			 Duration="TimeSpan.FromSeconds(0.5)">

		<RadzenDataGrid @ref="ordersGrid"  
			AllowGrouping="true" AllowFiltering="true" AllowSorting="true" 
			Data="@CurrentRun.SubPeriods" 
			SelectionMode="DataGridSelectionMode.Single"
			@bind-Value=@SelectedPeriods
			TItem="RunPeriod" Render="@OnRender" 
			GroupRowRender="OnGroupRowRender">
			
			<HeaderTemplate>
				<RadzenButton Click=@AddPeriod_Click Text="Nuovo Periodo" />
			</HeaderTemplate>

			<Columns>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Monday" Title="Lunedì" Width="100px">
					<Template Context="data">
						@if (data.Monday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Tuesday" Title="Martedì" Width="100px">
					<Template Context="data">
						@if (data.Tuesday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Wednesday" Title="Mercoledì" Width="100px">
					<Template Context="data">
						@if (data.Wednesday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Thursday" Title="Giovedì" Width="100px">
					<Template Context="data">
						@if (data.Thursday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Friday" Title="Venerdì" Width="100px">
					<Template Context="data">
						@if (data.Friday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Saturday" Title="Sabato" Width="100px">
					<Template Context="data">
						@if (data.Saturday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="RunPeriod" Property="Sunday" Title="Domenica" Width="100px">
					<Template Context="data">
						@if (data.Sunday)
						{
							<RadzenIcon Icon="check" />
						}
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="RunPeriod" Property="MainPeriodText" Width="250px" Title="Gruppo" />

				<RadzenDataGridColumn TItem="RunPeriod" Context="group" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
					<Template Context="data">
						<RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
									  Icon="edit"
									  Size="ButtonSize.Medium"
									  Click=@(() => DEditPeriod_Click(data)) Text="" />
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
									  Icon="delete"
									  Size="ButtonSize.Medium"
									  Click=@(() => DeletePeriod_Click(data)) Text="" />
					</Template>
				</RadzenDataGridColumn>
			</Columns>
		</RadzenDataGrid>
		 
	</Animate>
</RadzenTemplateForm>

<RadzenTabs TabPosition="TabPosition.Top"
			RenderMode="TabRenderMode.Client">
	<Tabs>
		<RadzenTabsItem Text="Mezzi usati" Selected=true >

		</RadzenTabsItem>
		<RadzenTabsItem Text="Sostituzioni" >

		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>

@code {
	private RadzenDataGrid<RunPeriod>? ordersGrid;



	void OnRender(DataGridRenderEventArgs<RunPeriod> args)
	{
		if (args.FirstRender)
		{
			args.Grid.Groups.Add(new GroupDescriptor() { Title = "Gruppo", Property = nameof(RunPeriod.MainPeriodText), SortOrder = SortOrder.Ascending });
			StateHasChanged();
		}
	}

	void OnGroupRowRender(GroupRowRenderEventArgs args)
	{
		args.Expanded = true;
	}


	[Parameter]
	public IEditableData? EditableData { get; set; }

	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();

	private IList<RunPeriodGroup> PeriodGroupList { get; set; } = new List<RunPeriodGroup>();
	private IList<RunPeriodGroup> SelectedPeriodGroups { get; set; } = new List<RunPeriodGroup>();
	private IList<RunPeriod> SelectedPeriods { get; set; } = new List<RunPeriod>();

	private RunPeriodGroup? CurrentPeriodGroup { get; set; }

	private void SelectPeriodGroup (RunPeriodGroup? item)
	{
		this.SelectedPeriodGroups.Clear();
		if (item != null)
		{
			this.SelectedPeriodGroups.Add(item);
		}
	}
	private void SelectPEriod(RunPeriod? item)
	{
		this.SelectedPeriods.Clear();
		if (item != null)
		{
			this.SelectedPeriods.Add(item);
		}
	}

	private string FormatDate(
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format("{0:dd/MM/yyyy}", date);
	}

	protected override async Task OnParametersSetAsync()
	{
		this.PeriodGroupList = GetPeriodGroups();

		this.SelectCurrentGroup();

		await base.OnParametersSetAsync();
	}

	private void SelectCurrentGroup()
	{
		// seleziona un period appropriato
		this.CurrentPeriodGroup = (from pg in this.PeriodGroupList
											where pg.StartDate == null || pg.StartDate <= DateTime.Today
											orderby pg.StartDate descending
											select pg).FirstOrDefault();
	}
	private void SelectSpecificPEriod(
	DateTime? startDate,
	DateTime? endDate)
	{
		this.CurrentPeriodGroup = (from pg in this.PeriodGroupList
											where pg.StartDate == startDate
										&& pg.EndDate == endDate
											select pg).FirstOrDefault();
	}

	private IList<RunPeriodGroup> GetPeriodGroups()
	{
		if (this.CurrentRun != null)
		{
			return this.RunModelService.GetPeriodGroups(this.CurrentRun);
		}
		return new List<RunPeriodGroup>();
	}

	private async Task AddPeriod_Click()
	{
		string title = "Nuoov periodo";
		var periodGroup = new RunPeriodGroup()
				{
					StartDate = null,
					EndDate = null
				};
		var result = await this.AskPeriodGroup(
		title,
		"Crea Periodo",
		periodGroup);
		if (result == true)
		{
			bool addNew = false;
			// controlla i valorei immessi
			if (PeriodGroupList != null)
			{
				var per = (from p in this.PeriodGroupList
									where p.StartDate == periodGroup.StartDate
									&& p.EndDate == periodGroup.EndDate
									select p).FirstOrDefault();
				if (per != null)
				{
					// indica che non è possibile aggiungere un periodo identico a quello già presente
					this.notificationService.Notify(
					NotificationSeverity.Warning,
					title,
					"Non è possibile inserire un periodoo già esistenete, almeno una delle due date deve essere differente.");
				}
				else
				{
					addNew = true;
				}
			}
			else
			{
				addNew = true;
			}

			if (addNew == true)
			{
				if (this.PeriodGroupList == null) this.PeriodGroupList = new List<RunPeriodGroup>();

				var period = this.RunModelService.CreateNewPeriod(
				this.CurrentRun,
				periodGroup.StartDate,
				periodGroup.EndDate);
				periodGroup.SubPeriods.Add(period);
				this.PeriodGroupList.Add(periodGroup);
				this.CurrentPeriodGroup = periodGroup;
				this.EditableData?.SetDirty();
			}
		}
	}
	private async Task DEditPeriod_Click(RunPeriod item)
	{
		if (this.CurrentPeriodGroup != null)
		{
			string title = "Modifica periodo";
			var periodGroup = new RunPeriodGroup()
					{
						StartDate = CurrentPeriodGroup.StartDate,
						EndDate = CurrentPeriodGroup.EndDate
					};
			var result = await this.AskPeriodGroup(
			title,
			"Cambia Date",
			periodGroup);

			if (result == true)
			{
				// controlla che il periodo non vada a sovrapporsi con un'altro
				var other = (from p in this.PeriodGroupList
								where p.StartDate == periodGroup.StartDate
							&& p.EndDate == periodGroup.EndDate
							&& p != this.CurrentPeriodGroup
								select p).FirstOrDefault();
				if (other != null)
				{
					// indica che non è possibile aggiungere un periodo identico a quello già presente
					this.notificationService.Notify(
					NotificationSeverity.Warning,
					title,
					"Non è possibile assenare le stesse date di un altro epridoo almeno una deve essere diversa.");
				}
				else
				{
					if (this.CurrentRun.SubPeriods != null)
					{
						// modifica tutte le date dei periodi
						var toChange = (from p in this.CurrentRun.SubPeriods
										where p.StartDate == this.CurrentPeriodGroup.StartDate
									&& p.EndDate == this.CurrentPeriodGroup.EndDate
										select p).ToList();
						foreach (var p in toChange)
						{
							p.StartDate = periodGroup.StartDate;
							p.EndDate = periodGroup.EndDate;
						}

						this.PeriodGroupList.Remove(this.CurrentPeriodGroup);
						this.PeriodGroupList.Add(periodGroup);
						this.CurrentPeriodGroup = periodGroup;
						this.EditableData?.SetDirty();
					}
				}
			}
		}
	}
	private async Task DeletePeriod_Click(RunPeriod item)
	{
		var period = this.CurrentPeriodGroup;
		if (period != null)
		{
			// chiede conferma per la cancellazione del periodo selezionato
			var result = await DialogService.Confirm(
			string.Format("Desideri veramente eliminare il periodo {0} ? tutti i dati associati saranno persi", period.ToString()),
			"Elimina gruppo",
			new ConfirmOptions
					{
						OkButtonText = "Si, Elimina il periodo !",
						CancelButtonText = "No ! Annulla"
					});

			if (result == true)
			{
				// elimina tutti i sottoperiodi dalla corsa che corrispondono al gruppo
				if (this.CurrentRun.SubPeriods != null)
				{
					var toDelo = (from p in this.CurrentRun.SubPeriods
										where p.StartDate == period.StartDate
										&& p.EndDate == period.EndDate
										select p).ToList();

					foreach (var p in toDelo)
					{
						CurrentRun.SubPeriods.Remove(p);
					}
					this.PeriodGroupList.Remove(this.CurrentPeriodGroup);
					this.SelectCurrentGroup();
					this.EditableData?.SetDirty();
				}
			}
		}
	}
	private async Task<bool> AskPeriodGroup(
	string title,
	string okText,
	RunPeriodGroup periodGroup)
	{
		return await ShowGenericDialog(
		title,
		ds =>
	@<div>
		<RunPeriodGroupEditDialog PeriodGroup=@periodGroup
							  MinDate=@this.RunModelService.GetMinValidDate(this.CurrentRun, DateTime.MinValue)
							  MaxDate=@(this.RunModelService.GetMaxValidDate(this.CurrentRun, DateTime.MaxValue)) />
	</div>
		, okText
		);
	}

	#region funzioni gestione dialog box
	private async Task<bool> ShowGenericDialog(
	string title,
	RenderFragment<DialogService> renderFragment,
	string okText = "OK",
	string cancelText = "Annulla",
	string width = "1000px")
	{
		bool? result = await DialogService.OpenAsync(
	title,
	ds =>
	@<div>
		@renderFragment(ds)
		<RadzenButton Text="@okText" Click="()=>ds.Close(true)" ButtonStyle="ButtonStyle.Primary" />
		<RadzenButton Text="@cancelText" Click="()=>ds.Close(false)" ButtonStyle="ButtonStyle.Secondary" />
	</div>
	, new DialogOptions() { Width = width }
	);

		return (result != null && result == true);
	}
	#endregion
}
