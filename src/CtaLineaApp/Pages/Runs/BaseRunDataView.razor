@inject IRunModelService RunModelService
@inject DialogService DialogService

<h2>Dati Generali della Corsa</h2>
<RadzenAccordion 
	Multiple="true" >
    <Items>
        <RadzenAccordionItem Text="Informazioni" Icon="info" Selected=true>
			<RadzenCard>
				<div class="d-flex flex-row p-1">
					@if (this.CurrentRun.Extra == true)
					{
						<RadzenIcon Icon="health_and_safety" IconStyle=IconStyle.Warning />
					}
					<div class="col-4">
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Riferimento appalto</RadzenText>
						@if (this.SuperEditMode == true)
						{
							<RadzenText TextStyle="TextStyle.Body1"><strong>@CurrentRun.ContractData?.ContractDescription</strong></RadzenText>
						}
						else
						{
							<RadzenText TextStyle="TextStyle.Body1"><strong>@CurrentRun.ContractData?.ContractDescription</strong></RadzenText>
						}
						
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Riga dell'appalto</RadzenText>
						@if (this.EditMode == true)
						{
							<RadzenTextBox @bind-Value="this.CurrentRun.ContractRowNumber" MaxLength="20"  Class="w-100" />
       
							<div class="row-flex-row">
								<RadzenCheckBox @bind-Value=@this.CurrentRun.Extra  Name="ExtraContract" TValue="bool"  />
								<RadzenLabel Text="Extra Capitolato" Component="Corsa furoi dal conteggio del capitolato di appalto" Style="margin-left: 8px; vertical-align: middle;" />
							</div>
						}
						else
						{
							<RadzenText TextStyle="TextStyle.Body1"><strong>@CurrentRun.ContractRowNumber</strong></RadzenText>
							@if (this.CurrentRun.Extra == true)
							{
								<RadzenText TextStyle="TextStyle.Body1"><strong>Extra capitolato</strong></RadzenText>
							}
						}
						@if(this.EditMode == true)
						{
							// bottone per attivatre disattivare il super edit mode

						}
					</div>
					<div class="col-2">
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Appalto</RadzenText>
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Inizio</RadzenText>
						<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDate(CurrentRun.ContractData?.StartDate)</strong></RadzenText>
						
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Fine</RadzenText>
						<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDate(CurrentRun.ContractData?.EndDate)</strong></RadzenText>
					</div>
					<div class="col-2">
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Cors</RadzenText>
						@if(this.EditMode == true)
						{
							<DateRangeSelector 
								@bind-StartDate="CurrentRun.StartDate"
								@bind-EndDate="CurrentRun.EndDate" 
								Min=@CurrentRun.ContractData?.StartDate
								Max=@CurrentRun.ContractData?.EndDate 
								/>
						}
						else
						{
							<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Inizio</RadzenText>
							<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDate(CurrentRun.StartDate)</strong></RadzenText>
							<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Fine</RadzenText>
							<RadzenText TextStyle="TextStyle.Body1"><strong>@FormatDate(CurrentRun.EndDate)</strong></RadzenText>
						}
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Giorni richiesti</RadzenText>
						@if(this.EditMode == true)
						{
							<RadzenNumeric TValue="int?" @bind-Value="CurrentRun.RequestedDays" Class="w-100" />
						}
						else
						{
							<RadzenText TextStyle="TextStyle.Body1"><strong>@CurrentRun.RequestedDays</strong></RadzenText>
						}
					</div>
					<div class="col-4">
						<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Note</RadzenText>
						@if(this.EditMode == true)
						{
							<RadzenTextArea @bind-Value="CurrentRun.Note" Class="w-100 h-100"  />
						}
						else
						{
							<RadzenText TextStyle="TextStyle.Body1"><strong>@CurrentRun.Note</strong></RadzenText>
						}
					</div>
				</div>
			</RadzenCard>
        </RadzenAccordionItem>

        <RadzenAccordionItem Text="Varianti" Icon="flag_circle" Selected=true>
			<div class="d-flex">
				<div class="col-md-1" >
					<RadzenListBox @bind-Value=@CurrentVariation
								   Data=@GetVariationList()
								   Style="height:250px"
								   Class="w-100">
						<Template>
							@GetVariantDescr((context as RunVariation)?.StartDate))
						</Template>
					</RadzenListBox>
				</div>
				<div class="col-md-11">
					<RunVariationView CurrentRun=@CurrentRun Variation=@CurrentVariation EditMode=@EditMode />
				</div>
			</div>
			@if (this.EditMode == true)
			{
				<RadzenButton Text="Nuova Variante"
						  ButtonStyle="ButtonStyle.Primary"
						  Icon="calendar_month"
						  Click=@AddVariation_Click />
			}
		</RadzenAccordionItem>
    </Items>
</RadzenAccordion>

<h2>Periodi di attività dei mezzi</h2>
<RunPeriodGroupListView CurrentRun=@CurrentRun EditMode=@EditMode /> 

@if (this.Suspensions.Count > 0)
{
	<h2>Sospensioni del servizio</h2>
<RadzenAccordion 
	Multiple="true" >
    <Items>
	@foreach(var s in this.Suspensions)
	{
		<RadzenAccordionItem Text="@this.GetSuspensionHeader(s)" Icon="block" >
			<RunSuspnesionView CurrentRun=@CurrentRun EditMode=@EditMode Suspension=@s />	
		</RadzenAccordionItem>
	}
	</Items>
</RadzenAccordion>
}
@code {
	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public bool EditMode { get; set; } = false;
	private bool SuperEditMode = false;

	public RunVariation CurrentVariation { get; set; } = new RunVariation();

	private IList<RunSuspension> Suspensions = new List<RunSuspension>();

	protected override async Task OnInitializedAsync()
	{

		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// recupera la variante di default
		if (this.CurrentRun !=null)
		{
			var variation = this.GetVariationList().FirstOrDefault();
			if (variation == null) variation = new RunVariation();
			this.CurrentVariation = variation;

			if(this.CurrentRun.Suspensions != null)
			{
				var susp = (from s in this.CurrentRun.Suspensions
							orderby s.StartDate
							select s)
						.ToList();

				if (susp != null)
				{
					this.Suspensions = susp;
				}
			}
		}
		await base.OnParametersSetAsync();
	}

	private IEnumerable<RunVariation> GetVariationList ()
	{
		if (this.CurrentRun?.Variations == null) return null;
		var qry = (from v in this.CurrentRun.Variations
							where v.StartDate == null
							select v
					);
		var qry2 = (from v in this.CurrentRun.Variations
					where v.StartDate != null
					orderby v.StartDate ascending
					select v
				);
		return qry.Union(qry2).ToList();
	}

	private string GetSuspensionHeader (
		RunSuspension suspension)
	{
		return string.Format("dal {0:dd/MM/yyyy} - al {1:dd/MM/yyyy}",
			suspension.StartDate,
			suspension.EndDate
			);
	}

	private string GetVariantDescr (
		DateTime? date)
	{
		var descr = FormatDate(date);
		if (string.IsNullOrEmpty(descr) == true)
		{
			descr = "Inizale";
		}
		return descr;
	}
	private string FormatDate (
		DateTime? date)
	{
		if (date == null) return string.Empty;
		return string.Format("{0:dd/MM/yyyy}", date);
	}

	void OnTabChange(int index)
	{

	}

	private DateTime? _AskStartDate = null;
	private async Task AddVariation_Click ()
	{
		string title = "Nuova ariante";
		_AskStartDate = null;
		bool? result = await DialogService.OpenAsync(
		title,
			ds =>
			@<div>
				<RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Data di inizio</RadzenText>
				<DateSelector @bind-Value="_AskStartDate" Min=@this.CurrentRun.StartDate Max=this.CurrentRun.EndDate ShowSetTodayButton=true />

				<RadzenButton Text="Ok" Click="()=>ds.Close(true)" ButtonStyle="ButtonStyle.Primary" />
				<RadzenButton Text="Annulla" Click="()=>ds.Close(false)" ButtonStyle="ButtonStyle.Secondary" />
		</div>
	);

		if (result != null && result == true) ;
		{
			var date = _AskStartDate;
			if (date == null)
			{
				await this.DialogService.Alert("Non è possible creare una variante che pata dall'inizio", title);
			}
			else
			{
				// controlla che nonc i siano variazioni che partono alla stessa data
				var already = (from v in this.CurrentRun.Variations
										where v.StartDate == date
										select v).FirstOrDefault ();
				if (already != null)
				{
					await this.DialogService.Alert(string.Format("Esiste già una variante che inizia il {0:dd/MM/yyyy}", date), title);
				}
				else
				{
					// crea la nuova variante
					var newVar = this.RunModelService.CreateNewVariation(this.CurrentRun, date);
					this.CurrentVariation = newVar;
					this.StateHasChanged();
				}
			}
		}
		_AskStartDate = null;
		return;
	}

}
