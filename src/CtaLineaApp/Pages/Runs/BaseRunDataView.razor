@inject IRunService RunService

<h2>Dati Generali della Corsa</h2>
<RadzenAccordion 
	Multiple="true" >
    <Items>
        <RadzenAccordionItem Text="Dati Generali" Icon="assignment" Selected=true>
			<RunVariationView  Variation=@DefaultVariant EditMode=@EditMode />
        </RadzenAccordionItem>

		@if (OtherVariations.Count > 0)
		{
		<RadzenAccordionItem Text="Varianti" Icon="calendar_month">
			<RadzenTabs 
				Change=@OnTabChange 
				TabPosition="TabPosition.Left" 
				Class="w-100 my-1 mx-auto" 
				RenderMode="TabRenderMode.Client" >
					<Tabs>
						@foreach (var v in this.OtherVariations)
						{
							<RadzenTabsItem Text="@string.Format("{0:dd/MM/yyyy}",v.StartDate ?? DateTime.MinValue)">
								<RunVariationView Variation=@v EditMode=@this.EditMode />
							</RadzenTabsItem>
						}
					</Tabs>
			</RadzenTabs>
        </RadzenAccordionItem>
		}
    </Items>
</RadzenAccordion>

<h2>Periodi di attività dei mezzi</h2>
<RunPeriodGroupListView CurrentRun=@CurrentRun EditMode=@EditMode /> 

@if (this.Suspensions.Count > 0)
{
	<h2>Sospensioni del servizio</h2>
<RadzenAccordion 
	Multiple="true" >
    <Items>
	@foreach(var s in this.Suspensions)
	{
		<RadzenAccordionItem Text="@this.GetSuspensionHeader(s)" Icon="block" >
			<RunSuspnesionView CurrentRun=@CurrentRun EditMode=@EditMode Suspension=@s />	
		</RadzenAccordionItem>
	}
	</Items>
</RadzenAccordion>
}
@code {
	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public bool EditMode { get; set; } = false;

	public RunVariation DefaultVariant = new RunVariation();
	public IList<RunVariation> OtherVariations = new List<RunVariation>();

	private IList<RunSuspension> Suspensions = new List<RunSuspension>();

	protected override async Task OnInitializedAsync()
	{

		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// recupera la variante di default
		if (this.CurrentRun !=null)
		{
			var variation = this.RunService.GetDefaultVariation(this.CurrentRun);
			if (variation != null) this.DefaultVariant = variation;

			if (this.CurrentRun.Variations != null)
			{
				this.OtherVariations = this.CurrentRun.Variations.Where(v => v != variation)
					.ToList();
			}

			if(this.CurrentRun.Suspensions != null)
			{
				var susp = (from s in this.CurrentRun.Suspensions
							orderby s.StartDate
							select s)
						.ToList();

		if (susp != null)
				{
					this.Suspensions = susp;
				}
			}
		}
		await base.OnParametersSetAsync();
	}

	private string GetSuspensionHeader (
		RunSuspension suspension)
	{
		return string.Format("dal {0:dd/MM/yyyy} - al {1:dd/MM/yyyy}",
			suspension.StartDate,
			suspension.EndDate
			);
	}

	void OnTabChange(int index)
	{
        
    }
}
