@page "/run-detail/{Id:guid}"
@using CtaLineaApp.Components.Base
@inject IRunRepository _repo
@inject IQueryUtilityService queryService
@inject IRunModelService RunModelService
@inject IContractService ContractService
@inject DialogService DialogService

@inject RouterSessionService RouterSessionService
@inherits EditorComponentBase

@attribute [Authorize]

<PageTitle>@Constants.App_Title - Corsa</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Dati Corsa" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
        
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

@if (IsBusy == true)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <BaseRunDataView CurrentRun=@CurrentRun EditMode=@EditMode />
}

@code {
    [Parameter]
    public Guid Id { get; set; } = Guid.Empty;

    bool EditMode = false;
    RunItem CurrentRun = new RunItem();
    private bool IsBusy = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var run = await _repo.GetOneAsync(this.Id);
                if (run != null)
                {
                    this.CurrentRun = run;
                }
            }
            finally
            {
                this.IsBusy = false;
                this.StateHasChanged();
            }
        }
    }
}