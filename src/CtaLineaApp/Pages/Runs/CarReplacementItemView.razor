@inject IRunModelService RunModelService


<RadzenSplitter Orientation="Orientation.Horizontal" Style="min-height: 350px">
    <RadzenSplitterPane Size="300px">
		<div>
		<p> Originale/i </p>
		<RunCarList CarList=@OriginalCars />
		</div>
	</RadzenSplitterPane>
	<RadzenSplitterPane Size="400px">
		<div>
		<p> Sostituito/i da </p>
		<RunCarList @bind-Value=@CurrentPeriodCar CarList=@GetReplacedCarList() />
		</div>
	</RadzenSplitterPane>
	<RadzenSplitterPane>
		<CarCostListView CurrentRun=@CurrentRun EditMode=@EditMode RunPeriod=@SubPeriod PeriodCar=@CurrentPeriodCar />
	</RadzenSplitterPane>
</RadzenSplitter>

@code {
	[Parameter]
	public RunItem CurrentRun { get; set; } = new RunItem();
	[Parameter]
	public bool EditMode { get; set; } = false;
	[Parameter]
	public RunPeriod SubPeriod { get; set; } = new RunPeriod();
	[Parameter]
	public CarReplacement Replacement { get; set; } = new CarReplacement();

	// lista dei mezzi originali
	private IList<RunPeriodCar> OriginalCars = new List<RunPeriodCar>();
	// lista dei mezzi in sostituzione
	private IList<RunPeriodCar> ReplacingCars = new List<RunPeriodCar>();

	private RunPeriodCar? CurrentPeriodCar { get; set; }

	private IList<RunPeriodCar> GetReplacedCarList ()
	{
		return ReplacingCars;
	}

	protected override async Task OnInitializedAsync()
	{

		await base.OnParametersSetAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		IEnumerable<Guid>? ids = Replacement.OriginalPEriodCarIds;
		if (ids  != null)
		{
			var cars = this.GetRunCars(this.SubPeriod, ids);
			if (cars != null) this.OriginalCars = cars.ToList();
		}
		
		ids = Replacement.ReplacedPEriodCarIds;
		if (ids  != null)
		{
			var cars = this.GetRunCars(this.SubPeriod, ids);
			if (cars != null) this.ReplacingCars = cars.ToList();
		}

		await base.OnParametersSetAsync();
	}

	private IEnumerable<RunPeriodCar> GetRunCars (
		RunPeriod period,
		IEnumerable<Guid> ids)
	{
		var cars = (from c in period.Cars
					where ids.Contains(c.RunCarId)
					select c);
		return cars;
	}
}
