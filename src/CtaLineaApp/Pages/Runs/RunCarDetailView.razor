@using CtaLinea.Model.External;
@inject IRunModelService RunModelService

<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenCard>
	 <div class="d-flex flex-row p-1">
         <RadzenIcon Icon="directions_bus" IconStyle="@GetIconStyle(this.Model)" />

        <div class="col-4">
            <RadzenText TextStyle="TextStyle.Body1"><strong>@GetRunCarTypeDescr(this.Model) </strong></RadzenText>

            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Ditta</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@Model.AssociateData?.Description</strong></RadzenText>

            <RadzenText TextStyle="TextStyle.Overline" Class="d-flex mt-1 mb-0">Mezzo</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><div class=@GetClassByStatus(Model.CarData)><strong>@Model.CarData?.RegNumber </strong></div> </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1"><strong>@Model.CarData?.NrSittings </strong></RadzenText>
        </div>
        @if (this.IsCostVisible())
        {
            <div class="col-8">
                <p>costi dei mezzi</p>
                <RadzenTabs 
	                Change=@OnTabChange 
	                TabPosition="TabPosition.Top" 
	                Class="w-100 my-1 mx-auto" 
	                RenderMode="TabRenderMode.Client" >
	                <Tabs>
                    @foreach (var c in this.Costs)
                    {
                        <RadzenTabsItem Text="@GetCarCostHeader(c)">
                            <CarCostView CurrentRun=@CurrentRun EditMode=@EditMode RunPeriod=@RunPeriod PeriodCar=@Model CarCost=@c />
                        </RadzenTabsItem>
                    }
	                </Tabs>
                </RadzenTabs>
            </div>
        }
    </div>
</RadzenCard>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

    [Parameter]
    public RunItem CurrentRun { get; set; } = new RunItem();
    [Parameter]
    public bool EditMode { get; set; } = false;
    [Parameter]
    public RunPeriod RunPeriod { get; set; } = new RunPeriod();
    [Parameter]
    public RunPeriodCar Model { get; set; } = new RunPeriodCar();
    [Parameter]
    public bool ShowCosts { get; set; } = true;

    IList<RunCarCost> Costs = new List<RunCarCost>();

    protected override async Task OnInitializedAsync()
    {

        await base.OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if ((
                this.Model.RunCarType == CarTypeEnum.Primary
                || this.Model.RunCarType == CarTypeEnum.Replacement
            )
            && (this.Model.CarCosts != null
            && this.Model.CarCosts.Count > 0)
            )
        {
            this.Costs = (from cc in this.Model.CarCosts
                          orderby cc.StartDate
                          select cc
                        ).ToList();
        }
        else
        {
            // TODO: togliere la creazione di costi finti
            this.Costs = new List<RunCarCost>() { new RunCarCost() { DayPrice = 100, KmPrice = 12 } };
        }

        await base.OnParametersSetAsync();
    }

    private IconStyle GetIconStyle (RunPeriodCar car)
    {
        IconStyle style = IconStyle.Danger;

        switch(car.RunCarType)
        {
            case CarTypeEnum.Primary:
                style = IconStyle.Primary;
                break;
            case CarTypeEnum.Replacement:
                style = IconStyle.Warning;
                break;
            case CarTypeEnum.Spare:
                style = IconStyle.Secondary;
                break;
        }

        return style;
    }

    private string GetRunCarTypeDescr (RunPeriodCar car)
    {
        var descr = string.Empty;
        switch(car.RunCarType)
        {
            case CarTypeEnum.Primary:
                descr = "Titolare";
                break;
            case CarTypeEnum.Replacement:
                descr = "Sostituzione";
                break;
            case CarTypeEnum.Spare:
                descr = "Scorta";
                break;
        }
        return descr;
    }

    private string GetCarCostHeader (RunCarCost cost)
    {
        string header = "dall''inizio";
        if (cost.StartDate != null)
        {
            header = string.Format("dal: {0:dd/MM/yyyy}", cost.StartDate);
        }

        return header;
    }

    private bool IsCostVisible ()
    {
        if (ShowCosts == false) return false;
        return Model.RunCarType == CarTypeEnum.Primary || Model.RunCarType == CarTypeEnum.Replacement;
    }

    void OnTabChange(int index)
	{
        
    }

    private string GetClassByStatus(
        Car? car)
    {
        if (car == null) return string.Empty;
        if (car.Active == false ) return this.GetStyle(this.Settings.InactiveCarBgStyle, this.Settings.InactiveCarFgStyle);
        if (car.PrimaryCar) return this.GetStyle(this.Settings.PrimaryCarBgStyle, this.Settings.PrimaryCarFgStyle);
        if (car.SpareCar) return this.GetStyle(this.Settings.SpareCarBgStyle, this.Settings.SpareCarFgStyle);
        return this.GetStyle(this.Settings.OtherCarBgStyle, this.Settings.OtherCarFStyle);
    }

    private string GetStyle(
        params string[] styles)
    {
        var str = string.Join(' ', styles);
        return str.Trim();
    }
}
