@page "/newrun"
@inject IQueryUtilityService queryService
@inject IRunService RunService
@inject IContractService ContractService
@attribute [Authorize]

<h1>Nuova Corsa</h1>
<PageTitle>@Constants.App_Title - Nuova Corsa</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Nuova corsa" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>

    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<BaseRunDataView CurrentRun=@CurrentRun EditMode=@EditMode />

<RadzenButton Click=@Btn_Click Text="Schiza !"></RadzenButton>
<RadzenButton Click=@Btn_2_Click Text="imposta mezzo !"></RadzenButton>

<AssociateAndCarDropDown @bind-AssociateId="yAssociateId" @bind-CarId="MyCarId" AllowClear=true />
<DateRangeSelector @bind-StartDate="MyStart" @bind-EndDate="MyEnd" Inline=true />
<TimeRangeSelector @bind-StartTime="MyStartTime" @bind-EndTime="MyEndTime" Inline=true />

@code {
    bool EditMode = false;

    RunItem CurrentRun = new RunItem();

    protected override async Task OnInitializedAsync()
    {
        if (ContractService.Current != null)
        {
            // chiamare la funzione di RunService che crea il run
            var run= RunService.CreateNewRun(ContractService.Current);

            // TODO: togliere questo codice
            run.ContractId = ContractService.Current.ContractId;
            run.ContractData = ContractService.Current;

            if (run.Variations != null)
            {
                run.Variations[0].StartTime = new TimeSpan(10, 5, 0);
                run.Variations[0].EndTime = new TimeSpan(10, 25, 55);
            }
            var period = run.SubPeriods?[0];
            if (period != null)
            {
                var rc = RunService.CreatePeriodCar(period, CarTypeEnum.Replacement);
                period.CarReplacements?.Add(
                    new CarReplacement()
                    {
                        CarReplacementId = Guid.NewGuid(),
                        StartDate = new DateTime(2022, 11, 01),
                        EndDate = new DateTime(2023, 03, 31),
                        OriginalPEriodCarIds = new List<Guid> () { period.Cars?[0]?.RunPeriodCarId ?? Guid.Empty },
                        ReplacedPEriodCarIds = new List<Guid> () { rc.RunPeriodCarId },
                        Note = "do re mi fa sol"
                    }
                );
            }

            // aggiunge un paiod i sospensioni
            run.Suspensions?.Add(
                new RunSuspension()
                {
                    RunSuspensionId = Guid.NewGuid(),
                    SuspensionNote = "note di sospensione",
                    StartDate = new DateTime (2022, 12, 20),
                    EndDate = new DateTime (2023, 1, 10),
                    SuspensionTypeId= 1,
                    SuspensionTypeData = new  SuspensionType () { SuspensionTypeId = 1, SuspensionTypeDescription = "Una motivazione"}

                });
            run.Suspensions?.Add(
                new RunSuspension()
                {
                    RunSuspensionId = Guid.NewGuid(),
                    SuspensionNote = "for per l'an",
                    StartDate = new DateTime (2023, 4, 12),
                    EndDate = new DateTime (2023, 4, 22),
                    SuspensionTypeId= 2,
                    SuspensionTypeData = new  SuspensionType () { SuspensionTypeId = 2, SuspensionTypeDescription = "Un'altra motivazione"}
                });

            /* fino  a qui */
            this.CurrentRun = run;
        }

        await Task.CompletedTask;
    }

    DateTime? MyStart = null;
    DateTime? MyEnd = null;
    TimeSpan? MyStartTime = null;
    TimeSpan? MyEndTime = null;

    Guid? yAssociateId = null;
    Guid? MyCarId = null;
    private void Btn_Click ()
    {
        this.EditMode = !this.EditMode;
        this.StateHasChanged();
    }
    private void Btn_2_Click ()
    {
        this.MyCarId = new Guid("58E2C252-D8A5-4619-A7F9-019D41195F8D");
        this.yAssociateId = new Guid("3EFD51DE-E4D8-4FC6-820B-064C61A423E8");

        this.StateHasChanged();
    }
}
