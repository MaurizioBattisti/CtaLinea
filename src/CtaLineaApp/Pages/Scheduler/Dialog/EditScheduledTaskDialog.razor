@inject NotificationService _notificationService
@inject DialogService DialogService
@inject IScheduledTasksService _schedulers
@inject ISchedulerTaskChecker _checker

<RadzenStack Orientation="Orientation.Vertical">
	<RadzenTemplateForm Data=@ScheduledTask
						Submit="@((ScheduledTaskItem args) => { ; })">
		<RadzenFieldset Text="Configurazione attività">
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.ActivityId)">Tipo attività</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="9">
					<RadzenDropDown Data="@_schedulers.TaskDescriptions" 
						Placeholder="seleziona l'attività'"
						Disabled=@(this.ScheduledTask.Id != 0)
						Name="@nameof(ScheduledTaskItem.ActivityId)"
						@bind-Value=@this.ScheduledTask.ActivityId
						ValueProperty="@nameof(AppTaskDescription.TaskId)"
						TextProperty="@nameof(AppTaskDescription.TaskName)"
						class="w-100"
					/>
				</RadzenColumn>
			</RadzenRow>
			<RadzenRow AlignItems="AlignItems.Start">
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.Frequency)">Frequenza</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<RadzenDropDown Data="@this.FrequencyList"
									Placeholder="con che frequenza"
									Name="@nameof(ScheduledTaskItem.Frequency)"
									@bind-Value=@this.ScheduledTask.Frequency
									ValueProperty="@nameof(Tuple<ScheduleFrequency, string>.Item1)"
									TextProperty="@nameof(Tuple<ScheduleFrequency, string>.Item2)"
									class="w-100" />
				</RadzenColumn>
				<RadzenColumn Size="6">
					@if(ScheduledTask.Frequency == ScheduleFrequency.Weekly)
					{
						<RadzenRow>
							<RadzenLabel Component="@nameof(ScheduledTaskItem.RrequencyMask)">Giorni della settimana</RadzenLabel>
						</RadzenRow>
						<RadzenRow>
							<WeeklyFrequencyMask @bind-FrequencyMask="@ScheduledTask.RrequencyMask" Name="@nameof(ScheduledTaskItem.RrequencyMask)" />
						</RadzenRow>
					}
					else if (ScheduledTask.Frequency == ScheduleFrequency.Monthly)
					{
						<RadzenRow >
							<RadzenLabel Component="@nameof(ScheduledTaskItem.RrequencyMask)">Giorno del mese</RadzenLabel>
						</RadzenRow>
						<RadzenRow >
							<MonthlyFrequencyMask @bind-FrequencyMask="@ScheduledTask.RrequencyMask" Name="@nameof(ScheduledTaskItem.RrequencyMask)" />
						</RadzenRow>
					}
				</RadzenColumn>
			</RadzenRow>
			
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.StartTime)">Inizio</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<TimeSelector AllowClear=false 
						@bind-Value=@StartTime
						Name="nameof(ScheduledTaskItem.StartTime"
						Changed="TimStart_Changed"
						/>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.EndTime)">Fine</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<TimeSelector AllowClear=false
								  @bind-Value=@EndTime
								  Name="nameof(ScheduledTaskItem.EndTime"
								  Changed="EndTime_Changed" />
				</RadzenColumn>
			</RadzenRow>
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="6">
				</RadzenColumn>
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.Interval)">Intervallo</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<TimeSelector AllowClear=false
								  @bind-Value=@Interval
								  Name="nameof(ScheduledTaskItem.Interval"
								  Changed="Interval_Changed" />
				</RadzenColumn>
			</RadzenRow>
		</RadzenFieldset>
		<RadzenFieldset Text="Opzioni">
			<RadzenRow AlignItems="AlignItems.Center">
				<RadzenColumn Size="3">
					<RadzenLabel Component="@nameof(ScheduledTaskItem.Timeout)">Timeout</RadzenLabel>
				</RadzenColumn>
				<RadzenColumn Size="3">
					<RadzenNumeric Name="@nameof(ScheduledTaskItem.Timeout)" @bind-Value=@ScheduledTask.Timeout />
				</RadzenColumn>
				<RadzenColumn Size="6">
				</RadzenColumn>
			</RadzenRow>
		</RadzenFieldset>
	</RadzenTemplateForm>

	<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
		@if(ScheduledTask.Id == 0)
		{
		<RadzenButton Click="@(() => this.SaveData(ds))"
					  ButtonStyle="ButtonStyle.Primary"
					  Text="Crea attività" />
		}
		else
		{
		<RadzenButton Click="@(() => this.SaveData(ds))"
					  ButtonStyle="ButtonStyle.Primary"
					  Text="Aggiorna" />
		}
		<RadzenButton Click="@(() => ds.Close())"
					  ButtonStyle="ButtonStyle.Secondary"
					  Text="Annulla" />
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter]
	public DialogService? ds { get; set; }

	[Parameter]
	public ScheduledTaskItem ScheduledTask { get; set; } = new ScheduledTaskItem();

	private IList<Tuple<ScheduleFrequency, string>> FrequencyList = new List<Tuple<ScheduleFrequency, string>>()
	{
		new Tuple<ScheduleFrequency, string> (ScheduleFrequency.Daily, "Quotidiana"),
		new Tuple<ScheduleFrequency, string> (ScheduleFrequency.Weekly, "Settimanale"),
		new Tuple<ScheduleFrequency, string> (ScheduleFrequency.Monthly , "Mensile")
	};

	private TimeSpan? StartTime = null;
	private TimeSpan? EndTime = null;
	private TimeSpan? Interval = null;

	protected override Task OnInitializedAsync()
	{


		return base.OnInitializedAsync();
	}

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		this.StartTime = ScheduledTask.StartTime;
		this.EndTime = ScheduledTask.EndTime;
		this.Interval = ScheduledTask.Interval;
	}

	private async Task TimStart_Changed ()
	{
		await Task.CompletedTask;

		this.ScheduledTask.StartTime = this.StartTime ?? new TimeSpan(0, 0, 0);
	}
	private async Task EndTime_Changed()
	{
		await Task.CompletedTask;

		this.ScheduledTask.EndTime = this.EndTime ?? new TimeSpan(0, 0, 0);
	}
	private async Task Interval_Changed()
	{
		await Task.CompletedTask;

		this.ScheduledTask.Interval = this.Interval ?? new TimeSpan(0, 0, 0);
	}

	private async Task SaveData (DialogService ds)
	{
		// per prima cosa esegue un controllo dei dati
		var chechREsult = await this._checker.CheckASync(
			this.ScheduledTask);
		if (chechREsult.Status == CheckStatus.Failed)
		{
			// mostra un messaggio di errore
			await DialogService.Alert(
				chechREsult.ToString()
			);
			return;
		}

		// controlla se è un nuovo task
		if (this.ScheduledTask.Id == 0)
		{
			var taskItem = this._schedulers.TaskDescriptions.Where(t => t.TaskId == this.ScheduledTask.ActivityId).SingleOrDefault();

			// assegna gli argomenti di default
			this.ScheduledTask.Arguments = taskItem?.DefaultArguments;

			// e segna il task come non attivo
			this.ScheduledTask.Active = false;
		}

		try
		{
			if (this.ScheduledTask.Id == 0)
			{
				var id = await this._schedulers.InsertAsync(this.ScheduledTask);
				this.ScheduledTask.Id = id.Value;
			}
			else
			{
				await this._schedulers.UpdateAsync(this.ScheduledTask);
			}

			// se tutto OK chiude la finestra
			ds.Close(true);

			// notiivca che 
			this._notificationService.Notify(
				NotificationSeverity.Success,
				"dati salvati con scucesso");
		}
		catch (BadRequestException<CheckResult> ex)
		{
			this._notificationService.Notify(
				NotificationSeverity.Error,
				ex.Payload?.Title ?? "problemi",
				ex.Payload?.Description ?? string.Empty
			);
		}
		catch (Exception ex)
		{
			this._notificationService.Notify(
				NotificationSeverity.Error,
				"errore durante ils alvataggio della attività",
				ex.Message);
		}

	}
}
