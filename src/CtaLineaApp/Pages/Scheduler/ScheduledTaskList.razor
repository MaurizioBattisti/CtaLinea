@page "/scheduledtasks"

@inject ContextMenuService ContextMenuService
@inject DialogService DialogService
@inject NotificationService notificationService
@inject ISchedulerTaskChecker _checker
@inject IScheduledTasksService _repo

@inherits EditorComponentBase
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Gestione attività</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Gestione attività" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData"
                FilterMode="FilterMode.Simple"
                IsLoading=@IsLoading
                Data="@this.Data" TItem="ScheduledTaskItem"
                AllowSorting="true"
                AllowFiltering="false"
                AllowColumnResize="true"
                LogicalFilterOperator="LogicalFilterOperator.And"
                AllowVirtualization=true
                VirtualizationOverscanCount="10"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value=@SelectedItems
                CellContextMenu="@RowActionCellContextMenu"
                Style="height:100%"
                EditMode="DataGridEditMode.Single"
                Density=@Settings.Density>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="4px">
            <RadzenButton ButtonStyle="ButtonStyle.Success"
                            IsBusy=@IsLoading
                            Icon="refresh"
                            Click="@ReloadData" />

            <!--
            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                            Icon="domain_add"
                            Click="@AddLine_Click" />
            -->
        </RadzenStack>
    </HeaderTemplate>
    <EmptyTemplate>
        <RadzenCard Visible=@(!IsLoading)>
            <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessua attività nello scheudler !</p>
        </RadzenCard>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@nameof(ScheduledTaskItem.Active)" Title="Attivo" Width="100px">
            <Template Context="data">
                @if (data.Active)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.Id))" Title="Id" Width="80px"  />
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.ActivityId))" Title="Attività" Width="150px" />

        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.Frequency))" Title="Frequenza" Width="150px">
            <Template Context="data">
                @data.GetFrequencyDescription()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.RrequencyMask))" Title="Dettaglio Frequenza" Width="200px">
            <Template Context="data">
                @data.GetFrequencyMaskDescription()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.StartTime))" Title="Inizio" Width="100px">
            <Template Context="data">
                @(this.FormatTime(data.StartTime, false))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.EndTime))" Title="Fine" Width="100px">
            <Template Context="data">
                @(this.FormatTime(data.EndTime, true))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.Interval))" Title="Intervallo" Width="120px">
            <Template Context="data">
                @this.FormatInterval(data.Interval)
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ScheduledTaskItem" Property="@(nameof(ScheduledTaskItem.Timeout))" Title="Timeout" Width="100px" />
    </Columns>
</RadzenDataGrid>

@code {
    private enum TasksMenuItem
    {
        TogleActive,
        SetArguments,
        TryTask,
        ShowLog,
        EditData,
        Delete
    }

    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

    RadzenDataGrid<ScheduledTaskItem>? grdData;
    private bool IsLoading = false;
    private IEnumerable<ScheduledTaskItem> Data = new List<ScheduledTaskItem>();
    private string? FullTextSearch { get; set; } = null;

    private IList<ScheduledTaskItem> SelectedItems = new List<ScheduledTaskItem>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataASync();

        await base.OnInitializedAsync();
    }

    private async Task LoadDataASync()
    {
        this.IsLoading = true;
        try
        {
            var data = await this._repo.GetListAsync();
            if (data != null)
            {
                this.Data = data;
            }
        }
        finally
        {
            this.IsLoading = false;
        }
    }

    private async Task ReloadData()
    {
        await this.LoadDataASync();
    }

    private string FormatTime (TimeSpan time, bool clearZero)
    {
        if (clearZero == true && time == TimeSpan.Zero) return string.Empty;  
        var to = new TimeOnly(time.Hours, time.Minutes, time.Seconds);
        return string.Format("{0:HH:mm:ss}", to);
    }
    private string FormatInterval(TimeSpan time)
    {
        var text = this.FormatTime(time, true);
        if (string.IsNullOrWhiteSpace(text)) text = "One shot";
        else text = "Ogni " + text;

        return text;
    }

    private void RowActionCellContextMenu(DataGridCellMouseEventArgs<ScheduledTaskItem> args)
    {
        if (grdData != null)
        {
            this.grdData.SelectRow(args.Data);
        }
        if (this.IsClean == false) return;

        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Click=@((e)=>OnMenuItemClick(args, e))>
                <RadzenMenuItem Icon=@(args.Data.Active == true ? "notifications_off" : "notifications") Text=@(args.Data.Active == true ? "Disabilita" : "Abilita") Value=@TasksMenuItem.TogleActive />
                <RadzenMenuItem Icon="cabin" Text="Mostra Log ..." Value=@TasksMenuItem.ShowLog />
                <hr class="separator">
                <RadzenMenuItem Icon="newspaper" Text="Imposta Argomenti ..." Value=@TasksMenuItem.SetArguments />
                <RadzenMenuItem Icon="play_circle" Text="Esegui Attività ..." Value=@TasksMenuItem.TryTask />
                <RadzenMenuItem Icon="edit" Text="Modifica ..." Value=@TasksMenuItem.EditData />
                <hr class="separator">
                <RadzenMenuItem Icon="delete" Text="Elimina..." Value=@TasksMenuItem.Delete />
            </RadzenMenu>
            );
    }
    private async Task OnMenuItemClick(
        DataGridCellMouseEventArgs<ScheduledTaskItem> args,
        MenuItemEventArgs e
        )
    {
        await Task.CompletedTask;
        ContextMenuService.Close();

        if (this.IsClean == false) return;

        switch ((TasksMenuItem)e.Value)
        {
            case TasksMenuItem.TogleActive:
                break;
            case TasksMenuItem.ShowLog:
                break;

            case TasksMenuItem.EditData:
                break;
            
            case TasksMenuItem.TryTask:
                break;
            case TasksMenuItem.SetArguments:
                break;

            case TasksMenuItem.Delete:
                break;

            default:
                break;
        };
    }

