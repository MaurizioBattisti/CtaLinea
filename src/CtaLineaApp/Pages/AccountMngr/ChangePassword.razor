@page "/account/password"
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@inject NotificationService notificationService
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Cambio Password</PageTitle>

<Animate Animation="Animations.SlideDown"
         IsManual=false
         Easing="Easings.Ease"
         Duration="TimeSpan.FromSeconds(0.5)">
    <RadzenCard class="d-flex p-0 rz-border-radius-6 rz-shadow-10" Style="width: 100%; flex-flow: row wrap; overflow: hidden; align-items: stretch;">
        <RadzenCard Class="rz-shadow-0 rz-border-radius-0 p-5" style="flex: 1 14rem; text-align: center; background: var(--rz-secondary-light) no-repeat 100% 70% fixed url('data:image/svg+xml;base64,')">
            <Animate Animation="Animations.SlideLeft"
                     IsManual=false
                     Easing="Easings.Ease"
                     Duration="TimeSpan.FromSeconds(0.5)"
                     Delay="TimeSpan.FromSeconds(0.4)">
                <RadzenText TextStyle="TextStyle.DisplayH2" TagName="TagName.H2" Class="rz-color-white mb-4">Cambio Password</RadzenText>
            </Animate>
            <Animate Animation="Animations.SlideLeft"
                     IsManual=false
                     Easing="Easings.Ease"
                     Duration="TimeSpan.FromSeconds(0.5)"
                     Delay="TimeSpan.FromSeconds(0.8)">
                <RadzenText TextStyle="TextStyle.H6" Class="rz-color-white">Cambia la password di accesso al sistma di gestione delle linee</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-white"><strong>CTA Linea</strong></RadzenText>
            </Animate>
        </RadzenCard>
        <RadzenCard Class="rz-shadow-0 rz-border-radius-0 p-5" style="flex: 1 14rem;">
            <RadzenTemplateForm TItem="ChangePasswordModel" Data=@model Submit=@ChangePasswordAsync Style="min-width: 200px">
                <div class="row">
                    <div class="col-md-10 align-items-center d-flex">
                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="mb-4">
                            Cambio Password
                        </RadzenText>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-4 align-items-center d-flex">
                        <RadzenLabel Text="Vecchia Password" />
                    </div>
                    <div class="col-xl-8">
                        <RadzenPassword @bind-Value="model.OldPassword" Placeholder="inserisci la password..." Class="w-100" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-4 align-items-center d-flex">
                        <RadzenLabel Text="Nuova Password" />
                    </div>
                    <div class="col-xl-8">
                        <RadzenPassword Name="Password" @bind-Value="model.NewPassword" Placeholder="inserisci la nuova password..." Class="w-100" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-4 align-items-center d-flex">
                        <RadzenLabel Text="Conferma" />
                    </div>
                    <div class="col-xl-8">
                        <RadzenPassword @bind-Value=@model.ConfirmdPassword Placeholder="conferma password..." Class="w-100" />
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                        <RadzenButton IsBusy=@loading Text="Cambia e disconnetti" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </div>
                </div>
            </RadzenTemplateForm>
        </RadzenCard>
    </RadzenCard>
</Animate>

@code {
    private ChangePasswordModel model = new ChangePasswordModel();
    private bool loading;

    private async Task ChangePasswordAsync(ChangePasswordModel change)
    {
        if (string.IsNullOrWhiteSpace(model.OldPassword)
            || string.IsNullOrWhiteSpace(model.NewPassword)
            || string.IsNullOrWhiteSpace(model.ConfirmdPassword))
        {
            notificationService.Notify(
                NotificationSeverity.Error,
                "Devono essere inseriti tutti i valori"
                );
            return;
        }
        // controlla che la password nuova  ela conferma siano uguali
        if (model.ConfirmdPassword != model.NewPassword)
        {
            notificationService.Notify(
                NotificationSeverity.Error,
                "La conferma è diversa dalla nuova password"
                );
            return;
        }
        if (model.NewPassword.ToLower() == model.OldPassword.ToUpper ())
        {
            notificationService.Notify(
                NotificationSeverity.Error,
                "La nuova e la vecchia password sono uguali o differiscono solo epr le maiuscle !"
                );
            return;
        }

        loading = true;
        try
        {
            await AccountService.ChangePassword(change);
            notificationService.Notify(
                NotificationSeverity.Success,
                "Password Modiicata"
            );
            StateHasChanged();
            NavigationManager.NavigateTo("/account/logout");
        }
        catch (Exception ex)
        {
            loading = false;
            notificationService.Notify(
                NotificationSeverity.Error,
                "cambio password fallito",
                ex.Message
            );
            StateHasChanged();
        }
    }
}
