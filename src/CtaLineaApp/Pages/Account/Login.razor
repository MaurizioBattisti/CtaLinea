@page "/account/login"
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@inject NotificationService notificationService

<PageTitle>@Constants.App_Title - Login</PageTitle>

<Animate Animation="Animations.SlideDown"
         IsManual=false
         Easing="Easings.Ease"
         Duration="TimeSpan.FromSeconds(0.5)"
    >
    <RadzenCard class="d-flex p-0 rz-border-radius-6 rz-shadow-10" Style="width: 100%; flex-flow: row wrap; overflow: hidden; align-items: stretch;">
        <RadzenCard Class="rz-shadow-0 rz-border-radius-0 p-5" style="flex: 1 14rem; text-align: center; background: var(--rz-primary-light) no-repeat 100% 70% fixed url('data:image/svg+xml;base64,')">
            <Animate Animation="Animations.SlideLeft"
                     IsManual=false
                     Easing="Easings.Ease"
                     Duration="TimeSpan.FromSeconds(0.5)"
                     Delay="TimeSpan.FromSeconds(0.4)">
                <RadzenText TextStyle="TextStyle.DisplayH2" TagName="TagName.H2" Class="rz-color-white mb-4">Benvenuto!</RadzenText>
            </Animate>
            <Animate Animation="Animations.SlideLeft"
                     IsManual=false
                     Easing="Easings.Ease"
                     Duration="TimeSpan.FromSeconds(0.5)"
                     Delay="TimeSpan.FromSeconds(0.8)">
                <RadzenText TextStyle="TextStyle.H6" Class="rz-color-white">Esegui il log in per poter vedere e utilizzare i dati dei servizi di Linea</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-white">CTA Linea <strong>30 days</strong> trial.</RadzenText>
            </Animate>
        </RadzenCard>
        <RadzenCard Class="rz-shadow-0 rz-border-radius-0 p-5" style="flex: 1 14rem;">
            <RadzenTemplateForm  TItem="LoginModel" Data=@model Submit=@LoginAsync Style="min-width: 200px" >
                <div class="row">
                    <div class="col-md-4 align-items-center d-flex">
                        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="mb-4">
                            Login
                        </RadzenText>
                    </div>
                </div>

                    <div class="row">
                    <div class="col-xl-4 align-items-center d-flex">
                        <RadzenLabel Text="Nome utente" />
                    </div>
                    <div class="col-xl-8">
                        <RadzenTextBox @bind-Value="model.Username" Placeholder="Nome utente" Class="w-100" />
                    </div>
                </div>
                    <div class="row">
                    <div class="col-xl-4 align-items-center d-flex">
                        <RadzenLabel Text="Password" />
                    </div>
                    <div class="col-xl-8">
                        <RadzenPassword @bind-Value="model.Password" Placeholder="inserisci la password..." Class="w-100" />
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                        <RadzenButton IsBusy=@loading Text="Login" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </div>
                </div>
            </RadzenTemplateForm>
        </RadzenCard>
    </RadzenCard>
</Animate>

@code {
    private LoginModel model = new LoginModel();
    private bool loading;

    private async Task LoginAsync( LoginModel login)
    {
        // reset alerts on submit
        // AlertService.Clear();

        loading = true;
        try
        {
            await AccountService.Login(login);
            var returnUrl = NavigationManager.QueryString("returnUrl") ?? "";
            NavigationManager.NavigateTo(returnUrl);
        }
        catch (Exception ex)
        {
            loading = false;
            notificationService.Notify(
                NotificationSeverity.Error,
                "Login fallito",
                ex.Message
            );
            StateHasChanged();
        }
    }
}