@page "/cars"
@inject IAutoLoadDataList<Car> AutoLoad;
@inject IExcelExporterService ExcelService
@inject NotificationService notificationService
@attribute [Authorize]

<CheckAuthorization Roles=@(new string[] { UserRoles.Role_Anagraohics }) />
<PageTitle>@Constants.App_Title - Mezzi</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Mezzi" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData" 
        FilterMode="FilterMode.Simple"
        IsLoading=@AutoLoad.isLoading
        Count="@AutoLoad.RowCount"
        LoadData="@this.AutoLoad.LoadData"
        Data="@this.AutoLoad.Data" TItem="Car"
        AllowFiltering="true"
        AllowColumnResize="true"
        AllowSorting="true"
        LogicalFilterOperator="LogicalFilterOperator.And"
        Style="height:100%"
        AllowPaging="true"
        PagerHorizontalAlign="HorizontalAlign.Left"
        ShowPagingSummary="true"
        Density=@Settings.Density
        PageSize=@(Settings?.PageSize ?? 5)
        >
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenSplitButton ButtonStyle="ButtonStyle.Dark"
                               Icon="file_download" Click=@DownloadData_Click>
                <ChildContent>
                    <RadzenSplitButtonItem Text="Excel" Value="X" Icon="grid_on" />
                    <RadzenSplitButtonItem Text="CSV" Value="C" Icon="wrap_text" />
                </ChildContent>
            </RadzenSplitButton>

            <RadzenTextBox @bind-Value=@this.AutoLoad.FullTextSearch Placeholder="Cerca..." Style="width: 200px" Change="@FullText_OnChange" Class="w-100" />
            <RadzenButton ButtonStyle="ButtonStyle.Success"
                          IsBusy=@AutoLoad.isLoading
                          Icon="refresh"
                          Click="@(()=>ReloadData())" />
        </RadzenStack>
    </HeaderTemplate>
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun mezzo trovato !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="Car" Property="Id" Title="ID" Visible=false />
        <RadzenDataGridColumn TItem="Car" Property="BsCarId" Title="Cod. B.S." Width="100px"/>

        <RadzenDataGridColumn TItem="Car" Property="RegNumber" Title="Targa"  Width="120px" />
        <RadzenDataGridColumn TItem="Car" Property="Description" Title="Descrizione"  Width="200px"/>
        <RadzenDataGridColumn TItem="Car" Property="NrSittings" Title="Posti" Width="100px"/>
        <RadzenDataGridColumn TItem="Car" Property="AssociateDescription" Title="Ditta" Width="200px"/>

        <RadzenDataGridColumn TItem="Car" Property="PrimaryCar" Title="Titolare" Width="100px">
            <Template Context="data">
                @if (data.PrimaryCar)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Car" Property="SpareCar" Title="Scorta" Width="100px">
            <Template Context="data">
                @if (data.SpareCar)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Car" Property="FirstRegistration" Title="Prima imm." FormatString="{0:dd/MM/yyyy}" Width="150px" />
        <RadzenDataGridColumn TItem="Car" Property="DiscontinuationDate" Title="Vendita " FormatString="{0:dd/MM/yyyy}" Width="150px" />

        <RadzenDataGridColumn TItem="Car" Property="ChassisNumber" Title="Nr. Telaio" Width="150px"/>

        <RadzenDataGridColumn TItem="Car" Property="Active" Title="Attivo" Width="100px">
            <Template Context="data">
                @if (data.Active)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Car" Property="AssociateActive" Title="Ditta Att." Width="150px">
            <Template Context="data">
                @if (data.AssociateActive)
                {
                    <RadzenIcon Icon="check" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    RadzenDataGrid<Car>? grdData;

    private async Task DownloadData_Click(RadzenSplitButtonItem item)
    {
        this.AutoLoad.StartLoading();

        try
        {
            var data = await this.AutoLoad.GetAllAsync();
            if (data != null)
            {
                // var columninfo = this.grdData?.GetExportColumnInfo();
                var columninfo = data.GetExportColumnInfo();

                string title = "Mezzi";
                if (item == null)
                {
                    await this.ExcelService.Export(title, data, columninfo);
                }
                else
                {
                    switch (item.Value)
                    {
                        case "X":
                            await this.ExcelService.ExportExcel(title, data, columninfo);
                            break;
                        case "C":
                            await this.ExcelService.ExportCsv(title, data, columninfo);
                            break;
                    }
                }
                this.notificationService.Notify(NotificationSeverity.Info, "File pronto per il donwload");
            }
            else
            {
                this.notificationService.Notify(
                    NotificationSeverity.Warning,
                    "Nessun dato da esportare"
                    );
            }
        }
        catch (Exception ex)
        {
            this.notificationService.Notify(
                NotificationSeverity.Error,
                "ERrore recuperando i dati",
                ex.Message
                );
        }
        finally
        {
            this.AutoLoad.EndLoading();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AutoLoad.Initilize (
            Constants.Endpoint_Cars
            );

        await Task.CompletedTask;
        this.StateHasChanged();
    }

    void FullText_OnChange(string value)
    {
        this.grdData?.Reload();
    }

    private async Task ReloadData()
    {
        if (this.grdData != null)
        {
            await this.grdData.Reload();
        }
    }
}
