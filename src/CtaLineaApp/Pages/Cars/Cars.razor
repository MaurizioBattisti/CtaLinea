@page "/cars"
@inject IAutoLoadDataList<Car> AutoLoad;
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Mezzi</PageTitle>

<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Mezzi" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
        <RadzenTextBox @bind-Value="AutoLoad.FullTextSearch" Placeholder="Cerca..." Change=@(args => FullText_OnChange(args)) Class="w-100" />
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDataGrid @ref="@grdData" 
        FilterMode="FilterMode.Simple"
        IsLoading=@AutoLoad.isLoading
        Count="@AutoLoad.RowCount"
        LoadData="@this.AutoLoad.LoadData"
        Data="@this.AutoLoad.Data" TItem="Car"
        AllowFiltering="true"
        AllowColumnResize="true"
        AllowSorting="true"
        LogicalFilterOperator="LogicalFilterOperator.And"
        Style="height:100%"
        AllowPaging="true"
        PagerHorizontalAlign="HorizontalAlign.Left"
        ShowPagingSummary="true"
        Density=@Settings.Density
        PageSize=@(Settings?.PageSize ?? 5)
        >
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun mezzo trovato !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="Car" Property="Id" Title="ID" Visible=false />
        <RadzenDataGridColumn TItem="Car" Property="BsCarId" Title="Cod. B.S." Width="100px"/>

        <RadzenDataGridColumn TItem="Car" Property="RegNumber" Title="Targa"  Width="120px" />
        <RadzenDataGridColumn TItem="Car" Property="Description" Title="Descrizione"  Width="200px"/>
        <RadzenDataGridColumn TItem="Car" Property="NrSittings" Title="Posti" Width="100px"/>
        <RadzenDataGridColumn TItem="Car" Property="AssociateDescription" Title="Ditta" Width="200px"/>

        <RadzenDataGridColumn TItem="Car" Property="PrimaryCar" Title="Titolare" Width="100px"/>
        <RadzenDataGridColumn TItem="Car" Property="SpareCar" Title="Scorta" Width="100px"/>

        <RadzenDataGridColumn TItem="Car" Property="FirstRegistration" Title="Prima imm." FormatString="{0:dd/MM/yyyy}" Width="150px" />
        <RadzenDataGridColumn TItem="Car" Property="DiscontinuationDate" Title="Vendita " FormatString="{0:dd/MM/yyyy}" Width="150px" />

        <RadzenDataGridColumn TItem="Car" Property="ChassisNumber" Title="Nr. Telaio" Width="150px"/>

        <RadzenDataGridColumn TItem="Car" Property="Active" Title="Attivo" Width="100px"/>
        <RadzenDataGridColumn TItem="Car" Property="AssociateActive" Title="Ditta Att." Width="150px"/>
    </Columns>
</RadzenDataGrid>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    RadzenDataGrid<Car>? grdData;

    protected override async Task OnInitializedAsync()
    {
        AutoLoad.Initilize (
            Constants.Endpoint_Cars
            );

        await Task.CompletedTask;
        this.StateHasChanged();
    }

    void FullText_OnChange(string value)
    {
        this.grdData?.Reload();
    }
}
