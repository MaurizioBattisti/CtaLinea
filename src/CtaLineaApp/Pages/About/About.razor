@page "/about"
@using System.Reflection;
@inject IHttpService _http;

<PageTitle>@Constants.App_Title - Informazioni</PageTitle>

<Animate Animation="Animations.SlideDown"
         IsManual=false
         Easing="Easings.Ease"
         Duration="TimeSpan.FromSeconds(0.5)"
         >
    <h1>Informaizoni su CTA Linea</h1>
</Animate>

<Animate Animation="Animations.SlideLeft"
            IsManual=false
            Easing="Easings.Ease"
            Duration="TimeSpan.FromSeconds(0.5)"
         Delay="TimeSpan.FromSeconds(0.4)">
    <RadzenDataGrid 
        @ref=@grdInfo
        Data="@Info"
        TItem="KeyValuePair<string, string?>"
        AllowPaging="false" 
        AllowSorting="false">
        <Columns>
            <RadzenDataGridColumn TItem="KeyValuePair<string,string?>" Property="Key" Title="Info" />
            <RadzenDataGridColumn TItem="KeyValuePair<string,string?>" Property="Value" Title="Valore" />
        </Columns>
    </RadzenDataGrid>
</Animate>
@code {
    RadzenDataGrid<KeyValuePair<string, string?>>? grdInfo;
    // lista con le informaizoni
    List<KeyValuePair<string, string?>> Info = new List<KeyValuePair<string, string?>>();

    protected override async Task OnInitializedAsync()
    {
        this.Info.AddRange(
            this.GetInfo()
            );

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == true)
        {
            try
            {
                var info = await this._http.Get<IEnumerable<KeyValuePair<string, string?>>>(
                    Constants.Endpoint_Info_Versions);

                if (info != null)
                {
                    this.Info.AddRange(
                        info
                        );
                }
            }
            catch (Exception ex)
            {
                this.Info.Add(
                    new KeyValuePair<string, string?>("Error", ex.Message)
                );
            }
            finally
            {
                grdInfo?.Reload();
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private IEnumerable<KeyValuePair<string, string?>> GetInfo ()
    {
        // nome autore
        yield return new KeyValuePair<string, string?>("Autore", "Maurizio Battisti");



        // versione assembly
        var assembly = Assembly.GetExecutingAssembly();
        yield return new KeyValuePair<string, string?>("Assembly",
            null
            );
        yield return new KeyValuePair<string, string?>("Versione",
            assembly.GetName()?.Version?.ToString()
            );
        yield return new KeyValuePair<string, string?>("FullName",
            assembly.FullName
            );
        yield return new KeyValuePair<string, string?>("Image RunTime Versione", 
            assembly.ImageRuntimeVersion
            );


    }
}