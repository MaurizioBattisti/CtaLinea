@page "/planning"
@inject IApplicationSettings AppSettings;
@using CtaLinea.Model.Utilities
@using CtaLineaApp.Pages.Runs;
@inject IUtilityService _utilityService
@inject DialogService DialogService
@attribute [Authorize]

<PageTitle>@Constants.App_Title - Planning</PageTitle>
<LayoutSetter>
    <PageTitle>
        <RadzenLabel Text="Planning Attività" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </PageTitle>
    <TopLine>
    </TopLine>
</LayoutSetter>
<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenLayout Style="height: 100%; grid-template-columns: auto 1fr auto; grid-template-areas: 'rz-header rz-header rz-header' 'rz-sidebar rz-body rz-right-sidebar'">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Vertical"
                    AlignItems="AlignItems.Stretch">
            <RadzenRow>
                <RadzenColumn Size="10">
                    <AssociateAndCarDropDown @bind-AssociateId=@AssociateId @bind-CarId=@CarId Inline=true AllowClear=true />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenButton Text="Carica..."
                                  IsBusy=@isLoading
                                  BusyText="Ricerca..."
                                  Click=@ReloadDataAsync />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        <RadzenScheduler @ref=@scheduler
                            SlotRender=@OnSlotRender
                            TItem="CarPlanningItem"
                            Data=@Planning
                            LoadData=@LoadDataAsync
                            StartProperty="StartTime"
                            EndProperty="EndTime"
                            TextProperty="Text"
                            SelectedIndex="1"
                            Culture=@AppSettings.CurrentCulture
                            AppointmentSelect=@OnAppointmentSelect
                            AppointmentRender=@OnAppointmentRender
                            Style="height:100%; width:100%">

            <RadzenDayView />
            <RadzenWeekView />
            <RadzenMonthView />
        </RadzenScheduler>
    </RadzenBody>
    <!--
    <RadzenSidebar @bind-Expanded="@EditorVisible" Style="width: 1000px; grid-area: rz-right-sidebar">
        <RinItemEditView @ref=@RunEditDetail
                         Saved=@RunSaved />
    </RadzenSidebar>
    -->
</RadzenLayout>

