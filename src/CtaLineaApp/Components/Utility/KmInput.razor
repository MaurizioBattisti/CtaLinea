@inject IApplicationSettings AppSettings;

<RadzenNumeric 
	TValue="double?" 
	@bind-Value="Value" 
	Disabled=@Disabled
	Culture=@AppSettings.CurrentCulture
	Format="0.00"
	Change=@OnChange
	Class="w-100" />

@code {
	[Parameter]
	public double? Value  { get; set; }
	[Parameter]
	public EventCallback<double?> ValueChanged { get; set; }
	[Parameter]
	public EventCallback<object> Changed { get; set; }

	[Parameter]
	public bool Disabled { get; set; } = false;

	private void OnChange (double? value)
	{
		ValueChanged.InvokeAsync(this.Value);
		Changed.InvokeAsync(this);
	}
}
