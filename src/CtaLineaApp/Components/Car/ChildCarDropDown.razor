@using CtaLinea.QueryModel
@inject IQueryUtilityService queryService

<CtaLineaSttingsNotifier Changed=@StateHasChanged />

<RadzenDropDown 
    Disabled=@Disabled
    Data=@Data 
    @bind-Value="CurrentItem"
    TValue="CarQueryItem" 
    AllowClear=@AllowClear
    Change=@OnChange 
    AllowFiltering=true
    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
    FilterOperator="StringFilterOperator.Contains"
    Class="w-100">
    <Template>
        <div class="@GetClassByStatus(context as CarQueryItem)" >
            @((context as CarQueryItem)?.Description)
        </div>
    </Template>
</RadzenDropDown>

@code {
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();

    private Guid? _AssociateId;
    [Parameter]
    public Guid? AssociateId 
    {
        get { return _AssociateId; }
        set
        {
            if (value != _AssociateId)
            {
                InvokeAsync(async() => await this.LoadData(value));
            }
        }
    }

    private Guid? _CarId;

    [Parameter]
    public Guid? CarId 
    {
        get { return this._CarId; }
        set
        {
            _CarId = value;
            this.SelectItem (this._CarId);
        }
    }
    [Parameter]
    public EventCallback<Guid?> CarIdChanged { get; set; }
    [Parameter]
    public bool AllowClear { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public EventCallback<object> Changed { get; set; }

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    CarQueryItem[]? Data = null; 
    int RowCount = 0;
    bool isLoading = false;
    CarQueryItem? CurrentItem = null;

    protected override async Task OnInitializedAsync()
    {
        this._servicesQueryDef.EndPoint = Constants.Endpoint_Cars;
        this.StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {
        await Task.CompletedTask;
    }

    private async Task LoadData (Guid? associateId)
    {
        await Task.CompletedTask;
        _AssociateId = associateId;

        if (_AssociateId == null)
        {
            this.Data = null;
            this.RowCount = 0;
            this.CurrentItem = null;
            this.StateHasChanged();
            return;
        }

        this._servicesQueryDef.Filter = string.Format("$eq(associateId,'{0}')", _AssociateId.Value);
        this._servicesQueryDef.Sort = "regNumber";
        this._servicesQueryDef.FullText = string.Empty;

        this._servicesQueryDef.Page = 0;
        this._servicesQueryDef.PageSize = 100000;

        var result = await queryService.GetListAsync<CarQueryItem>(
                    this._servicesQueryDef);

        if (result != null)
        {
            this.Data = result.Items;
            this.RowCount = result.TotalRows;
        }
        this.SelectItem(this.CarId);
        this.StateHasChanged();
    }

    private string GetClassByStatus (
        CarQueryItem? car)
    {
        if (car == null) return string.Empty;
        if (car.Active == false || car.AssociateActive == false) return this.GetStyle(this.Settings.InactiveCarBgStyle, this.Settings.InactiveCarFgStyle);
        if (car.PrimaryCar) return this.GetStyle(this.Settings.PrimaryCarBgStyle, this.Settings.PrimaryCarFgStyle);
        if (car.SpareCar) return this.GetStyle(this.Settings.SpareCarBgStyle, this.Settings.SpareCarFgStyle);
        return this.GetStyle(this.Settings.OtherCarBgStyle, this.Settings.OtherCarFStyle);
    }

    private string GetStyle (
        params string[] styles)
    {
        var str = string.Join(' ', styles);
        return str.Trim();
    }

    private void SelectItem (Guid? carId)
    {
        if(carId != null
            && this.Data != null)
        {
            this.CurrentItem = (from d in this.Data
                                where d.Id == carId
                                select d)
                        .SingleOrDefault();
        }
        else
        {
            this.CurrentItem = null;
        }
    }

    private async Task OnChange (object value)
    {
        this._CarId = (value as CarQueryItem)?.Id;
        await CarIdChanged.InvokeAsync(this.CarId);
        await Changed.InvokeAsync(this);
    }
}
