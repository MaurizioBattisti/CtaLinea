@using CtaLinea.QueryModel
@inject IQueryUtilityService queryService

<RadzenDropDown 
    Disabled=@Disabled
    Data=@Data 
    @bind-Value="CurrentItem"
    TValue="AssociateQueryItem" 
    AllowClear=@AllowClear
    Change=@OnChange 
    TextProperty="Description"
    AllowFiltering=true
    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
    FilterOperator="StringFilterOperator.Contains"
    Class="w-100">    
</RadzenDropDown>

@code {
    /*
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    */

    public Guid? _AssociateId;
    [Parameter]
    public Guid? AssociateId 
    {
        get { return this._AssociateId;  }
        set
        {
            if (_AssociateId != value)
            {
                _AssociateId = value;
                this.SelectItem(this._AssociateId);
            }
        }
    }
    [Parameter]
    public EventCallback<Guid?> AssociateIdChanged { get; set; }

    [Parameter]
    public bool AllowClear { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public EventCallback<object> Changed { get; set; }

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    AssociateQueryItem[]? Data = null; 
    int RowCount = 0;
    bool isLoading = false;
    AssociateQueryItem? CurrentItem = null;

    public AssociateQueryItem? SelectedASsociateData 
    {
        get
        {
            return this.CurrentItem;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        this._servicesQueryDef.EndPoint = Constants.Endpoint_Associates;

        await LoadData();
        this.StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {

        await Task.CompletedTask;
    }

    private async Task LoadData ()
    {
        await Task.CompletedTask;

        this._servicesQueryDef.Filter = string.Empty;
        this._servicesQueryDef.Sort = string.Empty;
        this._servicesQueryDef.FullText = string.Empty;

        this._servicesQueryDef.Page = 0;
        this._servicesQueryDef.PageSize = 100000;

        var result = await queryService.GetListAsync<AssociateQueryItem>(
                    this._servicesQueryDef);

        if (result != null)
        {
            this.Data = result.Items;
            this.RowCount = result.TotalRows;
        }
    }

    private void SelectItem (Guid? associateId)
    {
        if (associateId != null
            && this.Data != null)
        {
            this.CurrentItem = (from d in this.Data
                                where d.Id == associateId
                                select d).SingleOrDefault();
        }
        else
        {
            this.CurrentItem = null;
        }        
    }

    private async Task OnChange (object value)
    {
        this._AssociateId = (value as AssociateQueryItem)?.Id;
        await AssociateIdChanged.InvokeAsync(this.AssociateId);
        await Changed.InvokeAsync(this);
    }
    /*
    private void OnSelectedItemChanged(object value)
    {
        this._AssociateId = (value as AssociateQueryItem)?.Id;
    }
    */
}
