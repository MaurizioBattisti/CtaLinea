@using CtaLinea.QueryModel;
@using CtaLinea.Model.QueryModel
@inject IQueryUtilityService queryService

<RadzenRow>
    <RadzenColumn Size="@ASsociateColSize">
        <RadzenText TextStyle="TextStyle.Overline" Text="Ditta" />
        <AssociateDropDown @ref="@Associates" Disabled=@Disabled @bind-AssociateId="AssociateId" AllowClear=@AllowClear Changed=@AssociateChanged />
    </RadzenColumn>
    <RadzenColumn Size="@CarColSize">
        <RadzenText TextStyle="TextStyle.Overline" Text="Mezzo" />
        <ChildCarDropDown @ref="@Cars" Disabled=@CarDisabled() AssociateId=@AssociateId @bind-CarId="CarId" AllowClear=@AllowClear Changed=@CarChanged />
    </RadzenColumn>
</RadzenRow>

@code {
    private int ASsociateColSize => this.Inline ? 10 : 12;
    private int CarColSize => this.Inline ? 2 : 6;

    private AssociateDropDown? Associates;
    private ChildCarDropDown? Cars;

    [Parameter]
    public Guid? AssociateId { get; set; }
    [Parameter]
    public Guid? CarId { get; set; }

    [Parameter]
    public bool AllowClear { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;
    [Parameter]
    public bool Inline { get; set; } = false;

    [Parameter]
    public EventCallback<Guid?> AssociateIdChanged { get; set; }
    [Parameter]
    public EventCallback<Guid?> CarIdChanged { get; set; }

    [Parameter]
    public EventCallback<object> Changed { get; set; }

    public AssociateQueryItem? SelectedASsociateData
    {
        get
        {
            return this.Associates?.SelectedASsociateData;
        }
    }
    public CarQueryItem? SelectedCarData
    {
        get
        {
            return this.Cars?.SelectedCarData;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
        this.StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {


        await Task.CompletedTask;
    }

    private async Task AssociateChanged (object value)
    {
        await AssociateIdChanged.InvokeAsync(this.AssociateId);
        await Changed.InvokeAsync(this);
        this.StateHasChanged();
    }
    private async Task CarChanged (object value)
    {
        await CarIdChanged.InvokeAsync(this.CarId);
        await Changed.InvokeAsync(this);
    }
    private bool CarDisabled ()
    {
        if (this.Disabled == true) return this.Disabled;
        return this.AssociateId == null;
    }
}
