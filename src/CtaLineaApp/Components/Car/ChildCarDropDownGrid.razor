@using CtaLinea.QueryModel;
@using CtaLinea.Model.QueryModel
@inject IQueryUtilityService queryService

<QueryLoader @ref=@CarQueryLoader
             TItem="CarQueryItem"
             Endpoint="@(Constants.Endpoint_Cars)"
             Filter="@Filter"
             @bind-Data=@Data
             DataLoaded=@DataLoaded
             @bind-IsBusy=@isLoading />

<RadzenDropDownDataGrid 
        Data=@Data 
        TValue="CarQueryItem" 
        @bind-Value="CurrentItem"
        AllowVirtualization="true"
        AllowFiltering="true" 
        AllowSorting="true"
        AllowClear="@AllowClear"
        IsLoading=@isLoading
        TextProperty="Description" 
        Change=@OnChange 
        Class="w-100">
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: left; margin: 2rem;">Nessun mezzo trovato !</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDropDownDataGridColumn Property="Id" Title="ID" Visible=false />
        <RadzenDropDownDataGridColumn Property="Description" Title="Descrizione"  Width="200px"/>
        <RadzenDropDownDataGridColumn Property="BsCarId" Title="Cod. B.S." Width="100px"/>

        <RadzenDropDownDataGridColumn Property="RegNumber" Title="Targa"  Width="120px" />
        <RadzenDropDownDataGridColumn Property="NrSittings" Title="Posti" Width="100px"/>

        <RadzenDropDownDataGridColumn Property="PrimaryCar" Title="Titolare" Width="100px"/>
        <RadzenDropDownDataGridColumn Property="SpareCar" Title="Scorta" Width="100px"/>

        <RadzenDropDownDataGridColumn Property="FirstRegistration" Title="Prima imm." FormatString="{0:dd/MM/yyyy}" Width="150px"/>
        <RadzenDropDownDataGridColumn  Property="DiscontinuationDate" Title="Vendita " FormatString="{0:dd/MM/yyyy}" Width="150px"/>

        <RadzenDropDownDataGridColumn Property="ChassisNumber" Title="Nr. Telaio" Width="150px"/>

        <RadzenDropDownDataGridColumn Property="Active" Title="Attivo" Width="100px"/>
        <RadzenDropDownDataGridColumn Property="AssociateActive" Title="Ditta Att." Width="150px"/>
    </Columns>
</RadzenDropDownDataGrid>

@code {
    QueryLoader<CarQueryItem>? CarQueryLoader;
    /*
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    */
    private Guid? _AssociateId;
    [Parameter]
    public Guid? AssociateId 
    {
        get { return _AssociateId; }
        set
        {
            if (value != _AssociateId)
            {
                this.LoadData(value);
            }
        }
    }

    public Guid? _CarId;

    [Parameter]
    public Guid? CarId 
    {
        get { return this._CarId; }
        set
        {
            _CarId = value;
            this.SelectItem (this._CarId);
        }
    }
    [Parameter]
    public EventCallback<Guid?> CarIdChanged { get; set; }
    [Parameter]
    public bool AllowClear { get; set; } = false;
    [Parameter]
    public EventCallback<object> Changed { get; set; }

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    IList<CarQueryItem>? Data = null;
    // int RowCount = 0;
    bool isLoading = false;
    CarQueryItem? CurrentItem = null;
    private string? Filter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        /*
        this._servicesQueryDef.EndPoint = Constants.Endpoint_Cars;
        this.StateHasChanged();
        */
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    private async Task LoadData(Guid? associateId)
    {
        if (_AssociateId == null)
        {
            this.Data = null;
            this.CurrentItem = null;
            this.StateHasChanged();
            return;
        }
        this.Filter = string.Format("$eq(associateId,'{0}')", _AssociateId.Value);
        if (this.CarQueryLoader != null)
        {
            await this.CarQueryLoader.LoadDataAsync(this.Filter);
        }
    }
    /*
    private async Task LoadData (Guid? associateId)
    {
        await Task.CompletedTask;
        _AssociateId = associateId;

        if (_AssociateId == null)
        {
            this.Data = null;
            this.RowCount = 0;
            this.CurrentItem = null;
            this.StateHasChanged();
            return;
        }

        this._servicesQueryDef.Filter = string.Format("$eq(associateId,'{0}')", _AssociateId.Value);
        this._servicesQueryDef.Sort = "regNumber";
        this._servicesQueryDef.FullText = string.Empty;

        this._servicesQueryDef.Page = 0;
        this._servicesQueryDef.PageSize = 100000;

        var result = await queryService.GetListAsync<CarQueryItem>(
        this._servicesQueryDef);

        if (result != null)
        {
            this.Data = result.Items;
            this.RowCount = result.TotalRows;
        }
        this.SelectItem(this.CarId);
        this.StateHasChanged();
    }
    */
    private async Task DataLoaded ()
    {
        this.SelectItem(this.CarId);
        this.StateHasChanged();

        await Task.CompletedTask;
    }

    private void SelectItem (Guid? carId)
    {
        if(carId != null
            && this.Data != null)
        {
            this.CurrentItem = (from d in this.Data
                                where d.Id == carId
                                select d)
                        .SingleOrDefault();
        }
        else
        {
            this.CurrentItem = null;
        }
    }

    private async Task OnChange (object value)
    {
        this._CarId = (value as CarQueryItem)?.Id;
        await CarIdChanged.InvokeAsync(this.CarId);
        await Changed.InvokeAsync(this);
    }
}
