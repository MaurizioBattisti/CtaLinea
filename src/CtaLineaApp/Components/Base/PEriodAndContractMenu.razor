@inject IContractService ContractService
@inject IQueryUtilityService queryService
@inject IAccountService AccountService

<CtaLineaGlobalFiltersManager 
    Changed="@((settings) => this.StateHasChanged())"
    />

<QueryLoader @ref=@PeriodQueryLoader
             TItem="OperationPeriodQueryItem"
             Endpoint="@(Constants.Endpoint_ContractsOperationalPeriods)"
             @bind-Data=@PeriodData
             @bind-IsBusy=@PeriodBusy
             DataLoaded="@PeriodLoaded" />
<QueryLoader TItem="ContractQueryItem"
             @ref=@ContractQuery
             Filter=@ContractFilters
             Endpoint="@(Constants.Endpoint_Contracts)"
             @bind-Data=@ContractData
             DataLoaded="@ContactsLoaded" />

<RadzenSplitButton Text=@GetCurrentDescr() ButtonStyle="ButtonStyle.Light" 
        Click="@SetDefaultPeriod_Click"
    >
    <ChildContent>
        <RadzenCard Style="width: 400px">
            <RadzenStack Orientation="Orientation.Vertical">
                <RadzenLabel Text="Periodo" Component="Period" />
                <RadzenDropDown Name="Period"
                                Value=@GlobalFilters.Period
                                ValueChanged=@PeriodChanged
                                TValue="OperationPeriodQueryItem"
                                Data=@PeriodData
                                Style="width: 100%; max-width: 400px;" />

                <RadzenLabel Text="Appalto" Component="ContractId" />
                <RadzenDropDown Name="ContractId"
                                Value=@GlobalFilters.Contract
                                ValueChanged=@ContractChanged
                                TValue="ContractQueryItem"
                                Data=@ContractData
                                Style="width: 100%; max-width: 400px;" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton 
                    ButtonStyle="ButtonStyle.Success"
                    Icon="refresh"
                    Text="Ricarica"
                    IsBusy=@PeriodBusy
                    Click="@Reload_Click" />
            </RadzenStack>
        </RadzenCard>
    </ChildContent>
</RadzenSplitButton>

@code {
    QueryLoader<OperationPeriodQueryItem>? PeriodQueryLoader;
    QueryLoader<ContractQueryItem>? ContractQuery;

    private ContractDropDown? contractSelector;

    [CascadingParameter]
    CtaLineaGlobalFilters GlobalFilters { get; set; } = new CtaLineaGlobalFilters();

    public IList<OperationPeriodQueryItem> PeriodData { get; set; } = new List<OperationPeriodQueryItem>();
    public IList<ContractQueryItem> ContractData { get; set; } = new List<ContractQueryItem>();
    public OperationPeriodQueryItem? SelectedPeriod { get; set; }
    string ContractFilters = string.Empty;
    private bool PeriodBusy { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == true)
        {
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task Reload_Click ()
    {
        if (this.PeriodQueryLoader != null)
        {
            await this.PeriodQueryLoader.LoadDataAsync();
        }
    }

    private string GetCurrentDescr()
    {
        return this.GlobalFilters?.Period?.GetDescription() ?? "Nessun periodo";
    }
    private async Task SetDefaultPeriod_Click(RadzenSplitButtonItem item)
    {
        var period = this.PeriodData.Where(x => x.IsCurrent() == true).Select(x => x).FirstOrDefault();
        await this.SetCurrentPeriodAsync(period);
    }

    private async Task PeriodChanged(OperationPeriodQueryItem? period)
    {
        await this.SetCurrentPeriodAsync(period);
    }
    private async Task ContractChanged(ContractQueryItem? contract)
    {
        await Task.CompletedTask;
        this.GlobalFilters.Contract = contract;
        this.RaiseFilterChanged();
    }

    private async Task SetCurrentPeriodAsync(OperationPeriodQueryItem? period)
    {
        await Task.CompletedTask;

        this.GlobalFilters.Period = period;
        this.ContractFilters = string.Empty;
        if (period != null)
        {
            var startStr = string.Format("$ge(endDate,{0:yyyy-MM-dd})", period.StartDate);
            var endStr = string.Format("$le(startDate,{0:yyyy-MM-dd})", period.EndDate);
            this.ContractFilters = string.Format("$and({0},{1})",
                    startStr, endStr);

            // ricarica i contratti
            if (this.ContractQuery != null)
            {
                await this.ContractQuery.LoadDataAsync(this.ContractFilters);
            }
        }
        else
        {
            await this.SetCurrentContractAsync(false);
        }
        this.RaiseFilterChanged();

    }
    private async Task SetCurrentContractAsync(bool raiseChanged = true)
    {
        await Task.CompletedTask;
        var period = this.GlobalFilters.Period;
        var contract = await this.GetSelectedContractAsync(period, this.GlobalFilters.Contract?.Id);
        if (contract != null)
        {
            // seleziona un contratto di default
            this.GlobalFilters.Contract = contract;
        }
        this.StateHasChanged();
        if (raiseChanged) this.RaiseFilterChanged();
    }

    private async Task<ContractQueryItem?> GetSelectedContractAsync(
        OperationPeriodQueryItem? period,
        int? contractId)
    {
        await Task.CompletedTask;
        ContractQueryItem? contract = null;
        if (contractId != null)
        {
            // prova a selezionare un contratto
            contract = (from c in this.ContractData
                        where c.Id == contractId
                        select c).FirstOrDefault();
        }

        if (contract == null)
        {
            contract = (from c in this.ContractData
                        select c).FirstOrDefault();
        }

        return contract;
    }

    private async Task ContactsLoaded()
    {
        await this.SetCurrentContractAsync();
    }
    private async Task PeriodLoaded()
    {
        var period = this.PeriodData.Where(x => x.IsCurrent() == true).Select(x => x).FirstOrDefault();
        await this.SetCurrentPeriodAsync(period);
    }

    private void RaiseFilterChanged ()
    {
        this.GlobalFilters.RaiseChanged();
    }
}
