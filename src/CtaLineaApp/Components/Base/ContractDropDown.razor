@using CtaLinea.QueryModel;
@using CtaLinea.Model.QueryModel
@inject IQueryUtilityService queryService

<RadzenDropDown 
    Disabled=@Disabled
    Data=@Data 
    @bind-Value="CurrentItem"
    TValue="ContractQueryItem"
    AllowClear=@AllowClear
    Change=@OnChange
    TextProperty="ContractName"
    AllowFiltering=true
    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
    FilterOperator="StringFilterOperator.Contains"
    Class="w-100">
</RadzenDropDown>

@code {
    /*
    [CascadingParameter]
    CtaLineaSettings Settings { get; set; } = new CtaLineaSettings();
    */

    public int? _ContractId;
    [Parameter]
    public int? ContractId 
    {
        get { return this._ContractId;  }
        set
        {
            if (_ContractId != value)
            {
                _ContractId = value;
                this.SelectItem(this._ContractId);
            }
        }
    }
    [Parameter]
    public EventCallback<int?> ContractIdChanged { get; set; }

    [Parameter]
    public bool AllowClear { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public EventCallback<object> Changed { get; set; }

    QueryDefinition _servicesQueryDef = new QueryDefinition();
    ContractQueryItem[]? Data = null;
    int RowCount = 0;
    bool isLoading = false;
    ContractQueryItem? CurrentItem = null;

    public ContractQueryItem? SelectedContractData
    {
        get
        {
            return this.CurrentItem;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        this._servicesQueryDef.EndPoint = Constants.Endpoint_Contracts;

        await LoadData();
        this.StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {

        await Task.CompletedTask;
    }

    private async Task LoadData ()
    {
        await Task.CompletedTask;

        this._servicesQueryDef.Filter = string.Empty;
        this._servicesQueryDef.Sort = string.Empty;
        this._servicesQueryDef.FullText = string.Empty;

        this._servicesQueryDef.Page = 0;
        this._servicesQueryDef.PageSize = 100000;

        var result = await queryService.GetListAsync<ContractQueryItem>(
                    this._servicesQueryDef);

        if (result != null)
        {
            this.Data = result.Items;
            this.RowCount = result.TotalRows;
            this.SelectItem(this.ContractId);
        }
    }

    private void SelectItem (int? contractId)
    {
        if (contractId != null
            && this.Data != null)
        {
            this.CurrentItem = (from d in this.Data
                                where d.Id == contractId
                                select d).SingleOrDefault();
        }
        else
        {
            this.CurrentItem = null;
        }        
    }

    private async Task OnChange (object value)
    {
        this._ContractId = (value as ContractQueryItem)?.Id;
        await ContractIdChanged.InvokeAsync(this.ContractId);
        await Changed.InvokeAsync(this);
    }
}
