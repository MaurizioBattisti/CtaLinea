@inject IAccountService AccountService
@implements IDisposable

<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href=""><span style="color: #ffffff">@Constants.App_Title </span></a>
</div>

<RadzenPanelMenu>
    <RadzenPanelMenuItem Text="Home" Path="/" Icon="home"></RadzenPanelMenuItem>

    @if (this.CanOperate() == true)
    {
        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_RunList)) Text="Elenco Corse" Path="/runs" Icon="departure_board"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ElastibusDays)) Text="Giorni Elastibus" Path="/elastibusdays" Icon="free_cancellation"></RadzenPanelMenuItem>

        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_Utility)) Text="Utility" Icon="bookmark">
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_Planning)) Text="Planning" Path="/planning" Icon="calendar_view_week"></RadzenPanelMenuItem>
            
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_AssociateCosts)) Text="Costi per Ditta" Path="/costbyassociate" Icon="point_of_sale"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_AssociateCosts)) Text="Gestione budgets" Path="/budget-list" Icon="savings"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_Reports)) Text="Km Negativi" Path="/negativekm" Icon="remove_circle"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_SimulationManager)) Text="Gestione simulazioni" Path="/simulations" Icon="cruelty_free"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_RunIncongreunce)) Text="Incongruenze" Path="/runincongruence" Icon="bus_alert"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_Overlappings)) Text="Sovrapposizioni" Path="/overlappings" Icon="join_inner"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageAnags)) Text="Anagrafiche Gestione" Icon="folder">
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageContracts)) Text="Appalti" Path="/contracts" Icon="assignment"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageCalendars)) Text="Calendari" Icon="calendar_month">
                <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_CalendarList)) Text="Lista Calendari" Path="/calendars" Icon="calendar_today"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_NewCalednar)) Text="Nuovo Calendario" Path="/calendar-new" Icon="edit_calendar"></RadzenPanelMenuItem>
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageSuspensionTypes)) Text="Gestione Tupi Sospensione" Path="/cars" Icon="block"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageTags)) Text="Gestione Etichette" Path="/tags" Icon="local_offer"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageForfaits)) Text="Gestione Forfait" Path="/forfaits" Icon="savings"></RadzenPanelMenuItem>

        </RadzenPanelMenuItem>

        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_Tools)) Text="Strumenti" Icon="construction">
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageTasks)) Text="Gestione attività" Path="/scheduledtasks" Icon="watch_later"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageUSers)) Text="Utenti" Path="/users" Icon="people"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ManageCarReplace)) Text="Rimpiazzo mezzo" Path="/cardiscontinuation" Icon="no_crash"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>

        <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_ExternalAnags)) Text="Dati" Icon="inventory">
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_AnagASsociates)) Text="Ditte" Path="/associates" Icon="business"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem  Visible=@(VisibleItems.Contains(Iten_AnagCars)) Text="Mezzi" Path="/cars" Icon="directions_bus"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Iten_AnagDrivers)) Text="Autisti" Path="/drivers" Icon="sports_motorsports"></RadzenPanelMenuItem>

            <RadzenPanelMenuItem Visible=@(VisibleItems.Contains(Item_AnagNodes)) Text="Punti" Path="/points" Icon="place"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>
    }
    <br />
    <RadzenPanelMenuItem Text="Informazioni" Path="/about" Icon="info"></RadzenPanelMenuItem>
</RadzenPanelMenu>

@code {
    #region items
    private const string Item_RunList = "runList";
    private const string Item_ElastibusDays = "elb_days";

    private const string Item_Utility = "utiltiy";
    private const string Item_Planning = "Planning";
    private const string Item_AssociateCosts = "AssCosts";
    private const string Item_SimulationManager = "Sim-Mgr";
    private const string Item_RunIncongreunce = "Incongruence";
    private const string Item_Overlappings = "Overlappings";

    private const string Item_ManageAnags = "ManageAnags";
    private const string Item_ManageContracts = "Contracts";
    private const string Item_ManageCalendars = "ManageCalednars";
    private const string Item_CalendarList = "CalendarList";
    private const string Item_NewCalednar = "CalendarNew";
    private const string Item_ManageSuspensionTypes = "ManageSuspensionTypes";
    private const string Item_ManageTags = "ManageTags";
    private const string Item_ManageForfaits = "ManageForfaits";

    private const string Item_Tools = "Tools";
    private const string Item_ManageTasks = "ToolTasks";
    private const string Item_ManageUSers = "ToolUsers";
    private const string Item_ManageCarReplace = "Tool_CarREplace";

    private const string Item_ExternalAnags = "extAnag";
    private const string Item_AnagASsociates = "extAssociates";
    private const string Iten_AnagCars = "extCars";
    private const string Iten_AnagDrivers = "extDrivers";
    private const string Item_AnagNodes = "extCp";

    private const string Item_Reports = "reports";
    #endregion

    private IList<string> VisibleItems = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        AccountService.UserStatusChanged += this.UserChangedHangler;
    }
    private void UserChangedHangler (object sender,EventArgs e)
    {
        // cacola la lista degli item visibili
        VisibleItems.Clear();

        if (this.IsUserInRole(
                UserRoles.Role_View,
                UserRoles.Role_Edit,
                UserRoles.Role_Manage
            )) 
            VisibleItems.Add(Item_RunList);
        
        if (this.IsUserInRole(
                UserRoles.Role_Manage
            ))
            VisibleItems.Add(Item_ElastibusDays);

        if (this.IsUserInRole(
                UserRoles.Role_Planning,
                UserRoles.Role_Costs
            ))
            VisibleItems.Add(Item_Utility);
        if (this.IsUserInRole(UserRoles.Role_Planning)) VisibleItems.Add(Item_Planning);
        if (this.IsUserInRole(UserRoles.Role_Costs)) VisibleItems.Add(Item_AssociateCosts);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_SimulationManager);        
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_RunIncongreunce);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_Overlappings);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_Reports);

        if (this.IsUserInRole(
                UserRoles.Role_Manage
            ))
            VisibleItems.Add(Item_ManageAnags);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_ManageContracts);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_ManageCalendars);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_CalendarList);
        if (this.IsUserInRole(UserRoles.Role_Manage))VisibleItems.Add(Item_NewCalednar);
        if (this.IsUserInRole(UserRoles.Role_Manage))VisibleItems.Add(Item_ManageSuspensionTypes);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_ManageTags);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_ManageForfaits);

        if (this.IsUserInRole(
                UserRoles.Role_Manage,
                UserRoles.Role_Takss,
                UserRoles.Role_Users
            ))
            VisibleItems.Add(Item_Tools);
        if (this.IsUserInRole(UserRoles.Role_Takss)) VisibleItems.Add(Item_ManageTasks);
        if (this.IsUserInRole(UserRoles.Role_Users)) VisibleItems.Add(Item_ManageUSers);
        if (this.IsUserInRole(UserRoles.Role_Manage)) VisibleItems.Add(Item_ManageCarReplace);

        if (this.IsUserInRole(
            UserRoles.Role_Anagraohics)) 
            VisibleItems.Add(Item_ExternalAnags);
        if (this.IsUserInRole(UserRoles.Role_Anagraohics)) VisibleItems.Add(Item_AnagASsociates);
        if (this.IsUserInRole(UserRoles.Role_Anagraohics)) VisibleItems.Add(Iten_AnagCars);
        if (this.IsUserInRole(UserRoles.Role_Anagraohics)) VisibleItems.Add(Iten_AnagDrivers);
        if (this.IsUserInRole(UserRoles.Role_Anagraohics)) VisibleItems.Add(Item_AnagNodes);

        this.StateHasChanged();
    }

    private bool IsUserInRole (
        params string[] roles)
    {
        var authorized = false;
        if (this.AccountService != null)
        {
            authorized = this.AccountService.IsUserInRoles(roles);
        }
        return authorized;
    }
    private bool CanOperate ()
    {
        bool can = false;
        if (this.AccountService.User  != null)
        {
            can = this.AccountService.User.MustChangePAssword == false;
        }

        return can;
    }

    void IDisposable.Dispose()
    {
        AccountService.UserStatusChanged -= this.UserChangedHangler;
    }
}