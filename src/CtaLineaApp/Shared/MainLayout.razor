@inherits LayoutComponentBase
@using CtaLineaApp.Application.Model;

<CascadingValue Value=@this>
<CascadingValue Value=@this.LineaSettings >
    <RadzenDialog />
    <RadzenLayout>
        <RadzenHeader>
            <ChildContent>
                <div class="row justify-content-start align-items-center">
                    <div class="col-5 d-flex align-items-center">
                        <RadzenSidebarToggle Click="@(args => { sidebarExpanded = !sidebarExpanded; bodyExpanded = !bodyExpanded; })">
                        </RadzenSidebarToggle>
                        <RadzenLabel Text="CTA Lineas" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
                        @if(PageTitle != null){ 
                            <RadzenLabel Text=" / " style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
                            @PageTitle
                        }
                    </div>
                    <div class="col-7 d-flex align-items-center justify-content-end">
                        <div  class="d-none d-md-inline-flex align-items-center">
                            @TopLine
                        </div>
                        <div class="d-none d-md-inline-flex align-items-center">
                            <SettingsAndLogin />
                        </div>

                        <a href="https://www.zzsoft.it" title="GitHub" target="_blank" class="mx-3">
                        </a>
                    </div>
                </div>
            </ChildContent>
        </RadzenHeader>
        <RadzenSidebar @bind-Expanded="@sidebarExpanded" class="demos-sidebar" style="display: flex; flex-direction: column">
            <NavMenu />
        </RadzenSidebar>
        <RadzenBody @bind-Expanded="@bodyExpanded">
            <ChildContent>
                <RadzenContentContainer Name="main">
                    @Body
                </RadzenContentContainer>
            </ChildContent>
        </RadzenBody>
    </RadzenLayout>
</CascadingValue>
</CascadingValue>

@code {
    private RenderFragment? TopLine = null;
    private RenderFragment? PageTitle = null;

    bool sidebarExpanded = true;
    bool bodyExpanded = false;

    CtaLineaSettings LineaSettings = new CtaLineaSettings();

    protected override async Task OnInitializedAsync()
    {
        // assegna la pagesize letta dal file json
        LineaSettings.PageSize = Constants.Default_PageSize;
        await Task.CompletedTask;
    }

    public void SetHeaderAndFooter(
    RenderFragment? topLine, 
        RenderFragment? pageTitle)
    {
        this.TopLine = topLine;
        this.PageTitle = pageTitle;
        StateHasChanged();
    }
}
