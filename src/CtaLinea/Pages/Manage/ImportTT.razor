@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Threading;
@page "/import_tt"
@inject IQueryUtilityService qieryService
@inject IAccessTokenProvider accessToken
@attribute [Authorize]

<h3>Importa dati da TT</h3>

@if (this.PendingImport == null)
{
    <p>Seleziona il file dei servizi TT per mandarlo al server ed elaborarlo per caricare le  variazioni</p>
    <RadzenUpload @ref="upload"
                  ChooseText="Seleziona file TT"
                  Auto="false"
                  Multiple="false"
                  Url="@this.UploadUrl"
                  Style="margin-bottom: 20px;"
                  Change=@this.OnChange
                  Progress=@this.OnProgress>
        <RadzenUploadHeader Name="Authorization" Value="@this.BearerToken" />
    </RadzenUpload>
    <RadzenButton Text="Carica il file"
                  Disabled="@(this.FileToUpload == null)"
                  Click=@this.UploadTtServices
                  Style="margin-bottom: 20px;" />

    @if (this.UploadStarted == true)
    {
        <p>caricamento del file in corso ....</p>
        <RadzenProgressBar Value="@Progress"
                           Style="margin-bottom: 20px" />
    }

    <h3>Importazioni precedenit</h3>
    <RadzenDataGrid @ref="@this.grid" AllowFiltering="true" 
                    AllowColumnResize="true" 
                    FilterMode="FilterMode.Simple" 
                    PageSize="20" 
                    Count="@ImportCount"
                    LoadData="@LoadImports"
                    AllowPaging="true" AllowSorting="true" 
                    Data="@Imports" TItem="ImportQueryItem" 
                    ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or"
                    CellRender="@this.ImportLog_CellRender">
        <Columns>
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportStatus" Title="Stato">
                <Template Context="data">
                    @if (data.ImportStatus == Constants.ImportStatus_Error)
                    {
                        <span style='color:white'>@data.ImportStatus</span>
                    }
                    else
                    {
                        <span style='color: black'>@data.ImportStatus</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportStartDate" Title="inizio import" FormatString="{0:dd/MM/yyyy hh:mm:ss}" />
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="LastUpdateDate" Title="Fine import" FormatString="{0:dd/MM/yyyy hh:mm:ss}" />
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="Note" Title="Note" Width="150px" />
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="User" Title="User" />
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="ProcessedElements" Title="Nr. processati" />
            <RadzenDataGridColumn TItem="ImportQueryItem" Property="ImportedElements" Title="Importati" />
        </Columns>
    </RadzenDataGrid>
}
else
{
    <p>Importazione in corso</p>
    <div class="row">
        <div class="col-6">
            <h3>@PendingImport.Description</h3>
            <p>@PendingImport.ImportStatus</p>
            <p>@PendingImport.LastUpdateDate.ToString()</p>
        </div>
        <div class="col-6">
            <p>@PendingImport.ProcessedElements</p>
            <p>@PendingImport.ImportStatus</p>
        </div>
    </div>
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 20px" />
}

@code {
    // https://blazor.radzen.com/example-upload
    // https://www.radzen.com/documentation/blazor/upload/
    RadzenUpload upload;
    RadzenDataGrid<ImportQueryItem> grid;

    int Progress = 0;
    bool UploadStarted = false;

    string UploadUrl = string.Empty;
    string BearerToken = string.Empty;
    FileInfo FileToUpload = null;

    private Timer _timer;
    QueryDefinition _pendigQueryDef = new QueryDefinition();
    ImportQueryItem PendingImport = null;

    // lista delle importazioni
    QueryDefinition _importQueryDef = new QueryDefinition();
    ImportQueryItem[] Imports = null; // new ImportQueryItem[] { };
    int ImportCount = 0;

    protected override async Task OnInitializedAsync()
    {
        this._timer = new Timer(this.OnTimer, null, 1, 1000);
        this._pendigQueryDef.EndPoint = string.Format(Constants.Endpoint_PendingImport, Constants.ImportDescr_TT);
        this._importQueryDef.EndPoint = Constants.Endpoint_ImportLog;

        this.UploadUrl = this.qieryService.GetCompleteUrl(Constants.Endpoint_TT_Import);

        var token = await this.accessToken.RequestAccessToken();
        token.TryGetToken(out AccessToken accessToken); ;
        this.BearerToken = "Bearer " + accessToken.Value;

        this.PendingImport = await this.GetPendingImport();
        this.StateHasChanged();
    }

    private async Task ResetAll ()
    {
        this.UploadStarted = false;
        this.Progress = 0;
        this.FileToUpload = null;

        // ricarica la lista delle ultime importazioni
        await this.grid.Reload();

        this.StateHasChanged();
    }


    private async Task UploadTtServices(MouseEventArgs args)
    {
        await this.upload.Upload();
        this.UploadStarted = true;
        this.StateHasChanged();
    }

    private void OnChange(UploadChangeEventArgs args)
    {
        this.FileToUpload = null;
        foreach (var file in args.Files)
        {
            this.FileToUpload = file;
        }
        this.StateHasChanged();
    }

    void OnProgress(UploadProgressArgs args)
    {
        this.Progress = args.Progress;

        this.StateHasChanged();
    }

    public void OnTimer(object state)
    {
        // Discard the result
        _ = DoAsyncPing();
    }

    private async Task DoAsyncPing()
    {
        this.PendingImport = await GetPendingImport();
        if (UploadStarted == true
            && this.PendingImport == null)
        {
            await this.ResetAll();
        }
        else
        {
            this.StateHasChanged();
        }
    }

    // resituisce l'import pendente se ne esiste uno
    private async Task<ImportQueryItem> GetPendingImport()
    {
        return await qieryService.GetOneAsync<ImportQueryItem>(
                this._pendigQueryDef);
    }

    private async Task LoadImports (LoadDataArgs args)
    {
        this._importQueryDef.Filter = string.Format("Description$eq;'{0}'", Constants.ImportDescr_TT);
        this._importQueryDef.Sort = "LastUpdateDate-";

        this._importQueryDef.Page = args.Skip.Value / args.Top.Value;
        this._importQueryDef.PageSize = args.Top.Value;

        var result = await qieryService.GetListAsync<ImportQueryItem>(
                    this._importQueryDef);

        this.Imports = result.Items;
        this.ImportCount = result.TotalRows;
    }

    private void ImportLog_CellRender(DataGridCellRenderEventArgs<ImportQueryItem> args)
    {
        if (args.Column.Property == "ImportStatus")
        {
            args.Attributes.Add("style", $"background-color: { this.GetStyleBackColorByStatus(args.Data.ImportStatus)};");
        }
    }

    private string GetStyleBackColorByStatus (string status)
    {
        var color = "white";
        switch(status)
        {
            case Constants.ImportStatus_Error:
                color = "orangered";
                break;
            case Constants.ImportStatus_Completed:
                color = "lightgreen";
                break;
        }
        return color;
    }
}
